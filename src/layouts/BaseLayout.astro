---
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import { getLocale, useTranslations, type Locale } from "../i18n";

import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  lang?: Locale;
  blogTranslationKey?: string;
}

const {
  title,
  description,
  noindex = false,
  lang: propLang,
  blogTranslationKey,
} = Astro.props;

const lang: Locale = getLocale(
  propLang ?? Astro.params.lang ?? Astro.currentLocale,
);

const t = useTranslations(lang);

const site = "https://maxwebstudio.com";

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";

const subpath = pathname
  .replace(/^\/(es|en|ru|fr)/, "")
  .replace(/^\/+|\/+$/g, "");

// Opción 1: concatenación en vez de template anidado
const localePath = (locale: Locale) =>
  `${site}/${locale}${subpath ? "/" + subpath : ""}/`;

const canonical = localePath(lang);

const pageTitle = title ?? t.meta.defaultTitle;
const pageDescription = description ?? t.meta.defaultDescription;

const htmlLang =
  lang === "es"
    ? "es-ES"
    : lang === "en"
      ? "en-US"
      : lang === "ru"
        ? "ru-RU"
        : "fr-FR";
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="canonical" href={canonical} />

  {(["es", "en", "ru", "fr"] as const).map((locale) => (
      <link rel="alternate" hreflang={locale} href={localePath(locale)} />
    ))} 

    <link rel="alternate" hreflang="x-default" href={localePath("es")} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />

    <link rel="icon" type="image/svg+xml" href="/images/logo-maxstudio.svg" />
  </head>

  <body>
    <a class="skip-link" href="#main">
      {t.a11y.skipToContent}
    </a>

  <Navbar
  lang={lang}
  blogTranslationKey={blogTranslationKey}
/>

    <main id="main">
      <slot />
    </main>

    <Footer lang={lang} />

    <script>
      import "../scripts/animations";
    </script>
  </body>
</html>
