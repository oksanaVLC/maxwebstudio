---
import { getCollection } from 'astro:content';
import { LOCALES, getLocale } from '../../../i18n';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({
    params: { lang },
  }));
}

const lang = getLocale(Astro.params.lang);

const posts = (
  await getCollection('blog', ({ id, data }) =>
    id.startsWith(`${lang}/`) && !data.draft
  )
).sort(
  (a, b) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title={`Blog | Max Web Studio`}
  description="Artículos sobre diseño web, desarrollo, SEO y tecnología."
>
  <section class="section">
    <div class="container">
      <p>Blog</p>

      <h1>Ideas, diseño y tecnología.</h1>

      <div>
        {posts.map((post) => (
          <article>
            <a href={`/${lang}/blog/${post.id.split('/').pop()?.replace(/\.md$/, '')}`}>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>