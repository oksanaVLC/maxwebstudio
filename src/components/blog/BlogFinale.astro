---
interface Props {
  eyebrow: string;
  lines: string[];
  closing: string;
  accentIndex?: number;
}

const {
  eyebrow,
  lines,
  closing,
  accentIndex = lines.length - 1,
} = Astro.props;
---

<section class="blog-finale" data-reveal="up">
  <p class="blog-finale__eyebrow">{eyebrow}</p>

  <div class="blog-finale__statement">
    {
      lines.map((line, index) => (
        <p class:list={{ "blog-finale__accent": index === accentIndex }}>
          {line}
        </p>
      ))
    }
  </div>

  <p class="blog-finale__closing">{closing}</p>
</section>

<style>
  .blog-finale {
    padding-block: clamp(90px, 14vw, 180px);
    border-top: 1px solid var(--line);
    text-align: center;
  }

  .blog-finale__eyebrow {
    margin: 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    line-height: 1.4;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .blog-finale__statement {
    max-width: 900px;
    margin: 36px auto 0;
    color: var(--ink);
    font-size: clamp(34px, 5vw, 70px);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .blog-finale__statement p {
    margin: 0;
  }

  .blog-finale__statement p + p {
    margin-top: 8px;
  }

  .blog-finale__accent {
    color: var(--red);
  }

  .blog-finale__closing {
    max-width: 600px;
    margin: 42px auto 0;
    color: var(--ink-soft);
    font-size: var(--fs-lead);
    line-height: 1.7;
  }

  @media (max-width: 767px) {
    .blog-finale {
      text-align: left;
    }

    .blog-finale__statement {
      margin-top: 28px;
    }

    .blog-finale__closing {
      margin-top: 32px;
    }
  }
</style>