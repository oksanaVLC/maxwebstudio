---
import wsIcon from "../../assets/images/ws3.png";

interface Props {
  message?: string;
  class?: string;
}

const {
  message = "Hola, me gustaría recibir más información sobre vuestros servicios.",
  class: className = "",
} = Astro.props;

const phone = "34697211032";

const whatsappUrl =
  `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
---

<a
  class:list={["whatsapp-button", className]}
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Contactar por WhatsApp"
  title="Contactar por WhatsApp"
>
  <span class="whatsapp-button__icon">
    <img
      src={wsIcon.src}
      alt=""
      aria-hidden="true"
    />
  </span>
</a>

<style>
  .whatsapp-button {
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 1000;

    display: block;
    width: 72px;
    height: 72px;

    margin: 0;
    padding: 0;

    background: transparent;
    border: 0;
    border-radius: 50%;

    text-decoration: none;

    transition:
      transform 250ms var(--ease),
      filter 250ms var(--ease);
  }

  .whatsapp-button__icon {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;

    background: transparent;
    border-radius: 50%;
  }

  .whatsapp-button__icon img {
    position: absolute;

    /*
     * Ampliamos el PNG para compensar el espacio
     * que existe alrededor del icono original.
     */
    inset: -18%;

    width: 136%;
    height: 136%;

    display: block;
    max-width: none;

    object-fit: contain;
  }

  .whatsapp-button:hover {
    transform: translateY(-4px) scale(1.06);

    filter:
      drop-shadow(0 8px 14px rgb(16 17 20 / 18%));
  }

  .whatsapp-button:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 5px;
  }

  @media (max-width: 767px) {
    .whatsapp-button {
      right: 20px;
      bottom: 20px;
      width: 64px;
      height: 64px;
    }

    .whatsapp-button__icon img {
      inset: -20%;
      width: 140%;
      height: 140%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-button {
      transition: none;
    }

    .whatsapp-button:hover {
      transform: none;
    }
  }
</style>