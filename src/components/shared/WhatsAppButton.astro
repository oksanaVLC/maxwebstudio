---
import wpIcon from "../../assets/icons/wp_icon.svg";

interface Props {
  message?: string;
  class?: string;
}

const {
  message = "Hola, me gustaría recibir más información sobre vuestros servicios.",
  class: className = "",
} = Astro.props;

const phone = "34697211032";

const whatsappUrl =
  `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
---

<a
  class:list={["whatsapp-button", className]}
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Contactar por WhatsApp"
  title="Contactar por WhatsApp"
  data-whatsapp-button
  aria-hidden="true"
  tabindex="-1"
>
  <span class="whatsapp-button__icon">
    <img
      src={wpIcon.src}
      alt=""
      aria-hidden="true"
    />
  </span>
</a>

<script>
  const buttons =
    document.querySelectorAll<HTMLElement>("[data-whatsapp-button]");

  buttons.forEach((button) => {
    let hasShown = false;

    const showButton = () => {
      if (hasShown) return;

      hasShown = true;

      button.classList.add("is-visible");
      button.removeAttribute("aria-hidden");
      button.removeAttribute("tabindex");

      window.removeEventListener("scroll", checkPosition);
    };

    const checkPosition = () => {
      if (window.scrollY >= 40) {
        showButton();
      }
    };

    window.addEventListener("scroll", checkPosition, {
      passive: true,
    });
  });
</script>

<style>
  .whatsapp-button {
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 1000;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 78px;
    height: 78px;

    margin: 0;
    padding: 0;

    background: transparent;
    border: 0;
    border-radius: 50%;

    text-decoration: none;

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transform: translateY(18px) scale(0.72);

    transition:
      opacity 280ms ease,
      transform 600ms var(--motion-ease-spring),
      visibility 0s linear 600ms,
      filter 250ms var(--ease);
  }

  .whatsapp-button.is-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;

    transform: translateY(0) scale(1);

    transition:
      opacity 280ms ease,
      transform 600ms var(--motion-ease-spring),
      visibility 0s linear 0s,
      filter 250ms var(--ease);
  }

  .whatsapp-button__icon {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 100%;
    height: 100%;
  }

  .whatsapp-button__icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .whatsapp-button:hover {
    transform: translateY(-4px) scale(1.06);

    filter: drop-shadow(
      0 8px 14px rgb(16 17 20 / 18%)
    );
  }

  .whatsapp-button.is-visible:active {
    transform: translateY(0) scale(0.96);
  }

  .whatsapp-button:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 5px;
  }

  @media (max-width: 767px) {
    .whatsapp-button {
      right: 23px;
      bottom: 23px;

      width: 60px;
      height: 60px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-button {
      transition: opacity 180ms ease;
      transform: none;
    }

    .whatsapp-button.is-visible {
      transition: opacity 180ms ease;
      transform: none;
    }

    .whatsapp-button:hover,
    .whatsapp-button.is-visible:active {
      transform: none;
    }
  }
</style>