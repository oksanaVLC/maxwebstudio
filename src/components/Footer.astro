---
import { getRelativeLocaleUrl } from "astro:i18n";
import { stripLocale, useTranslations, type Locale } from "../i18n";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const home = getRelativeLocaleUrl(lang, "");

/*
 * Current route without the locale segment.
 *
 * Examples:
 * /es/                -> ""
 * /en/blog/           -> "blog/"
 * /fr/blog/my-post/   -> "blog/my-post/"
 * /ru/privacy/        -> "privacy/"
 */
const currentPath = stripLocale(Astro.url.pathname);

const links = [
  {
    href: `${home}#services`,
    label: t.nav.services,
  },
  {
    href: `${home}#process`,
    label: t.nav.process,
  },
  {
    href: `${home}#work`,
    label: t.nav.work,
  },
  {
    href: `${home}#pricing`,
    label: t.nav.pricing,
  },
  {
    href: `${home}#faq`,
    label: t.nav.faq,
  },
  {
    href: getRelativeLocaleUrl(lang, "blog"),
    label: t.nav.blog,
  },
];

const legalLinks = [
  {
    href: getRelativeLocaleUrl(lang, "policies/legal"),
    label: t.footer.legal,
  },
  {
    href: getRelativeLocaleUrl(lang, "policies/privacy"),
    label: t.footer.privacy,
  },
  {
    href: getRelativeLocaleUrl(lang, "policies/cookies"),
    label: t.footer.cookies,
  },
];

const languages = [
  { code: "es", label: "ES" },
  { code: "en", label: "EN" },
  { code: "ru", label: "RU" },
  { code: "fr", label: "FR" },
] as const;

function getLanguageHref(code: Locale) {
  return getRelativeLocaleUrl(code, currentPath);
}
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <a
          href={home}
          class="footer__logo"
          aria-label={t.meta.siteName}
        >
          <img
            src="/images/lightBold.svg"
            alt={t.meta.siteName}
            width="220"
            height="auto"
          />
        </a>

        <p>{t.meta.defaultDescription}</p>
      </div>

      <div class="footer__nav">
        <div class="footer__column">
          <p class="footer__title">
            {t.footer.explore}
          </p>

          <nav aria-label={t.footer.explore}>
            {links.map((link) => (
              <a href={link.href}>
                {link.label}
              </a>
            ))}
          </nav>
        </div>

        <div class="footer__column">
          <p class="footer__title">
            {t.footer.legalTitle}
          </p>

          <nav aria-label={t.footer.legalTitle}>
            {legalLinks.map((link) => (
              <a href={link.href}>
                {link.label}
              </a>
            ))}
          </nav>
        </div>
      </div>
    </div>

    <div class="footer__bottom">
      <p>
        © {new Date().getFullYear()} {t.meta.siteName}.
        {t.footer.rights}
      </p>

      <nav
        class="footer__languages"
        aria-label={t.a11y.switchLanguage}
      >
        {
          languages.map((language) => {
            const active = language.code === lang;

            return (
              <a
                href={getLanguageHref(language.code)}
                data-active={String(active)}
                aria-current={active ? "page" : undefined}
              >
                {language.label}
              </a>
            );
          })
        }
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--surface-dark);
    color: #fff;
  }

  .footer__top {
    display: grid;
    grid-template-columns:
      minmax(0, 1.2fr)
      minmax(320px, 0.8fr);
    gap: clamp(60px, 7vw, 100px);
    padding-block: 88px 76px;
  }

  /* --------------------------------
     Brand
  -------------------------------- */

  .footer__brand {
    max-width: 500px;
  }

  .footer__logo {
    display: inline-block;
    width: 180px;
  }

  .footer__logo img {
    display: block;
    width: 100%;
    height: auto;
  }

  .footer__brand p {
    max-width: 420px;
    margin-top: 28px;
    color: rgb(255 255 255 / 60%);
    font-size: var(--fs-lead);
    line-height: 1.65;
  }

  /* --------------------------------
     Navigation
  -------------------------------- */

  .footer__nav {
    display: grid;
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
    gap: 52px;
  }

  .footer__title {
    margin: 0 0 20px;
    color: rgb(255 255 255 / 46%);
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .footer__column nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 11px;
  }

  .footer__column a {
    position: relative;
    display: inline-block;
    color: rgb(255 255 255 / 84%);
    font-size: var(--fs-body);
    font-weight: 400;
    line-height: 1.5;
    transition:
      color 250ms var(--ease),
      transform 250ms var(--ease);
  }

  .footer__column a:hover {
    color: #fff;
    transform: translateX(5px);
  }

  /* --------------------------------
     Bottom
  -------------------------------- */

  .footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    padding-block: 24px 30px;
    border-top: 1px solid rgb(255 255 255 / 14%);
  }

  .footer__bottom p {
    margin: 0;
    color: rgb(255 255 255 / 48%);
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  .footer__languages {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .footer__languages a {
    color: rgb(255 255 255 / 46%);
    font-size: var(--fs-small);
    font-weight: 600;
    letter-spacing: 0.05em;
    line-height: 1;
    transition: color 200ms var(--ease);
  }

  .footer__languages a:hover,
  .footer__languages a[data-active="true"] {
    color: #fff;
  }

  /* --------------------------------
     Mobile
  -------------------------------- */

  @media (max-width: 767px) {
    .footer__top {
      grid-template-columns: 1fr;
      gap: 58px;
      padding-block: 72px 56px;
    }

    .footer__logo {
      width: 165px;
    }

    .footer__brand p {
      margin-top: 22px;
      font-size: var(--fs-body);
    }

    .footer__nav {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
      gap: 32px;
    }

    .footer__title {
      font-size: var(--fs-small);
    }

    .footer__column a {
      font-size: var(--fs-body);
    }

    .footer__bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 20px;
    }

    .footer__bottom p {
      font-size: var(--fs-small);
    }

    .footer__languages {
      gap: 18px;
    }

    .footer__languages a {
      font-size: var(--fs-small);
    }
  }
</style>