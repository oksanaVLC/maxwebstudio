---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLocale, stripLocale, useTranslations, type Locale } from "../i18n";
import logoNegro from "../assets/images/logo-negro.png";
import logoBlanco from "../assets/images/logo-blanco.png";
import { Image } from "astro:assets";

interface Props {
  lang?: Locale;
  blogTranslationKey?: string;
}

const { lang: propLang, blogTranslationKey } = Astro.props;

const lang = getLocale(propLang ?? Astro.params.lang ?? Astro.currentLocale);
const t = useTranslations(lang);
const home = getRelativeLocaleUrl(lang, "");

const navLinks = [
  { href: `${home}#services`, label: t.nav.services },
  { href: `${home}#process`, label: t.nav.process },
  { href: `${home}#projects`, label: t.nav.work },
  { href: `${home}#faq`, label: t.nav.faq },
  { href: `${home}blog/`, label: t.nav.blog },
];

const languages = [
  { code: "es", label: "Español" },
  { code: "en", label: "English" },
  { code: "ru", label: "Русский" },
  { code: "fr", label: "Français" },
] as const;

const currentLanguage =
  languages.find((language) => language.code === lang) ?? languages[0];

const currentPath = stripLocale(Astro.url.pathname);
const languageHrefs = new Map<string, string>();

const posts = blogTranslationKey ? await getCollection("blog") : [];

for (const language of languages) {
  if (blogTranslationKey) {
    const translatedPost = posts.find(
      (post) =>
        post.data.translationKey === blogTranslationKey &&
        post.id.startsWith(`${language.code}/`) &&
        !post.data.draft,
    );

    if (translatedPost) {
      const [, ...slugParts] = translatedPost.id.split("/");
      const slug = slugParts.join("/").replace(/\.mdx?$/, "");

      languageHrefs.set(language.code, `/${language.code}/blog/${slug}/`);
      continue;
    }
  }

  languageHrefs.set(
    language.code,
    getRelativeLocaleUrl(language.code as Locale, currentPath),
  );
}
---

<header class="site-header">
  <div class="container site-header__inner">
    <!-- LOGOS -->
    <a href={home} class="site-header__logo" aria-label={t.meta.siteName}>
      <Image
        src={logoNegro}
        alt={t.meta.siteName}
        width={254}
        height={58}
        class="site-header__logo-image logo-dark"
      />
      <Image
        src={logoBlanco}
        alt=""
        aria-hidden="true"
        width={254}
        height={58}
        class="site-header__logo-image logo-light"
      />
    </a>

    <!-- DESKTOP NAVIGATION -->
    <nav class="site-header__nav" aria-label={t.a11y.mainNavigation}>
      {navLinks.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>

    <!-- DESKTOP ACTIONS -->
    <div class="site-header__actions">
      <div class="language-selector">
        <button
          class="language-selector__trigger"
          type="button"
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="language-menu"
          aria-label={t.a11y.switchLanguage}
        >
          <svg
            class="language-selector__globe"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="9" />
            <path d="M3 12h18" />
            <path d="M12 3c2.2 2.5 3.3 5.5 3.3 9s-1.1 6.5-3.3 9" />
            <path d="M12 3c-2.2 2.5-3.3 5.5-3.3 9s1.1 6.5 3.3 9" />
          </svg>

          <span class="language-selector__current">
            {currentLanguage.code.toUpperCase()}
          </span>

          <svg
            class="language-selector__chevron"
            viewBox="0 0 12 7"
            aria-hidden="true"
          >
            <path d="M1 1l5 5 5-5" />
          </svg>
        </button>

        <div
          class="language-selector__menu"
          id="language-menu"
          role="menu"
          aria-label={t.a11y.switchLanguage}
        >
          <div class="language-selector__menu-header">
            <span>{t.a11y.switchLanguage}</span>
          </div>

          {languages.map((language) => (
            <a
              href={
                languageHrefs.get(language.code) ??
                getRelativeLocaleUrl(language.code, "")
              }
              class:list={{
                "language-selector__option": true,
                "is-active": language.code === lang,
              }}
              role="menuitem"
              aria-current={language.code === lang ? "page" : undefined}
            >
              <span class="language-selector__code">
                {language.code.toUpperCase()}
              </span>
              <span class="language-selector__name">{language.label}</span>

              {language.code === lang && (
                <svg
                  class="language-selector__check"
                  viewBox="0 0 20 20"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M4 10.5l4 4 8-9"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              )}
            </a>
          ))}
        </div>
      </div>

      <a href={`${home}#contact`} class="site-header__cta">
        {t.cta.start}
      </a>
    </div>

    <!-- MOBILE MENU BUTTON -->
    <button
      class="site-header__menu"
      type="button"
      aria-label={t.a11y.openMenu}
      aria-expanded="false"
      aria-controls="mobile-navigation"
    >
      <span></span>
      <span></span>
    </button>
  </div>

  <!-- MOBILE FULLSCREEN NAVIGATION -->
  <div
    class="site-header__mobile"
    id="mobile-navigation"
    aria-hidden="true"
    inert
  >
    <div class="site-header__mobile-content">
      <nav class="site-header__mobile-nav" aria-label={t.a11y.mainNavigation}>
        {navLinks.map((link, index) => (
          <a href={link.href} style={`--nav-index: ${index}`}>
            <span>{link.label}</span>
            <span class="site-header__mobile-arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        ))}
      </nav>

      <div class="site-header__mobile-language">
        <p class="site-header__mobile-language-title">
          {t.a11y.switchLanguage}
        </p>

        <div class="site-header__mobile-language-list">
          {languages.map((language) => (
            <a
              href={
                languageHrefs.get(language.code) ??
                getRelativeLocaleUrl(language.code, "")
              }
              class:list={{
                "site-header__mobile-language-option": true,
                "is-active": language.code === lang,
              }}
              aria-current={language.code === lang ? "page" : undefined}
            >
              <span class="site-header__mobile-language-code">
                {language.code.toUpperCase()}
              </span>
              <span class="site-header__mobile-language-name">
                {language.label}
              </span>
              {language.code === lang && (
                <span class="site-header__mobile-language-check">✓</span>
              )}
            </a>
          ))}
        </div>
      </div>

      <a href={`${home}#contact`} class="site-header__mobile-cta">
        {t.cta.start}
        <span aria-hidden="true">↗</span>
      </a>

      <div class="site-header__mobile-footer">
        <span>{t.meta.siteName}</span>
        <span>{currentLanguage.code.toUpperCase()}</span>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".site-header");
  const menu = document.querySelector<HTMLButtonElement>(".site-header__menu");
  const mobileNav = document.querySelector<HTMLElement>(".site-header__mobile");

  const languageSelector =
    document.querySelector<HTMLElement>(".language-selector");

  const languageTrigger = document.querySelector<HTMLButtonElement>(
    ".language-selector__trigger",
  );

  const desktopBreakpoint = window.matchMedia("(max-width: 920px)");

  // HEADER SCROLL
  if (header) {
    const updateScrollState = () => {
      header.classList.toggle("is-scrolled", window.scrollY > 8);
    };

    updateScrollState();

    window.addEventListener("scroll", updateScrollState, { passive: true });

    // Hover solo en escritorio
    header.addEventListener("mouseenter", () => {
      if (!desktopBreakpoint.matches) {
        header.classList.add("is-hovered");
      }
    });

    header.addEventListener("mouseleave", () => {
      header.classList.remove("is-hovered");
    });
  }

  // LANGUAGE SELECTOR
  const closeLanguageMenu = () => {
    if (!languageSelector || !languageTrigger) return;

    languageSelector.classList.remove("is-open");
    languageTrigger.setAttribute("aria-expanded", "false");
  };

  if (languageSelector && languageTrigger) {
    languageTrigger.addEventListener("click", (event) => {
      event.stopPropagation();

      const isOpen = languageSelector.classList.contains("is-open");

      languageSelector.classList.toggle("is-open", !isOpen);
      languageTrigger.setAttribute("aria-expanded", String(!isOpen));
    });

    document.addEventListener("click", (event) => {
      if (!languageSelector.contains(event.target as Node)) {
        closeLanguageMenu();
      }
    });

    languageSelector
      .querySelectorAll<HTMLAnchorElement>(".language-selector__option")
      .forEach((link) => link.addEventListener("click", closeLanguageMenu));
  }

  // MOBILE MENU
  const openMobileMenu = () => {
    if (!header || !menu || !mobileNav) return;

    const headerHeight =
      header.querySelector(".site-header__inner")?.getBoundingClientRect()
        .height ?? 68;

    header.style.setProperty("--mobile-header-height", `${headerHeight}px`);

    menu.setAttribute("aria-expanded", "true");

    mobileNav.classList.add("is-open");
    mobileNav.removeAttribute("inert");
    mobileNav.setAttribute("aria-hidden", "false");

    header.classList.add("is-menu-open");
    document.body.classList.add("menu-open");

    closeLanguageMenu();
  };

  const closeMobileMenu = (restoreFocus = false) => {
    if (!header || !menu || !mobileNav) return;

    menu.setAttribute("aria-expanded", "false");

    mobileNav.classList.remove("is-open");
    mobileNav.setAttribute("inert", "");
    mobileNav.setAttribute("aria-hidden", "true");

    header.classList.remove("is-menu-open");
    document.body.classList.remove("menu-open");

    if (restoreFocus) menu.focus();
  };

  if (menu && mobileNav && header) {
    menu.addEventListener("click", () => {
      const isOpen = menu.getAttribute("aria-expanded") === "true";

      if (isOpen) {
        closeMobileMenu();
      } else {
        openMobileMenu();
      }
    });

    mobileNav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => closeMobileMenu());
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        const isOpen = menu.getAttribute("aria-expanded") === "true";

        if (isOpen) closeMobileMenu(true);
        closeLanguageMenu();
      }
    });

    desktopBreakpoint.addEventListener("change", (event) => {
      if (!event.matches) closeMobileMenu();
    });
  }
</script>

<style>
  /* DESIGN TOKENS */
  .site-header {
    --header-bg: var(--surface-dark, #101114);
    --header-border: rgb(255 255 255 / 9%);
    --header-shadow: 0 8px 30px rgb(0 0 0 / 18%);
  }

  /* HEADER */
  .site-header {
    --header-bg: rgb(16 17 20 / 78%);
    --header-border: rgb(255 255 255 / 10%);
    --header-shadow: 0 8px 30px rgb(0 0 0 / 8%);

    position: fixed;
    top: 0;
    left: 0;
    z-index: 100;
    width: 100%;

    background: transparent;
    border-bottom: 1px solid transparent;

    transition:
      background 300ms var(--ease),
      border-color 300ms var(--ease),
      box-shadow 300ms var(--ease),
      backdrop-filter 300ms var(--ease);
  }

  .site-header.is-scrolled,
  .site-header.is-hovered {
    background: var(--header-bg);
    border-bottom-color: var(--header-border);
    box-shadow: var(--header-shadow);

    backdrop-filter: blur(24px) saturate(140%);
    -webkit-backdrop-filter: blur(24px) saturate(140%);
  }

  .site-header.is-menu-open {
    background: #fdfaf3;
    border-bottom-color: transparent;
    box-shadow: none;

    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  /* HEADER INNER */
  .site-header__inner {
    position: relative;
    z-index: 2;

    display: flex;
    align-items: center;
    min-height: var(--header-h);

    gap: clamp(12px, 1.8vw, 28px);
  }

  /* LOGO */
  .site-header__logo {
    position: relative;

    display: flex;
    align-items: center;
    flex: 0 1 clamp(145px, 15vw, 190px);

    color: var(--ink);
    line-height: 1;
    text-decoration: none;
  }

  .site-header__logo-image {
    display: block;
    width: clamp(145px, 15vw, 190px);
    height: auto;
    max-width: 100%;
    object-fit: contain;

    transition: opacity 250ms var(--ease);
  }

  .site-header__logo-image.logo-light {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
  }

  .site-header.is-scrolled .logo-dark,
  .site-header.is-hovered .logo-dark {
    opacity: 0;
  }

  .site-header.is-scrolled .logo-light,
  .site-header.is-hovered .logo-light {
    opacity: 1;
  }

  .site-header.is-menu-open .logo-dark {
    opacity: 1;
  }

  .site-header.is-menu-open .logo-light {
    opacity: 0;
  }

  /* DESKTOP NAVIGATION */
  .site-header__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1 1 auto;
    min-width: 0;
    gap: clamp(8px, 1.25vw, 22px);
  }

  .site-header__nav a {
    position: relative;
    color: var(--ink);
    font-size: clamp(14px, 1.05vw, 17px);
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
    transition: color 250ms var(--ease);
  }

  .site-header__nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 280ms var(--ease);
  }

  .site-header__nav a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  /* WHITE TEXT ON DARK HEADER */
  .site-header.is-scrolled .site-header__nav a,
  .site-header.is-hovered .site-header__nav a,
  .site-header.is-scrolled .language-selector__trigger,
  .site-header.is-hovered .language-selector__trigger,
  .site-header.is-scrolled .site-header__menu,
  .site-header.is-hovered .site-header__menu {
    color: #fff;
  }

  .site-header.is-menu-open .site-header__menu {
    color: var(--ink);
  }

  /* DESKTOP ACTIONS */
  .site-header__actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex: 0 1 auto;
    min-width: 0;
    gap: clamp(9px, 1.2vw, 18px);
  }

  /* LANGUAGE SELECTOR */
  .language-selector {
    position: relative;
    flex: 0 0 auto;
  }

  .language-selector__trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    gap: 7px;
    transition: color 250ms var(--ease);
  }

  .language-selector__globe {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .language-selector__current {
    font-size: clamp(14px, 1.05vw, 17px);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .language-selector__chevron {
    width: 8px;
    height: 5px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 220ms var(--ease);
  }

  .site-header.is-scrolled .language-selector__globe,
  .site-header.is-hovered .language-selector__globe,
  .site-header.is-scrolled .language-selector__chevron,
  .site-header.is-hovered .language-selector__chevron {
    stroke: #fff;
  }

  .site-header.is-menu-open .language-selector__globe,
  .site-header.is-menu-open .language-selector__chevron {
    stroke: var(--ink);
  }

  .language-selector.is-open .language-selector__chevron {
    transform: rotate(180deg);
  }

  /* PREMIUM LANGUAGE DROPDOWN */
  .language-selector__menu {
    position: absolute;
    top: calc(100% + 14px);
    right: -8px;
    width: 224px;
    padding: 10px;

    background: #fdfaf3;
    border: 1px solid rgb(16 17 20 / 7%);
    border-radius: 16px;

    box-shadow:
      0 20px 60px rgb(16 17 20 / 10%),
      0 4px 12px rgb(16 17 20 / 4%);

    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(8px) scale(0.98);
    transform-origin: top right;

    transition:
      opacity 220ms var(--ease),
      transform 220ms var(--ease),
      visibility 220ms var(--ease);

    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .language-selector.is-open .language-selector__menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0) scale(1);
  }

  .language-selector__menu-header {
    padding: 8px 12px 12px;
    color: var(--muted);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .language-selector__option {
    display: grid;
    grid-template-columns: 40px 1fr auto;
    align-items: center;
    min-height: 48px;
    padding: 0 12px;
    border-radius: 10px;
    color: var(--ink);
    gap: 10px;
    transition:
      background 180ms var(--ease),
      transform 180ms var(--ease);
  }

  .language-selector__option:hover,
  .language-selector__option.is-active {
    background: #fff;
  }

  .language-selector__code {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 26px;
    border-radius: 7px;
    background: #f1ede4;
    color: var(--ink);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .language-selector__name {
    color: var(--ink);
    font-size: 13px;
    font-weight: 500;
  }

  .language-selector__check {
    width: 17px;
    height: 17px;
    color: var(--red);
  }

  /* DESKTOP CTA */
  .site-header__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding-inline: clamp(14px, 1.5vw, 21px);
    border-radius: 999px;
    background: var(--red);
    color: #fff;
    font-size: clamp(12px, 0.85vw, 13px);
    font-weight: 600;
    white-space: nowrap;
    flex: 0 0 auto;
    transition: background 220ms var(--ease);
  }

  .site-header__cta:hover,
  .site-header__mobile-cta:hover {
    background: var(--red-hover);
  }

  /* MOBILE BUTTON */
  .site-header__menu {
    display: none;
    position: relative;
    z-index: 3;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    flex: 0 0 auto;
    transition: color 250ms var(--ease);
  }

  .site-header__menu span {
    display: block;
    width: 28px;
    height: 2px;
    margin: 7px auto;
    border-radius: 999px;
    background: currentColor;
    transition:
      transform 250ms var(--ease),
      opacity 250ms var(--ease);
  }

  .site-header__menu[aria-expanded="true"] span:first-child {
    transform: translateY(4.5px) rotate(45deg);
  }

  .site-header__menu[aria-expanded="true"] span:last-child {
    transform: translateY(-4.5px) rotate(-45deg);
  }

  /* MOBILE FULLSCREEN PANEL */
  .site-header__mobile {
    position: fixed;
    inset: 0;
    z-index: 1;

    width: 100%;
    height: 100vh;
    height: 100dvh;

    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;

    padding: calc(var(--mobile-header-height, 68px) + 30px) var(--pad-x) 36px;

    background: #fdfaf3;

    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-8px);

    transition:
      opacity 250ms var(--ease),
      transform 250ms var(--ease),
      visibility 250ms var(--ease);
  }

  .site-header__mobile.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .site-header__mobile-content {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    width: 100%;
    max-width: 680px;
    margin-inline: auto;
  }

  /* MOBILE NAV LINKS */
  .site-header__mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .site-header__mobile-nav a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 66px;
    border-bottom: 1px solid rgb(16 17 20 / 9%);
    color: var(--ink);
    font-size: clamp(24px, 6vw, 32px);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.035em;
    transition:
      color 180ms var(--ease),
      padding 180ms var(--ease);
  }

  .site-header__mobile-nav a:first-child {
    border-top: 1px solid rgb(16 17 20 / 9%);
  }

  .site-header__mobile-nav a:hover {
    color: var(--red);
    padding-left: 5px;
  }

  .site-header__mobile-arrow {
    color: var(--muted);
    font-size: 18px;
    font-weight: 400;
    transition:
      color 180ms var(--ease),
      transform 180ms var(--ease);
  }

  .site-header__mobile-nav a:hover .site-header__mobile-arrow {
    color: var(--red);
    transform: translate(3px, -3px);
  }

  /* MOBILE LANGUAGES */
  .site-header__mobile-language {
    margin-top: 32px;
  }

  .site-header__mobile-language-title {
    margin: 0 0 14px;
    color: var(--muted);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .site-header__mobile-language-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 9px;
  }

  .site-header__mobile-language-option {
    display: grid;
    grid-template-columns: 38px 1fr auto;
    align-items: center;
    min-height: 50px;
    padding: 0 12px;
    border: 1px solid rgb(16 17 20 / 6%);
    border-radius: 12px;
    background: rgb(255 255 255 / 55%);
    color: var(--ink);
    gap: 8px;
