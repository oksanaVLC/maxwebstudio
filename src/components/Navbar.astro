---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import {
  getLocale,
  stripLocale,
  useTranslations,
  type Locale,
} from "../i18n";
import logoNegro from "../assets/images/logo-negro.png";

interface Props {
  lang?: Locale;
  blogTranslationKey?: string;
}

const {
  lang: propLang,
  blogTranslationKey,
} = Astro.props;

const lang = getLocale(
  propLang ?? Astro.params.lang ?? Astro.currentLocale,
);

const t = useTranslations(lang);

const home = getRelativeLocaleUrl(lang, "");

const navLinks = [
  { href: `${home}#services`, label: t.nav.services },
  { href: `${home}#process`, label: t.nav.process },
  { href: `${home}#projects`, label: t.nav.work },
 /* { href: `${home}#pricing`, label: t.nav.pricing },*/
  { href: `${home}#faq`, label: t.nav.faq },
  { href: `${home}blog/`, label: t.nav.blog },
];

const languages = [
  { code: "es", label: "Español" },
  { code: "en", label: "English" },
  { code: "ru", label: "Русский" },
  { code: "fr", label: "Français" },
] as const;

const currentLanguage =
  languages.find(
    (language) => language.code === lang,
  ) ?? languages[0];

const currentPath = stripLocale(
  Astro.url.pathname,
);

const languageHrefs = new Map<string, string>();

const posts = blogTranslationKey
  ? await getCollection("blog")
  : [];

for (const language of languages) {
  /*
   * Blog article:
   * resolve the translated article by translationKey.
   */
  if (blogTranslationKey) {
    const translatedPost = posts.find(
      (post) =>
        post.data.translationKey === blogTranslationKey &&
        post.id.startsWith(`${language.code}/`) &&
        !post.data.draft,
    );

    if (translatedPost) {
      const [, ...slugParts] =
        translatedPost.id.split("/");

      const slug = slugParts
        .join("/")
        .replace(/\.mdx?$/, "");

      languageHrefs.set(
        language.code,
        `/${language.code}/blog/${slug}/`,
      );

      continue;
    }
  }

  /*
   * All other pages:
   * preserve the current route.
   */
  languageHrefs.set(
    language.code,
    getRelativeLocaleUrl(
      language.code as Locale,
      currentPath,
    ),
  );
}
---

<header class="site-header">
  <div class="container site-header__inner">
    <!-- Logo 
    <a
      href={home}
      class="site-header__logo"
      aria-label={t.meta.siteName}
    >
      <span>Max Studio</span>
    </a>-->
    <a
  href={home}
  class="site-header__logo"
  aria-label={t.meta.siteName}
>
  <img
    src={logoNegro.src}
    alt={t.meta.siteName}
    class="site-header__logo-image"
  />
</a>

    <!-- Desktop navigation -->
    <nav
      class="site-header__nav"
      aria-label={t.a11y.mainNavigation}
    >
      {
        navLinks.map((link) => (
          <a href={link.href}>
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- Desktop actions -->
    <div class="site-header__actions">
      <div class="language-selector">
        <button
          class="language-selector__trigger"
          type="button"
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="language-menu"
          aria-label={t.a11y.switchLanguage}
        >
          <svg
            class="language-selector__globe"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="9" />
            <path d="M3 12h18" />
            <path d="M12 3c2.2 2.5 3.3 5.5 3.3 9s-1.1 6.5-3.3 9" />
            <path d="M12 3c-2.2 2.5-3.3 5.5-3.3 9s1.1 6.5 3.3 9" />
          </svg>

          <span class="language-selector__current">
            {currentLanguage.code.toUpperCase()}
          </span>

          <svg
            class="language-selector__chevron"
            viewBox="0 0 12 7"
            aria-hidden="true"
          >
            <path d="M1 1l5 5 5-5" />
          </svg>
        </button>

        <div
          class="language-selector__menu"
          id="language-menu"
          role="menu"
        >
          {
            languages.map((language) => (
              <a
                href={
                  languageHrefs.get(language.code) ??
                  getRelativeLocaleUrl(
                    language.code,
                    "",
                  )
                }
                class:list={{
                  "language-selector__option": true,
                  "is-active":
                    language.code === lang,
                }}
                role="menuitem"
                aria-current={
                  language.code === lang
                    ? "page"
                    : undefined
                }
              >
                <span class="language-selector__code">
                  {language.code.toUpperCase()}
                </span>

                <span class="language-selector__name">
                  {language.label}
                </span>

                {
                  language.code === lang && (
                    <span
                      class="language-selector__check"
                      aria-hidden="true"
                    >
                      ✓
                    </span>
                  )
                }
              </a>
            ))
          }
        </div>
      </div>

      <a
        href={`${home}#contact`}
        class="site-header__cta"
      >
        {t.cta.start}
      </a>
    </div>

    <!-- Mobile menu button -->
    <button
      class="site-header__menu"
      type="button"
      aria-label={t.a11y.openMenu}
      aria-expanded="false"
      aria-controls="mobile-navigation"
    >
      <span></span>
      <span></span>
    </button>
  </div>

  <!-- Mobile navigation -->
  <div
    class="site-header__mobile"
    id="mobile-navigation"
  >
    <nav
      class="site-header__mobile-nav"
      aria-label={t.a11y.mainNavigation}
    >
      {
        navLinks.map((link) => (
          <a href={link.href}>
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- Mobile languages -->
    <div class="site-header__mobile-language">
      <p class="site-header__mobile-language-title">
        {t.a11y.switchLanguage}
      </p>

      <div class="site-header__mobile-language-list">
        {
          languages.map((language) => (
            <a
              href={
                languageHrefs.get(language.code) ??
                getRelativeLocaleUrl(
                  language.code,
                  "",
                )
              }
              class:list={{
                "site-header__mobile-language-option": true,
                "is-active":
                  language.code === lang,
              }}
              aria-current={
                language.code === lang
                  ? "page"
                  : undefined
              }
            >
              <span>
                {language.code.toUpperCase()}
              </span>

              <span>{language.label}</span>

              {
                language.code === lang && (
                  <span aria-hidden="true">
                    ✓
                  </span>
                )
              }
            </a>
          ))
        }
      </div>
    </div>

    <!-- Mobile CTA -->
    <a
      href={`${home}#contact`}
      class="site-header__mobile-cta"
    >
      {t.cta.start}
    </a>
  </div>
</header>

<script>
  const header =
    document.querySelector<HTMLElement>(
      ".site-header",
    );

  const menu =
    document.querySelector<HTMLButtonElement>(
      ".site-header__menu",
    );

  const mobileNav =
    document.querySelector<HTMLElement>(
      ".site-header__mobile",
    );

  const languageSelector =
    document.querySelector<HTMLElement>(
      ".language-selector",
    );

  const languageTrigger =
    document.querySelector<HTMLButtonElement>(
      ".language-selector__trigger",
    );

  /*
   * HEADER SCROLL STATE
   */
  if (header) {
    const updateScrollState = () => {
      header.classList.toggle(
        "is-scrolled",
        window.scrollY > 8,
      );
    };

    updateScrollState();

    window.addEventListener(
      "scroll",
      updateScrollState,
      { passive: true },
    );

    header.addEventListener(
      "mouseenter",
      () => {
        header.classList.add("is-hovered");
      },
    );

    header.addEventListener(
      "mouseleave",
      () => {
        header.classList.remove("is-hovered");
      },
    );
  }

  /*
   * LANGUAGE SELECTOR
   */
  if (
    languageSelector &&
    languageTrigger
  ) {
    languageTrigger.addEventListener(
      "click",
      (event) => {
        event.stopPropagation();

        const isOpen =
          languageSelector.classList.contains(
            "is-open",
          );

        languageSelector.classList.toggle(
          "is-open",
          !isOpen,
        );

        languageTrigger.setAttribute(
          "aria-expanded",
          String(!isOpen),
        );
      },
    );

    document.addEventListener(
      "click",
      (event) => {
        if (
          !languageSelector.contains(
            event.target as Node,
          )
        ) {
          languageSelector.classList.remove(
            "is-open",
          );

          languageTrigger.setAttribute(
            "aria-expanded",
            "false",
          );
        }
      },
    );

    document.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "Escape") {
          languageSelector.classList.remove(
            "is-open",
          );

          languageTrigger.setAttribute(
            "aria-expanded",
            "false",
          );

          languageTrigger.focus();
        }
      },
    );
  }

  /*
   * MOBILE MENU
   */
  if (menu && mobileNav && header) {
    menu.addEventListener(
      "click",
      () => {
        const isOpen =
          menu.getAttribute(
            "aria-expanded",
          ) === "true";

        const nextState = !isOpen;

        menu.setAttribute(
          "aria-expanded",
          String(nextState),
        );

        mobileNav.classList.toggle(
          "is-open",
          nextState,
        );

        header.classList.toggle(
          "is-menu-open",
          nextState,
        );

        document.body.classList.toggle(
          "menu-open",
          nextState,
        );
      },
    );

    mobileNav
      .querySelectorAll("a")
      .forEach((link) => {
        link.addEventListener(
          "click",
          () => {
            menu.setAttribute(
              "aria-expanded",
              "false",
            );

            mobileNav.classList.remove(
              "is-open",
            );

            header.classList.remove(
              "is-menu-open",
            );

            document.body.classList.remove(
              "menu-open",
            );
          },
        );
      });
  }
</script>

<style>
  /* ==================================================
     HEADER
  ================================================== */

  .site-header {
    position: fixed;
    top: 0;
    left: 0;

    z-index: 100;

    width: 100%;

    background: transparent;
    border-bottom: 1px solid transparent;

    transition:
      background 300ms var(--ease),
      border-color 300ms var(--ease),
      box-shadow 300ms var(--ease),
      backdrop-filter 300ms var(--ease);
  }

  .site-header.is-scrolled,
  .site-header.is-hovered {
    background: rgb(255 255 255 / 78%);
    border-bottom-color: rgb(16 17 20 / 8%);
    box-shadow: 0 8px 30px rgb(16 17 20 / 6%);

    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  /* ==================================================
     INNER
  ================================================== */

  .site-header__inner {
    display: flex;
    align-items: center;

    min-height: var(--header-h);

    gap: clamp(12px, 1.8vw, 28px);
  }

  /* ==================================================
     LOGO
  ================================================== */

  .site-header__logo {
    display: flex;
    align-items: center;

    flex: 0 1 clamp(145px, 15vw, 190px);

    color: var(--ink);
    line-height: 1;
    text-decoration: none;
  }

/*
  .site-header__logo span {
    font-family: "AT Mikon", sans-serif;
    font-size: clamp(30px, 2.4vw, 42px);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }*/

  .site-header__logo-image {
  display: block;

  width: clamp(145px, 15vw, 190px);
  height: auto;

  max-width: 100%;
  object-fit: contain;
}

  /* ==================================================
     DESKTOP NAV
  ================================================== */

  .site-header__nav {
    display: flex;
    align-items: center;
    justify-content: center;

    flex: 1 1 auto;
    min-width: 0;

    gap: clamp(8px, 1.25vw, 22px);
  }

  .site-header__nav a {
    position: relative;

    color: var(--ink);

    font-size: clamp(14px, 1.05vw, 17px);
    font-weight: 500;
    line-height: 1.2;

    white-space: nowrap;

    transition: color 250ms var(--ease);
  }

  .site-header__nav a:hover {
    color: var(--ink);
  }

  .site-header__nav a::after {
    content: "";

    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;

    height: 1px;

    background: currentColor;

    transform: scaleX(0);
    transform-origin: right;

    transition: transform 280ms var(--ease);
  }

  .site-header__nav a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  /* ==================================================
     DESKTOP ACTIONS
  ================================================== */

  .site-header__actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;

    flex: 0 1 auto;
    min-width: 0;

    gap: clamp(9px, 1.2vw, 18px);
  }

  /* ==================================================
     LANGUAGE SELECTOR
  ================================================== */

  .language-selector {
    position: relative;
    flex: 0 0 auto;
  
  }

  .language-selector__trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 42px;
    padding: 0;

    border: 0;
    background: transparent;
    color: var(--ink);

    cursor: pointer;

    gap: 6px;
  }

  .language-selector__globe {
    width: 20px;
    height: 20px;

    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;

    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .language-selector__current {
    font-size: clamp(14px, 1.05vw, 17px);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .language-selector__chevron {
    width: 8px;
    height: 5px;

    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;

    stroke-linecap: round;
    stroke-linejoin: round;

    transition: transform 220ms var(--ease);
  }

  .language-selector.is-open
    .language-selector__chevron {
    transform: rotate(180deg);
  }

  /* ==================================================
     LANGUAGE DROPDOWN
  ================================================== */

  .language-selector__menu {
    position: absolute;
    top: calc(100% + 12px);
    right: 0;

    width: 190px;

    padding: 8px;

    background: rgb(255 255 255 / 96%);
    border: 1px solid rgb(16 17 20 / 8%);

    box-shadow: 0 18px 45px rgb(16 17 20 / 12%);

    opacity: 0;
    visibility: hidden;

    transform: translateY(-6px) scale(0.98);
    transform-origin: top right;

    pointer-events: none;

    transition:
      opacity 180ms var(--ease),
      transform 180ms var(--ease),
      visibility 180ms var(--ease);

    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .language-selector.is-open
    .language-selector__menu {
    opacity: 1;
    visibility: visible;

    transform: translateY(0) scale(1);

    pointer-events: auto;
  }

  .language-selector__option {
    display: grid;
    grid-template-columns: 34px 1fr auto;
    align-items: center;

    min-height: 42px;
    padding: 0 10px;

    border-radius: 7px;

    color: var(--ink);
    gap: 8px;

    transition:
      background 180ms var(--ease);
  }

  .language-selector__option:hover,
  .language-selector__option.is-active {
    background: #f4f5f6;
  }

  .language-selector__code {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .language-selector__name {
    color: var(--ink-soft);
    font-size: 13px;
    font-weight: 400;
  }

  .language-selector__check {
    color: var(--red);
    font-size: 13px;
    font-weight: 600;
  }

  /* ==================================================
     CTA
  ================================================== */

  .site-header__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 42px;
    padding-inline: clamp(14px, 1.5vw, 21px);

    border-radius: 999px;

    background: var(--red);
    color: #fff;

    font-size: clamp(12px, 0.85vw, 13px);
    font-weight: 600;

    white-space: nowrap;

    flex: 0 0 auto;

    transition:
      background 220ms var(--ease);
  }

  .site-header__cta:hover {
    background: var(--red-hover);
  }

  /* ==================================================
     MOBILE BUTTON
  ================================================== */

  .site-header__menu {
    display: none;

    width: 48px;
    height: 48px;

    padding: 0;
    border: 0;

    background: transparent;
    color: var(--ink);

    cursor: pointer;

    flex: 0 0 auto;
  }

  .site-header__menu span {
    display: block;

    width: 30px;
    height: 2px;

    margin: 7px auto;

    border-radius: 999px;

    background: currentColor;

    transition:
      transform 250ms var(--ease),
      opacity 250ms var(--ease);
  }

  .site-header__menu[aria-expanded="true"]
    span:first-child {
    transform: translateY(4.5px) rotate(45deg);
  }

  .site-header__menu[aria-expanded="true"]
    span:last-child {
    transform: translateY(-4.5px) rotate(-45deg);
  }

  /* ==================================================
     MOBILE PANEL
  ================================================== */

  .site-header__mobile {
    position: absolute;
    top: 100%;
    left: 0;

    width: 100%;

    max-height: calc(100dvh - 68px);

    overflow-y: auto;

    padding: 30px var(--pad-x) 34px;

    /*
     * SOLID MOBILE BACKGROUND
     */
    background: #fcf8f4;

    border-top: 1px solid rgb(16 17 20 / 8%);

    box-shadow: 0 18px 40px rgb(16 17 20 / 10%);

    opacity: 0;
    visibility: hidden;

    transform: translateY(-8px);

    pointer-events: none;

    transition:
      opacity 250ms var(--ease),
      transform 250ms var(--ease),
      visibility 250ms var(--ease);

    /*
     * Deliberately no transparency and no blur.
     */
  }

  .site-header__mobile.is-open {
    opacity: 1;
    visibility: visible;

    transform: translateY(0);

    pointer-events: auto;
  }

  /*
   * When the mobile menu is open, the header itself
   * also becomes fully opaque.
   */
  .site-header.is-menu-open {
    background: #fcf8f4;
    border-bottom-color: rgb(16 17 20 / 8%);
    box-shadow: none;

    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .site-header__mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .site-header__mobile-nav a {
    color: var(--ink);

    font-size: 19px;
    font-weight: 500;
    line-height: 1.25;
  }

  /* ==================================================
     MOBILE LANGUAGES
  ================================================== */

  .site-header__mobile-language {
    margin-top: 30px;
    padding-top: 24px;

    border-top: 1px solid rgb(16 17 20 / 10%);
  }

  .site-header__mobile-language-title {
    margin: 0 0 14px;

    color: var(--muted);

    font-size: 11px;
    font-weight: 600;

    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .site-header__mobile-language-list {
    display: grid;

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: 8px;
  }

  .site-header__mobile-language-option {
    display: grid;

    grid-template-columns: 32px 1fr auto;
    align-items: center;

    min-height: 44px;

    padding: 0 10px;

    border-radius: 7px;

    background: rgb(255 255 255 / 54%);

    color: var(--ink);

    gap: 6px;

    transition:
      background 180ms var(--ease);
  }

  .site-header__mobile-language-option:hover,
  .site-header__mobile-language-option.is-active {
    background: #fff;
  }

  .site-header__mobile-language-option
    > span:first-child {
    font-size: 11px;
    font-weight: 700;
  }

  .site-header__mobile-language-option
    > span:nth-child(2) {
    font-size: 13px;
  }

  .site-header__mobile-language-option
    > span:last-child {
    color: var(--red);

    font-size: 13px;
    font-weight: 600;
  }

  /* ==================================================
     MOBILE CTA
  ================================================== */

  .site-header__mobile-cta {
    display: flex;
    align-items: center;
    justify-content: center;

    min-height: 50px;

    margin-top: 24px;

    border-radius: 999px;

    background: var(--red);
    color: #fff;

    font-size: 14px;
    font-weight: 600;

    transition:
      background 220ms var(--ease);
  }

  .site-header__mobile-cta:hover {
    background: var(--red-hover);
  }

  /* ==================================================
     DESKTOP → MOBILE
  ================================================== */

  @media (max-width: 920px) {
    .site-header__nav,
    .site-header__actions {
      display: none;
    }

    .site-header__inner {
      justify-content: space-between;
    }

    .site-header__menu {
      display: block;
    }
  }

  @media (max-width: 767px) {
    .site-header__inner {
      min-height: 68px;
    }

    .site-header__logo {
      flex-basis: auto;
      width: auto;
    }

    .site-header__logo span {
      font-size: clamp(30px, 9vw, 40px);
    }
  }

  /* ==================================================
     REDUCED MOTION
  ================================================== */

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .site-header__nav a,
    .site-header__nav a::after,
    .site-header__cta,
    .site-header__menu span,
    .site-header__mobile,
    .language-selector__menu,
    .language-selector__chevron {
      transition: none;
    }
  }
</style>