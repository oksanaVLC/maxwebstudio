---
import { Image } from "astro:assets";

import valencia1 from "../../assets/images/valencia1.jpg";
import valencia2 from "../../assets/images/valencia2.jpg";
import valencia3 from "../../assets/images/valencia3.jpg";

import { getLocale, useTranslations } from "../../i18n";

const imacMockup = "/images/imac-mockup.webp";
const projectImage = "/images/poster-type.jpg";

const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);
const c = t.inspiration;

const slides = [valencia1, valencia2, valencia3];
---

<section
  id="inspiration"
  class="inspiration"
  aria-labelledby="inspiration-title"
>
  <div class="container">
    <!-- ==================================================
         IMAGE SLIDER
         ================================================== -->

    <div
      class="inspiration__slider"
      data-inspiration-slider
      aria-hidden="true"
    >
      {
        slides.map((slide, index) => (
          <div
            class:list={[
              "inspiration__slide",
              index === 0 && "is-active",
            ]}
            data-inspiration-slide
          >
            <Image
              src={slide}
              alt=""
              width={1200}
              quality={82}
              format="webp"
              loading={index === 0 ? "eager" : "lazy"}
              decoding="async"
              sizes="(max-width: 767px) 100vw, 1240px"
            />
          </div>
        ))
      }

      <div
        class="inspiration__slider-overlay"
        aria-hidden="true"
      ></div>
    </div>

    <!-- ==================================================
         CONTENT
         ================================================== -->

    <div class="inspiration__grid">
      <!-- TEXT -->

      <div class="inspiration__text">
        <p class="section-eyebrow">
          <span
            class="section-eyebrow__star"
            aria-hidden="true"
          >
            ✦
          </span>

          <span>{c.eyebrow}</span>
        </p>

        <h2
          id="inspiration-title"
          class="inspiration__title"
          data-reveal="up"
        >
          {c.title}
        </h2>

        <div class="inspiration__copy">
          <p
            class="inspiration__lead"
            data-reveal="text"
          >
            {c.lead}
          </p>

          <p>{c.paragraphs.one}</p>

          <p>{c.paragraphs.two}</p>
        </div>

        <!-- TAGS -->

        <div
          class="inspiration__tags"
          data-stagger
          aria-label={c.tagsAriaLabel}
        >
          <span data-reveal="up">
            {c.tags.mediterranean}
          </span>

          <span data-reveal="up">
            {c.tags.architecture}
          </span>

          <span data-reveal="up">
            {c.tags.color}
          </span>

          <span data-reveal="up">
            {c.tags.tradition}
          </span>
        </div>
      </div>

      <!-- ==================================================
           MOCKUPS
           ================================================== -->

      <div
        class="inspiration__devices"
        data-reveal="image"
      >
        <div class="mockup">
          <!-- iMac -->

          <div class="mockup__imac">
            <img
              src={imacMockup}
              alt=""
              class="mockup__frame"
              decoding="async"
            />

            <div class="mockup__screen">
              <img
                src={projectImage}
                alt={c.imageAlt}
                decoding="async"
              />
            </div>
          </div>

          <!-- Phone -->

          <div class="mockup__phone">
            <div class="mockup__phone-screen">
              <img
                src={projectImage}
                alt=""
                decoding="async"
              />
            </div>
          </div>
        </div>

        <span
          class="inspiration__caption"
          data-reveal="text"
        >
          {c.caption}
        </span>
      </div>
    </div>
  </div>
</section>

<script>
  const sliders =
    document.querySelectorAll<HTMLElement>(
      "[data-inspiration-slider]"
    );

  sliders.forEach((slider) => {
    const slides =
      slider.querySelectorAll<HTMLElement>(
        "[data-inspiration-slide]"
      );

    if (slides.length <= 1) return;

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    let current = 0;
    let timer: number | undefined;
    let isPaused = false;

    const showSlide = (nextIndex: number) => {
      slides[current]?.classList.remove("is-active");

      current =
        (nextIndex + slides.length) %
        slides.length;

      slides[current]?.classList.add("is-active");
    };

    const start = () => {
      if (reduceMotion || isPaused) return;

      if (timer !== undefined) {
        window.clearInterval(timer);
      }

      timer = window.setInterval(() => {
        showSlide(current + 1);
      }, 5600);
    };

    const stop = () => {
      if (timer !== undefined) {
        window.clearInterval(timer);
        timer = undefined;
      }
    };

    const pause = () => {
      isPaused = true;
      stop();
    };

    const resume = () => {
      isPaused = false;
      start();
    };

    if (!reduceMotion) {
      slider.addEventListener("mouseenter", pause);
      slider.addEventListener("mouseleave", resume);

      slider.addEventListener("focusin", pause);
      slider.addEventListener("focusout", resume);

      document.addEventListener("visibilitychange", () => {
        if (document.hidden) {
          stop();
        } else {
          start();
        }
      });

      start();
    }
  });
</script>

<style>
  /* ==================================================
     INSPIRATION
     ================================================== */

  .inspiration {
    position: relative;
    overflow: hidden;
    background: var(--surface);
  }

  /* ==================================================
     IMAGE SLIDER
     ================================================== */

  .inspiration__slider {
    position: relative;
  width: 100%;
  height: clamp(480px, 58vw, 720px);
  overflow: hidden;
  background: #dceff2;
  }

  .inspiration__slide {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    opacity: 0;

    transform: scale(1.055);

    transition:
      opacity 1400ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 5600ms cubic-bezier(0.16, 1, 0.3, 1);

    will-change: opacity, transform;
  }

  .inspiration__slide.is-active {
    opacity: 1;
    transform: scale(1);
  }

  .inspiration__slide :global(img) {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;
  }

  /*
   * Very subtle veil to keep the photograph
   * elegant and consistent with the rest
   * of the section.
   */
  .inspiration__slider-overlay {
    position: absolute;
    inset: 0;

    z-index: 2;

    pointer-events: none;

    background:
      linear-gradient(
        180deg,
        rgb(255 255 255 / 0.04) 0%,
        rgb(255 255 255 / 0) 55%,
        rgb(16 17 20 / 0.07) 100%
      );
  }

  /* ==================================================
     GRID
     ================================================== */

  .inspiration__grid {
    display: grid;

    grid-template-columns:
      minmax(0, 1.35fr)
      minmax(320px, 0.85fr);

    align-items: center;

    gap: clamp(60px, 8vw, 120px);

    padding-block: clamp(80px, 9vw, 120px);
  }

  /* ==================================================
     TEXT
     ================================================== */

  .inspiration__text {
    max-width: 720px;
  }

  .inspiration__title {
    max-width: 720px;

    margin: 0 0 30px;

    color: var(--ink);

    font-family: var(--font-sans);

    font-size: clamp(38px, 5vw, 62px);

    font-weight: 300;

    line-height: 1.05;

    letter-spacing: -0.045em;
  }

  /* ==================================================
     COPY
     ================================================== */

  .inspiration__copy p {
    margin: 0 0 20px;

    color: var(--ink-soft);

    font-family: var(--font-sans);

    font-size: var(--fs-body);

    font-weight: 400;

    line-height: 1.72;
  }

  .inspiration__copy .inspiration__lead {
    margin-bottom: 22px;

    color: var(--ink-body);

    font-size: var(--fs-lead);

    line-height: 1.65;

    transition-delay: 140ms;
  }

  .inspiration__copy p:last-child {
    margin-bottom: 0;
  }

  /* ==================================================
     TAGS
     ================================================== */

  .inspiration__tags {
    display: flex;

    flex-wrap: wrap;

    gap: 9px;

    margin-top: 34px;
  }

  .inspiration__tags span {
    display: inline-flex;

    align-items: center;

    min-height: 36px;

    padding: 8px 13px;

    border: 1px solid var(--line);

    background: var(--surface-alt);

    color: var(--ink-soft);

    font-family: var(--font-sans);

    font-size: 12px;

    font-weight: 500;

    letter-spacing: 0.01em;
  }

  /* ==================================================
     DEVICES
     ================================================== */

  .inspiration__devices {
    display: flex;

    flex-direction: column;

    align-items: center;

    gap: 14px;

    width: 100%;
  }

  .mockup {
    position: relative;

    width: min(100%, 420px);
  }

  /* ==================================================
     iMAC
     ================================================== */

  .mockup__imac {
    position: relative;

    width: 100%;

    aspect-ratio: 1000 / 1159;
  }

  .mockup__frame {
    position: absolute;

    inset: 0;

    z-index: 1;

    display: block;

    width: 100%;
    height: 100%;

    object-fit: contain;
  }

  .mockup__screen {
    position: absolute;

    inset: 0;

    z-index: 2;

    overflow: hidden;

    background: var(--screen-dark);

    clip-path: polygon(
      23% 27%,
      86% 16.6%,
      79% 66.1%,
      14.2% 68%
    );
  }

  .mockup__screen img {
    position: absolute;

    left: 8%;
    top: 8%;

    width: 84%;
    height: 68%;

    max-width: none;

    object-fit: cover;

    transform: skewY(-10.8deg);

    transform-origin: center;
  }

  /* ==================================================
     PHONE
     ================================================== */

  .mockup__phone {
    position: absolute;

    left: -6%;
    bottom: 2%;

    z-index: 3;

    width: 19%;

    aspect-ratio: 9 / 18.5;

    padding: 3px;

    background: linear-gradient(
      160deg,
      #33363b 0%,
      #101114 64%
    );

    border-radius: 9px;

    box-shadow:
      -12px 16px 30px
      rgb(16 17 20 / 28%);

    transform:
      perspective(620px)
      rotateY(22deg)
      rotateX(5deg)
      rotateZ(-3deg);

    transform-origin: bottom right;
  }

  .mockup__phone-screen {
    display: block;

    width: 100%;
    height: 100%;

    overflow: hidden;

    border-radius: 7px;

    background: var(--screen-dark);
  }

  .mockup__phone-screen img {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
  }

  /* ==================================================
     CAPTION
     ================================================== */

  .inspiration__caption {
    color: var(--muted);

    font-family: var(--font-sans);

    font-size: var(--fs-body);

    line-height: 1.4;

    letter-spacing: 0.02em;

    transition-delay: 180ms;
  }

  /* ==================================================
     TABLET
     ================================================== */

  @media (max-width: 1023px) {
    .inspiration__grid {
      grid-template-columns: 1fr;

      gap: 70px;
    }

    .inspiration__text {
      max-width: 760px;
    }

    .inspiration__devices {
      max-width: 480px;

      margin-inline: auto;
    }
  }

  /* ==================================================
     MOBILE
     ================================================== */

  @media (max-width: 767px) {
    .inspiration__slider {
   width: calc(100% + (var(--pad-x) * 2));
    height: 520px;
    margin-inline: calc(var(--pad-x) * -1);
    }

    .inspiration__slide {
      transform: scale(1.045);
    }

    .inspiration__slide.is-active {
      transform: scale(1);
    }

    .inspiration__grid {
      padding-block: 72px;

      gap: 60px;
    }

    .inspiration__title {
      font-size: clamp(36px, 10vw, 52px);
    }

    .inspiration__copy p {
      font-size: var(--fs-body);

      line-height: 1.68;
    }

    .inspiration__copy .inspiration__lead {
      font-size: var(--fs-lead);
    }

    .inspiration__tags {
      gap: 8px;
    }

    .inspiration__tags span {
      font-size: 11.5px;
    }

    .mockup {
      width: min(100%, 360px);

      margin-inline: auto;

      transform: translateX(6%);
    }

    .mockup__phone {
      left: 0;
    }
  }

  /* ==================================================
     REDUCED MOTION
     ================================================== */

  @media (prefers-reduced-motion: reduce) {
    .inspiration__slide,
    .inspiration__slide.is-active {
      transform: none;

      transition:
        opacity 400ms ease;
    }
  }
</style>