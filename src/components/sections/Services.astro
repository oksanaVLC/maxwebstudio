---
import { getLocale, useTranslations } from "../../i18n";

/* SVGs limpios (sin fondo blanco, fill = currentColor) */
import iconDesign from "../../assets/icons/services/1.svg?raw";
import iconDevelopment from "../../assets/icons/services/2.svg?raw";
import iconEcommerce from "../../assets/icons/services/3.svg?raw";
import iconGrowth from "../../assets/icons/services/4.svg?raw";

const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);

const services = [
  { key: "design", icon: iconDesign },
  { key: "development", icon: iconDevelopment },
  { key: "ecommerce", icon: iconEcommerce },
  { key: "growth", icon: iconGrowth },
] as const;
---

<section
  class="services section"
  id="services"
  aria-labelledby="services-title"
>
  <div class="services__tone services__tone--fine" aria-hidden="true"></div>
  <div class="services__tone services__tone--bold" aria-hidden="true"></div>

  <div class="container services__inner">
    <div class="services__intro">
      <p class="services__eyebrow">
        <span aria-hidden="true">✦</span>
        {t.services.eyebrow}
      </p>

      <h2 id="services-title" data-reveal="up">
        {t.services.title}
      </h2>

      <p class="services__lead" data-reveal="text">
        {t.services.lead}
      </p>
    </div>

    <div class="services__grid" data-stagger>
      {
        services.map(({ key, icon }, i) => (
          <article class="service-card" data-reveal="up">
            <div class="service-card__panel">
              <span class="service-card__tone" aria-hidden="true" />
              <span class="service-card__line" aria-hidden="true" />
              <span class="service-card__num" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>

              <div class="service-card__disc" aria-hidden="true">
                <span class="service-card__icon" set:html={icon} />
              </div>

              <div class="service-card__body">
                <h3>{t.services.items[key].title}</h3>
                <p>{t.services.items[key].description}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* =========================================================
     SECTION — silver + white halftone
     ========================================================= */

  .services {
    position: relative;
    overflow: hidden;
    isolation: isolate;
background: linear-gradient(
  165deg,
  #fafbfc 0%,
  #f3f5f6 48%,
  #eef0f2 78%,
  #f7f8f9 100%
);
    border-top: 1px solid rgba(255, 255, 255, 0.8);
  }

  .services__tone {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  /* fine dots — top right */
  .services__tone--fine {
    background-image: radial-gradient(
      circle,
      rgba(255, 255, 255, 0.9) 1.4px,
      transparent 1.9px
    );
    background-size: 12px 12px;
    -webkit-mask-image: radial-gradient(
      ellipse 75% 85% at 100% 0%,
      #000 0%,
      rgba(0, 0, 0, 0.4) 45%,
      transparent 72%
    );
    mask-image: radial-gradient(
      ellipse 75% 85% at 100% 0%,
      #000 0%,
      rgba(0, 0, 0, 0.4) 45%,
      transparent 72%
    );
  }

  /* bold dots — bottom left */
  .services__tone--bold {
    background-image: radial-gradient(
      circle,
      rgba(255, 255, 255, 0.85) 2.8px,
      transparent 3.4px
    );
    background-size: 22px 22px;
    -webkit-mask-image: radial-gradient(
      ellipse 60% 65% at 0% 100%,
      #000 0%,
      rgba(0, 0, 0, 0.45) 40%,
      transparent 74%
    );
    mask-image: radial-gradient(
      ellipse 60% 65% at 0% 100%,
      #000 0%,
      rgba(0, 0, 0, 0.45) 40%,
      transparent 74%
    );
  }

  /* =========================================================
     INTRO
     ========================================================= */

  .services__intro {
    max-width: 850px;
    margin-bottom: 56px;
  }

  .services__eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
    color: var(--ink-soft);
    font-size: var(--fs-small);
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .services__eyebrow span {
    color: var(--red);
    font-size: 12px;
  }

  .services h2 {
    max-width: 800px;
    margin: 0;
    color: var(--ink);
    font-size: clamp(38px, 5vw, 64px);
    font-weight: 300;
    letter-spacing: -0.055em;
    line-height: 1;
    text-wrap: balance;
  }

  .services__lead {
    max-width: 680px;
    margin-top: 24px;
    color: var(--ink-soft);
    font-size: var(--fs-lead);
    line-height: 1.6;
    transition-delay: 120ms;
  }

  /* =========================================================
     GRID
     ========================================================= */

  .services__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }

  /* =========================================================
     CARD
     (article = reveal wrapper, panel = visuals + hover,
      so stagger delays never slow down the hover)
     ========================================================= */

  .service-card {
    min-width: 0;
  }

  .service-card__panel {
    position: relative;
    overflow: hidden;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    padding: 40px clamp(22px, 2.2vw, 32px) 36px;
    text-align: center;
    background: var(--surface);
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 20px;
    box-shadow:
      0 18px 50px rgba(16, 17, 20, 0.16),
      0 2px 6px rgba(16, 17, 20, 0.06);
    transition:
      transform var(--motion-duration-fast) var(--motion-ease),
      box-shadow var(--motion-duration-fast) var(--motion-ease);
  }

  .service-card:hover .service-card__panel {
    transform: translateY(-6px);
    box-shadow:
      0 28px 60px rgba(16, 17, 20, 0.22),
      0 2px 6px rgba(16, 17, 20, 0.06);
  }

  /* halftone inside the card — kept clear around the icon */
  .service-card__tone {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(
      circle,
      rgba(142, 148, 156, 0.28) 1.6px,
      transparent 2.1px
    );
    background-size: 11px 11px;
    -webkit-mask-image: radial-gradient(
      circle at 50% 118px,
      transparent 0 120px,
      rgba(0, 0, 0, 0.15) 150px,
      #000 330px
    );
    mask-image: radial-gradient(
      circle at 50% 118px,
      transparent 0 120px,
      rgba(0, 0, 0, 0.15) 150px,
      #000 330px
    );
  }

  .service-card__line {
    position: absolute;
    top: 0;
    left: 32px;
    right: 32px;
    height: 2px;
    background: var(--red);
  }

  .service-card__num {
    position: absolute;
    top: 22px;
    right: 24px;
    color: transparent;
    -webkit-text-stroke: 1px rgba(16, 17, 20, 0.22);
    font-size: 30px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .service-card__disc {
    position: relative;
    display: grid;
    place-items: center;
    width: 156px;
    height: 156px;
    flex-shrink: 0;
    border-radius: 50%;
    background: radial-gradient(
      circle at 34% 28%,
      #ffffff 0%,
      #f4f5f6 45%,
      #e3e6e9 100%
    );
    border: 1px solid var(--line-strong);
    box-shadow:
      0 0 0 10px var(--surface),
      0 0 0 11px var(--line),
      inset 0 -6px 14px rgba(142, 148, 156, 0.18),
      inset 0 2px 4px rgba(255, 255, 255, 0.9);
    transition: box-shadow var(--motion-duration-fast) var(--motion-ease);
  }

  .service-card:hover .service-card__disc {
    box-shadow:
      0 0 0 10px var(--surface),
      0 0 0 11px rgba(255, 87, 87, 0.5),
      inset 0 -6px 14px rgba(142, 148, 156, 0.18),
      inset 0 2px 4px rgba(255, 255, 255, 0.9);
  }

  .service-card__icon {
    display: block;
    width: 110px;
    height: 110px;
    color: var(--red);
  }

  .service-card__icon :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .service-card__body {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .service-card h3 {
    margin: 0;
    color: var(--ink);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .service-card p {
    color: var(--ink-soft);
    font-size: var(--fs-body);
    line-height: 1.65;
  }

  /* =========================================================
     RESPONSIVE
     ========================================================= */

  @media (max-width: 1099px) {
    .services__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 639px) {
    .services__intro {
      margin-bottom: 42px;
    }

    .services h2 {
      font-size: clamp(36px, 11vw, 52px);
    }

    .services__grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  @media (hover: none), (prefers-reduced-motion: reduce) {
    .service-card:hover .service-card__panel {
      transform: none;
    }
  }
</style>