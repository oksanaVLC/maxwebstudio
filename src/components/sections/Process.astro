---
import { Image, getImage } from "astro:assets";

import { default as we, default as weMobile } from "../../assets/images/still-life-graphic-design-day.jpg";
import { getLocale, useTranslations } from "../../i18n";

const weMobileOptimized = await getImage({
  src: weMobile,
  width: 800,
  quality: 75,
  format: "webp",
});

const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);
---

<section
  class="process section"
  id="process"
  aria-labelledby="process-title"
>
  <div class="container">
    <div class="process__intro">
<p class="section-eyebrow">
  <span class="section-eyebrow__star" aria-hidden="true">✦</span>
  <span>{t.process.eyebrow}</span>
</p>

      <h2 id="process-title" data-reveal="up">
        {t.process.title}
      </h2>
    </div>

    <div class="process__feature" data-reveal="image">
      <picture>
        <source
          media="(max-width: 767px)"
          srcset={weMobileOptimized.src}
          width={weMobileOptimized.attributes.width}
          height={weMobileOptimized.attributes.height}
        />

        <Image
          src={we}
          alt={t.process.feature.imageAlt}
          loading="lazy"
          width={1200}
          quality={80}
          format="webp"
        />
      </picture>

      <!-- Capas decorativas: puntos finos + desenfoque progresivo -->
      <span class="process__feature-dots" aria-hidden="true"></span>
      <span class="process__feature-blur" aria-hidden="true"></span>
      <img
  class="process__feature-logo"
  src="/favicon.png"
  alt=""
  aria-hidden="true"
/>

      <div class="process__feature-copy" data-reveal="text">
        <p>{t.process.feature.text}</p>
      </div>
    </div>

    <div class="process__steps" data-stagger>
      <article class="process-step" data-reveal="up">
        <span class="process-step__number" aria-hidden="true">
          01
        </span>

        <div class="process-step__content">
          <h3>{t.process.steps.plan.title}</h3>
          <p>{t.process.steps.plan.description}</p>
        </div>
      </article>

      <article class="process-step" data-reveal="up">
        <span class="process-step__number" aria-hidden="true">
          02
        </span>

        <div class="process-step__content">
          <h3>{t.process.steps.design.title}</h3>
          <p>{t.process.steps.design.description}</p>
        </div>
      </article>

      <article class="process-step" data-reveal="up">
        <span class="process-step__number" aria-hidden="true">
          03
        </span>

        <div class="process-step__content">
          <h3>{t.process.steps.launch.title}</h3>
          <p>{t.process.steps.launch.description}</p>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .process {
    background: var(--surface);
  }

  .process__intro {
    max-width: 850px;
    margin-bottom: 64px;
  }

  /* Imagen principal — versión clara */

  .process__feature {
    /* Ajustes rápidos */
    --veil: 0.22;           /* velo claro sobre toda la foto */
    --dot-size: 0.7px;      /* radio de cada punto */
    --dot-gap: 4px;         /* distancia entre puntos */
    --dot-alpha: 0.55;      /* intensidad de los puntos */
    --fade-to: var(--surface, #f6f3ee);

    position: relative;
    isolation: isolate;
    width: 100%;
    height: clamp(480px, 58vw, 720px);
    margin-bottom: 88px;
    overflow: hidden;
    background: var(--fade-to); /* sin "flash" oscuro mientras carga */
  }

  .process__feature picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .process__feature picture img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    /* Más luminosa, sombras abiertas, color algo más suave */
    filter: brightness(1.07) contrast(0.9) saturate(0.88);
  }

  /* Velo claro + trama de puntos muy finos (claros, nunca oscuros) */
  .process__feature-dots {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(
        circle,
        rgb(255 255 255 / var(--dot-alpha)) var(--dot-size),
        transparent calc(var(--dot-size) + 0.5px)
      ) 0 0 / var(--dot-gap) var(--dot-gap),
      rgb(255 255 255 / var(--veil));
    /* Los puntos se notan menos arriba y más hacia el texto */
    -webkit-mask-image: linear-gradient(180deg, rgb(0 0 0 / 0.55) 0%, #000 60%);
            mask-image: linear-gradient(180deg, rgb(0 0 0 / 0.55) 0%, #000 60%);
  }

  /* Desenfoque progresivo: la foto se suaviza solo detrás del texto */
  .process__feature-blur {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    -webkit-backdrop-filter: blur(14px) saturate(1.05);
            backdrop-filter: blur(14px) saturate(1.05);
    -webkit-mask-image: linear-gradient(180deg, transparent 48%, rgb(0 0 0 / 0.6) 70%, #000 100%);
            mask-image: linear-gradient(180deg, transparent 48%, rgb(0 0 0 / 0.6) 70%, #000 100%);
  }

  /* Fundido claro hacia el color de la sección (en lugar del degradado negro) */
  .process__feature::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      transparent 40%,
      color-mix(in srgb, var(--fade-to) 45%, transparent) 64%,
      color-mix(in srgb, var(--fade-to) 88%, transparent) 100%
    );
  }

  /* Texto sobre la fotografía */

  .process__feature-copy {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 4;
    padding: clamp(28px, 5vw, 58px);
    color: var(--ink);
    transition-delay: 180ms;
  }

  .process__feature-copy p {
    max-width: 680px;
    margin: 0;
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: clamp(20px, 2.2vw, 29px);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.28;
    /* Halo claro, no sombra oscura */
    text-shadow: 0 0 22px color-mix(in srgb, var(--fade-to) 90%, transparent);
  }

  /* Navegadores sin backdrop-filter: un poco más de fundido */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .process__feature::after {
      background: linear-gradient(
        180deg,
        transparent 34%,
        color-mix(in srgb, var(--fade-to) 60%, transparent) 62%,
        color-mix(in srgb, var(--fade-to) 94%, transparent) 100%
      );
    }
  }

  /* Pasos */

  .process__steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 48px;
  }

  .process-step {
    min-width: 0;
  }

  .process-step__number {
    display: block;
    margin-bottom: 28px;
    color: var(--line-strong);
    font-family: var(--font-sans);
    font-size: clamp(58px, 7vw, 92px);
    font-weight: 300;
    letter-spacing: -0.07em;
    line-height: 0.85;
  }

  .process-step__content {
    max-width: 330px;
  }

  .process-step h3 {
    margin: 0 0 12px;
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .process-step p {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--fs-body);
    line-height: 1.65;
  }
  /* Logo de marca sobre la fotografía */

.process__feature-logo {
  position: absolute;
  top: 12px;
  right: 12px;

  z-index: 5;

  width: clamp(52px, 5vw, 76px);
  height: auto;

  display: block;
  object-fit: contain;

  opacity: 0.92;

  filter: drop-shadow(
    0 2px 8px rgb(16 17 20 / 0.18)
  );

  pointer-events: none;
  user-select: none;
}

  @media (max-width: 900px) {
    .process__steps {
      gap: 32px;
    }

    .process-step__content {
      max-width: none;
    }
  }

  @media (max-width: 767px) {
    .process__intro {
      margin-bottom: 44px;
    }

    .process__feature {
      --dot-gap: 3.5px;
      width: calc(100% + (var(--pad-x) * 2));
      height: 350px;
      margin-inline: calc(var(--pad-x) * -1);
      margin-bottom: 64px;
    }

    .process__feature-blur {
      -webkit-mask-image: linear-gradient(180deg, transparent 40%, rgb(0 0 0 / 0.65) 64%, #000 100%);
              mask-image: linear-gradient(180deg, transparent 40%, rgb(0 0 0 / 0.65) 64%, #000 100%);
    }

    .process__feature::after {
      background: linear-gradient(
        180deg,
        transparent 42%,
        color-mix(in srgb, var(--fade-to) 25%, transparent) 78%,
        color-mix(in srgb, var(--fade-to) 92%, transparent) 100%
      );
    }

    .process__feature-copy {
      padding: 28px 24px;
    }

    .process__feature-copy p {
      max-width: 560px;
      font-size: 20px;
      line-height: 1.32;
    }

    .process__steps {
      grid-template-columns: 1fr;
      gap: 54px;
    }

    .process-step__number {
      margin-bottom: 22px;
      font-size: 68px;
    }

    .process-step__content {
      max-width: 500px;
    }
  .process__feature-logo {
    top: 10px;
    right: 10px;
    width: 48px;
  }
  }
</style>
