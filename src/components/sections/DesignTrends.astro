---
import { getImage } from "astro:assets";

import image from "../../assets/images/halftones.jpg";
import { getLocale, useTranslations } from "../../i18n";

const lang = getLocale(Astro.currentLocale);
const c = useTranslations(lang).designTrends;

const optimizedImage = await getImage({
  src: image,
  width: 1200,
  quality: 80,
  format: "webp",
});
---

<section
  id="design-trends"
  class="section design-trends"
  aria-labelledby="design-trends-title"
>
  <div class="container">
    <div class="design-trends__head">
      <p class="design-trends__eyebrow" data-reveal="up">
        <span aria-hidden="true">✦</span>
        {c.eyebrow}
      </p>

      <h2
        id="design-trends-title"
        class="h2"
        data-reveal="up"
      >
        {c.title}
      </h2>

      <p class="lead" data-reveal="text">
        {c.intro}
      </p>
    </div>

    <div class="design-trends__layout">
      <div
        class="design-trends__visual"
        data-reveal="left"
      > 
        <div class="design-trends__image">
          <img
  src={optimizedImage.src}
  width={optimizedImage.attributes.width}
  height={optimizedImage.attributes.height}
  alt={c.imageAlt}
  loading="lazy"
  decoding="async"
/>
 
          <div
            class="design-trends__halftone"
            aria-hidden="true"
          ></div>

          <div
            class="design-trends__split"
            aria-hidden="true"
          ></div>

          <span
            class="design-trends__label design-trends__label--image"
            aria-hidden="true"
          >
            01 / 02
          </span>
        </div>
      </div>

      <div
        class="design-trends__content"
        data-reveal="right"
      >
        <p class="design-trends__index">
          01
        </p>

        <h3 class="design-trends__title">
          {c.heading}
        </h3>

        <p class="design-trends__description">
          {c.description}
        </p>

        <ul class="design-trends__points">
          {
            c.points.map((point) => (
              <li class="design-trends__point">
                <span
                  class="design-trends__point-arrow"
                  aria-hidden="true"
                >
                  →
                </span>

                <span class="design-trends__point-text">
                  {point}
                </span>
              </li>
            ))
          }
        </ul>

        <a
          class="design-trends__link"
          href="#contact"
        >
          <span>{c.link}</span>

          <span
            class="design-trends__link-arrow"
            aria-hidden="true"
          >
            →
          </span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .design-trends {
    background: var(--surface);
    overflow: hidden;
  }

  /* ---------------------------------------------------------
     HEADER
     --------------------------------------------------------- */

  .design-trends__head {
    max-width: 760px;
    margin-bottom: clamp(52px, 7vw, 84px);
  }

  .design-trends__head h2 {
    max-width: 800px;
    margin: 0;
    color: var(--ink);
    font-size: clamp(38px, 5vw, 64px);
    font-weight: 300;
    letter-spacing: -0.055em;
    line-height: 1;
    text-wrap: balance;
  }

  .design-trends__eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 18px;
    color: var(--muted);
    font-size: var(--fs-small);
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .design-trends__eyebrow span {
    color: var(--muted);
    font-size: 12px;
  }

  .design-trends__head .lead {
    max-width: 680px;
    margin-top: 24px;
    color: var(--ink-soft);
    font-size: var(--fs-lead);
    font-weight: 400;
    line-height: 1.6;
  }

  /* ---------------------------------------------------------
     LAYOUT
     --------------------------------------------------------- */

  .design-trends__layout {
    display: grid;
    grid-template-columns:
      minmax(0, 1.15fr)
      minmax(320px, 0.85fr);
    align-items: center;
    gap: clamp(50px, 8vw, 120px);
  }

  /* ---------------------------------------------------------
     IMAGE
     --------------------------------------------------------- */

  .design-trends__visual {
    min-width: 0;
  }

  .design-trends__image {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 1.12 / 1;
    background: var(--surface-alt);
  }

  .design-trends__image img {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /*
   * HALFTONE
   *
   * The right 50% receives a dotted pattern.
   * The dots use currentColor so the effect stays
   * compatible with the site's visual language.
   */

  .design-trends__halftone {
    position: absolute;
    z-index: 2;
    top: 0;
    right: 0;
    bottom: 0;
    width: 50%;
    pointer-events: none;

    background-image:
      radial-gradient(
        circle,
        rgb(16 17 20 / 72%) 1.15px,
        transparent 1.25px
      );

    background-size: 7px 7px;

    mix-blend-mode: multiply;

    opacity: 0.82;

    transition:
      opacity 700ms var(--ease),
      background-size 700ms var(--ease);
  }

  /*
   * A subtle white veil gives the halftone side
   * a more editorial / printed-paper appearance.
   */

  .design-trends__halftone::after {
    content: "";
    position: absolute;
    inset: 0;

    background:
      linear-gradient(
        90deg,
        rgb(255 255 255 / 0%) 0%,
        rgb(255 255 255 / 8%) 100%
      );
  }

  /*
   * Exact vertical split between image and halftone.
   */

  .design-trends__split {
    position: absolute;
    z-index: 3;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: rgb(255 255 255 / 55%);
    transform: translateX(-0.5px);
  }

  /*
   * Small editorial marker.
   */

  .design-trends__label {
    position: absolute;
    z-index: 4;
    right: clamp(16px, 2vw, 28px);
    bottom: clamp(16px, 2vw, 28px);

    display: flex;
    align-items: center;
    justify-content: center;

    min-height: 34px;
    padding: 0 12px;

    border: 1px solid rgb(255 255 255 / 55%);

    background: rgb(255 255 255 / 72%);
    color: var(--ink);

    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    font-weight: 700;
    letter-spacing: 0.08em;

    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .design-trends__visual:hover .design-trends__halftone {
    opacity: 0.94;
    background-size: 6px 6px;
  }

  /* ---------------------------------------------------------
     CONTENT
     --------------------------------------------------------- */

  .design-trends__content {
    max-width: 520px;
  }

  .design-trends__index {
    margin: 0 0 20px;

    color: var(--red);

    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: 0.16em;
  }

  .design-trends__title {
    margin: 0;

    color: var(--ink);

    font-size: clamp(30px, 3.2vw, 48px);
    font-weight: 300;
    letter-spacing: -0.045em;
    line-height: 1.05;
    text-wrap: balance;
  }

  .design-trends__description {
    max-width: 500px;
    margin-top: 24px;

    color: var(--ink-soft);

    font-size: var(--fs-body);
    line-height: 1.7;
  }

  /* ---------------------------------------------------------
     POINTS
     --------------------------------------------------------- */

  .design-trends__points {
    display: flex;
    flex-direction: column;

    margin: 34px 0 0;
    padding: 0;

    list-style: none;
  }

  .design-trends__point {
    border-top: 1px solid var(--line);
  }

  .design-trends__point:last-child {
    border-bottom: 1px solid var(--line);
  }

  .design-trends__point {
    display: flex;
    align-items: flex-start;
    gap: 12px;

    padding: 14px 0;

    color: var(--ink-soft);

    font-size: var(--fs-small);
    line-height: 1.55;

    transition:
      color 400ms var(--ease),
      transform 500ms var(--ease);
  }

  .design-trends__point-arrow {
    flex: 0 0 auto;

    color: var(--red);

    font-size: 14px;
    line-height: 1.45;

    transition: transform 500ms var(--ease);
  }

  .design-trends__point-text {
    transition: transform 500ms var(--ease);
  }

  .design-trends__point:hover {
    color: var(--ink);
    transform: translateX(-5px);
  }

  .design-trends__point:hover .design-trends__point-arrow {
    transform: translateX(-4px);
  }

  .design-trends__point:hover .design-trends__point-text {
    transform: translateX(-2px);
  }

  /* ---------------------------------------------------------
     LINK
     --------------------------------------------------------- */

  .design-trends__link {
    display: inline-flex;
    align-items: center;
    gap: 12px;

    margin-top: 32px;

    color: var(--ink);

    font-size: var(--fs-small);
    font-weight: 700;
    text-decoration: none;

    transition: color 300ms var(--ease);
  }

  .design-trends__link-arrow {
    display: inline-block;

    color: var(--red);

    transition: transform 400ms var(--ease);
  }

  .design-trends__link:hover .design-trends__link-arrow {
    transform: translateX(7px);
  }

  /* ---------------------------------------------------------
     TABLET
     --------------------------------------------------------- */

  @media (max-width: 900px) {
    .design-trends__layout {
      grid-template-columns: 1fr;
      gap: 42px;
    }

    .design-trends__content {
      max-width: 680px;
    }

    .design-trends__image {
      aspect-ratio: 1.3 / 1;
    }
  }

  /* ---------------------------------------------------------
     MOBILE
     --------------------------------------------------------- */

  @media (max-width: 767px) {
    .design-trends__head {
      margin-bottom: 42px;
    }

    .design-trends__head h2 {
      font-size: clamp(36px, 11vw, 52px);
    }

    .design-trends__head .lead {
      margin-top: 20px;
    }

    .design-trends__layout {
      gap: 32px;
    }

    .design-trends__image {
      aspect-ratio: 1 / 1;
    }

    .design-trends__halftone {
      background-size: 6px 6px;
    }

    .design-trends__label {
      right: 14px;
      bottom: 14px;
      min-height: 32px;
      padding-inline: 10px;
    }

    .design-trends__title {
      font-size: clamp(30px, 9vw, 42px);
    }

    .design-trends__description {
      margin-top: 18px;
    }

    .design-trends__points {
      margin-top: 28px;
    }

    .design-trends__point {
      padding: 12px 0;
    }

    .design-trends__link {
      margin-top: 28px;
    }
  }

  /* ---------------------------------------------------------
     REDUCED MOTION
     --------------------------------------------------------- */

  @media (prefers-reduced-motion: reduce) {
    .design-trends__halftone,
    .design-trends__point,
    .design-trends__point-arrow,
    .design-trends__point-text,
    .design-trends__link-arrow {
      transition: none;
    }

    .design-trends__visual:hover .design-trends__halftone {
      opacity: 0.82;
      background-size: 7px 7px;
    }

    .design-trends__point:hover {
      transform: none;
    }

    .design-trends__point:hover .design-trends__point-arrow,
    .design-trends__point:hover .design-trends__point-text,
    .design-trends__link:hover .design-trends__link-arrow {
      transform: none;
    }
  }
</style>