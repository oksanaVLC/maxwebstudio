---
import {
  faMobileScreenButton,
  faUniversalAccess,
  faMagnifyingGlassChart,
} from "@fortawesome/free-solid-svg-icons";

import {
  siAngular,
  siAstro,
  siTypescript,
  siNodedotjs,
  siCss,
  siHtml5,
  type SimpleIcon,
} from "simple-icons";

type SimpleTechnology = {
  name: string;
  type: "simple";
  icon: SimpleIcon;
};

type FontAwesomeTechnology = {
  name: string;
  type: "fontawesome";
  icon: typeof faMobileScreenButton;
};

type Technology =
  | SimpleTechnology
  | FontAwesomeTechnology;

const technologies: Technology[] = [
  {
    name: "Angular",
    icon: siAngular,
    type: "simple",
  },
  {
    name: "Astro",
    icon: siAstro,
    type: "simple",
  },
  {
    name: "TypeScript",
    icon: siTypescript,
    type: "simple",
  },
  {
    name: "Node.js",
    icon: siNodedotjs,
    type: "simple",
  },
  {
    name: "CSS",
    icon: siCss,
    type: "simple",
  },
  {
    name: "HTML",
    icon: siHtml5,
    type: "simple",
  },
  {
    name: "Responsive Design",
    icon: faMobileScreenButton,
    type: "fontawesome",
  },
  {
    name: "Accesibilidad",
    icon: faUniversalAccess,
    type: "fontawesome",
  },
  {
    name: "SEO técnico",
    icon: faMagnifyingGlassChart,
    type: "fontawesome",
  },
];
---

<section
  class="tech-ticker"
  aria-labelledby="tech-title"
>
  <h2 id="tech-title" class="sr-only">
    Tecnologías y especialidades
  </h2>

  <div class="tech-ticker__viewport">
    <div class="tech-ticker__track">
      <div class="tech-ticker__group">
        {
          technologies.map((tech) => (
            <div
              class="tech-ticker__item"
              data-tech={tech.name}
            >
              <span
                class="tech-ticker__logo"
                aria-hidden="true"
              >
                {tech.type === "simple" ? (
                  <svg
                    viewBox="0 0 24 24"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path d={tech.icon.path} />
                  </svg>
                ) : (
                  <svg
                    viewBox={`0 0 ${tech.icon.icon[0]} ${tech.icon.icon[1]}`}
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    {
                      Array.isArray(
                        tech.icon.icon[4],
                      ) ? (
                        tech.icon.icon[4].map(
                          (pathData) => (
                            <path d={pathData} />
                          ),
                        )
                      ) : (
                        <path
                          d={tech.icon.icon[4]}
                        />
                      )
                    }
                  </svg>
                )}
              </span>

              <span class="tech-ticker__name">
                {tech.name}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const ticker =
    document.querySelector<HTMLElement>(
      ".tech-ticker",
    );

  const viewport =
    ticker?.querySelector<HTMLElement>(
      ".tech-ticker__viewport",
    );

  const track =
    ticker?.querySelector<HTMLElement>(
      ".tech-ticker__track",
    );

  const baseGroup =
    ticker?.querySelector<HTMLElement>(
      ".tech-ticker__group",
    );

  if (
    ticker &&
    viewport &&
    track &&
    baseGroup
  ) {
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );

    let position = 0;
    let lastTime = performance.now();

    let paused = false;
    let dragging = false;

    let dragStartX = 0;
    let dragStartPos = 0;

    let ready = false;

    const speed = 35;

    const groupWidth = () =>
      baseGroup.offsetWidth;

    const active = () =>
      !reduceMotion.matches;

    const fillViewport = () => {
      const width = groupWidth();

      if (width <= 0) {
        return false;
      }

      const needed =
        viewport.clientWidth + width;

      let guard = 0;

      while (
        track.scrollWidth < needed &&
        guard < 50
      ) {
        const clone =
          baseGroup.cloneNode(
            true,
          ) as HTMLElement;

        clone.setAttribute(
          "aria-hidden",
          "true",
        );

        track.appendChild(clone);

        guard++;
      }

      return true;
    };

    const wrap = () => {
      const width = groupWidth();

      if (width <= 0) {
        return;
      }

      position =
        ((position % width) + width) %
        width;
    };

    const render = () => {
      track.style.transform =
        `translate3d(${-position}px, 0, 0)`;
    };

    const start = () => {
      if (ready) {
        return;
      }

      if (!fillViewport()) {
        return;
      }

      ready = true;
      wrap();
      render();
      lastTime = performance.now();
    };

    const tick = (time: number) => {
      const delta =
        (time - lastTime) / 1000;

      lastTime = time;

      if (
        ready &&
        active() &&
        !paused &&
        !dragging
      ) {
        position += speed * delta;

        wrap();
        render();
      }

      requestAnimationFrame(tick);
    };

    const resizeObserver =
      new ResizeObserver(() => {
        if (!ready) {
          start();
          return;
        }

        fillViewport();
        wrap();
        render();
      });

    resizeObserver.observe(baseGroup);
    resizeObserver.observe(viewport);

    start();

    document.fonts?.ready.then(() => {
      if (!ready) {
        start();
        return;
      }

      fillViewport();
      wrap();
      render();
    });

    ticker.addEventListener(
      "mouseenter",
      () => {
        paused = true;
      },
    );

    ticker.addEventListener(
      "mouseleave",
      () => {
        paused = false;
        lastTime = performance.now();
      },
    );

    viewport.addEventListener(
      "wheel",
      (event) => {
        if (!ready || !active()) {
          return;
        }

        if (
          Math.abs(event.deltaX) <=
          Math.abs(event.deltaY)
        ) {
          return;
        }

        event.preventDefault();

        position += event.deltaX;

        wrap();
        render();
      },
      {
        passive: false,
      },
    );

    const startDrag = (x: number) => {
      dragging = true;
      dragStartX = x;
      dragStartPos = position;
    };

    const moveDrag = (x: number) => {
      if (!dragging) {
        return;
      }

      position =
        dragStartPos -
        (x - dragStartX);

      wrap();
      render();
    };

    const endDrag = () => {
      if (!dragging) {
        return;
      }

      dragging = false;
      lastTime = performance.now();
    };

    viewport.addEventListener(
      "mousedown",
      (event) => {
        if (!ready || !active()) {
          return;
        }

        event.preventDefault();

        viewport.style.cursor =
          "grabbing";

        startDrag(event.clientX);
      },
    );

    window.addEventListener(
      "mousemove",
      (event) => {
        moveDrag(event.clientX);
      },
    );

    window.addEventListener(
      "mouseup",
      () => {
        viewport.style.cursor = "";
        endDrag();
      },
    );

    viewport.addEventListener(
      "touchstart",
      (event) => {
        paused = true;

        if (ready && active()) {
          startDrag(
            event.touches[0].clientX,
          );
        }
      },
      {
        passive: true,
      },
    );

    viewport.addEventListener(
      "touchmove",
      (event) => {
        moveDrag(
          event.touches[0].clientX,
        );
      },
      {
        passive: true,
      },
    );

    viewport.addEventListener(
      "touchend",
      () => {
        paused = false;
        endDrag();
      },
      {
        passive: true,
      },
    );

    requestAnimationFrame(tick);
  }
</script>

<style>
  .tech-ticker {
    position: relative;
    width: 100%;
    overflow: clip;

    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);

    background: var(--surface);
  }

  .tech-ticker__viewport {
    width: 100%;
    max-width: 100%;

    overflow: clip;

    touch-action: pan-y;
    cursor: grab;
  }

  .tech-ticker__track {
    display: flex;
    width: max-content;
    max-width: none;
    align-items: center;

    will-change: transform;
  }

  .tech-ticker__group {
    display: flex;
    width: max-content;
    flex: 0 0 auto;
    align-items: center;
  }

  .tech-ticker__item {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 12px;

    min-height: 104px;
    padding-inline: 32px;

    color: var(--muted-soft);
    white-space: nowrap;

    transition: color 250ms ease;
  }

  .tech-ticker__logo {
    display: inline-flex;

    flex: 0 0 27px;

    width: 27px;
    height: 27px;

    align-items: center;
    justify-content: center;
  }

  .tech-ticker__logo svg {
    display: block;

    width: 100%;
    height: 100%;

    fill: currentColor;

    opacity: 0.38;

    transition:
      opacity 250ms ease,
      transform 250ms ease;
  }

  .tech-ticker__name {
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .tech-ticker__item:hover {
    color: var(--ink);
  }

  .tech-ticker__item:hover
    .tech-ticker__logo
    svg {
    opacity: 1;
    transform: scale(1.08);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;

    overflow: hidden;

    clip: rect(0, 0, 0, 0);

    white-space: nowrap;

    border: 0;
  }

  @media (max-width: 767px) {
    .tech-ticker__item {
      min-height: 88px;
      padding-inline: 22px;
    }

    .tech-ticker__item:hover {
      color: var(--muted-soft);
    }

    .tech-ticker__item:hover
      .tech-ticker__logo
      svg {
      opacity: 0.38;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tech-ticker__track {
      transform: none !important;
    }

    .tech-ticker__viewport {
      overflow-x: auto;
      overflow-y: hidden;

      scrollbar-width: none;
      cursor: default;
    }

    .tech-ticker__viewport::-webkit-scrollbar {
      display: none;
    }

    .tech-ticker__item:hover
      .tech-ticker__logo
      svg {
      transform: none;
    }
  }
</style>