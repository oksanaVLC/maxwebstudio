---
import { icon } from "@fortawesome/fontawesome-svg-core";
import {
faCartShopping,
faCode,
faMagnifyingGlassChart,
faPalette,
} from "@fortawesome/free-solid-svg-icons";

import { getLocale, useTranslations } from "../../i18n";

const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);

const icons = {
  design: icon(faPalette).html.join(""),
  development: icon(faCode).html.join(""),
  ecommerce: icon(faCartShopping).html.join(""),
  growth: icon(faMagnifyingGlassChart).html.join(""),
};
---

<section
  class="services section"
  id="services"
  aria-labelledby="services-title"
>
  <div class="container">
    <div class="services__intro">
      <p class="services__eyebrow">
        <span aria-hidden="true">✦</span>
        {t.services.eyebrow}
      </p>

      <h2 id="services-title" data-reveal="up">
        {t.services.title}
      </h2>

      <p class="services__lead" data-reveal="text">
        {t.services.lead}
      </p>
    </div>

    <div class="services__grid">
      <article class="service-card">
        <div class="service-card__media" data-reveal="image">
          <img
            src="/images/svc-webdesign.jpg"
            alt={t.services.items.design.title}
            loading="lazy"
          />
        </div>

        <div class="service-card__content">
          <span
            class="service-card__icon"
            aria-hidden="true"
            set:html={icons.design}
          />

          <h3>{t.services.items.design.title}</h3>

          <p>{t.services.items.design.description}</p>
        </div>
      </article>

      <article class="service-card">
        <div class="service-card__media" data-reveal="image">
          <img
            src="/images/svc-appdev.jpg"
            alt={t.services.items.development.title}
            loading="lazy"
          />
        </div>

        <div class="service-card__content">
          <span
            class="service-card__icon"
            aria-hidden="true"
            set:html={icons.development}
          />

          <h3>{t.services.items.development.title}</h3>

          <p>{t.services.items.development.description}</p>
        </div>
      </article>

      <article class="service-card">
        <div class="service-card__media" data-reveal="image">
          <img
            src="/images/svc-ecommerce.jpg"
            alt={t.services.items.ecommerce.title}
            loading="lazy"
          />
        </div>

        <div class="service-card__content">
          <span
            class="service-card__icon"
            aria-hidden="true"
            set:html={icons.ecommerce}
          />

          <h3>{t.services.items.ecommerce.title}</h3>

          <p>{t.services.items.ecommerce.description}</p>
        </div>
      </article>

      <article class="service-card">
        <div class="service-card__media" data-reveal="image">
          <img
            src="/images/svc-growth.jpg"
            alt={t.services.items.growth.title}
            loading="lazy"
          />
        </div>

        <div class="service-card__content">
          <span
            class="service-card__icon"
            aria-hidden="true"
            set:html={icons.growth}
          />

          <h3>{t.services.items.growth.title}</h3>

          <p>{t.services.items.growth.description}</p>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .services {
    background: var(--surface-soft);
  }

  .services__intro {
    max-width: 850px;
    margin-bottom: 56px;
  }

  .services__eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
    color: var(--muted);
    font-size: var(--fs-small);
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .services__eyebrow span {
    color: var(--muted);
    font-size: 12px;
  }

  .services h2 {
    max-width: 800px;
    margin: 0;
    color: var(--ink);
    font-size: clamp(38px, 5vw, 64px);
    font-weight: 300;
    letter-spacing: -0.055em;
    line-height: 1;
    text-wrap: balance;
  }

  .services__lead {
    max-width: 680px;
    margin-top: 24px;
    color: var(--ink-soft);
    font-size: var(--fs-lead);
    line-height: 1.6;
    transition-delay: 120ms;
  }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 42px 28px;
  }

  .service-card {
    min-width: 0;
    background: var(--surface);
  }

  .service-card__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1.45 / 1;
    background: var(--surface-alt);
  }

  .service-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease);
    will-change: transform;
  }

  /* Hover: only the image zooms */
  .service-card:hover .service-card__media img {
    transform: scale(1.045);
  }

  .service-card__content {
    padding: clamp(20px, 2.2vw, 26px) clamp(20px, 2.4vw, 28px)
      clamp(24px, 2.6vw, 32px);
  }

  .service-card__icon {
    display: block;
    width: 18px;
    height: 18px;
    margin-bottom: 14px;
    color: var(--red);
  }

  .service-card__icon :global(svg) {
    display: block;
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  .service-card__icon :global(svg path) {
    fill: currentColor;
  }

  .service-card h3 {
    margin: 0 0 9px;
    color: var(--ink);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .service-card p {
    max-width: 500px;
    color: var(--ink-soft);
    font-size: var(--fs-body);
    line-height: 1.6;
  }

  @media (max-width: 767px) {
    .services__intro {
      margin-bottom: 42px;
    }

    .services h2 {
      font-size: clamp(36px, 11vw, 52px);
    }

    .services__grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .service-card__media img {
      transition: none;
    }

    .service-card:hover .service-card__media img {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card__media img {
      transition: none;
    }

    .service-card:hover .service-card__media img {
      transform: none;
    }
  }
</style>