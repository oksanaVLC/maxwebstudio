---
import halftoneWaves from "../../assets/images/halftone-ondas.svg";
import { getLocale, useTranslations } from "../../i18n";

const lang = getLocale(Astro.currentLocale);
const c = useTranslations(lang).designStatement;
---

<section class="design-statement" aria-label={c.ariaLabel}>
  <div class="design-statement__background" aria-hidden="true">
    <img
      src={halftoneWaves.src}
      alt=""
      width="1600"
      height="1000"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="container design-statement__inner">
    <div class="design-statement__words">
      <span class="design-statement__word" data-reveal="up">
        {c.words[0]}
      </span>

      <span class="design-statement__word" data-reveal="up">
        {c.words[1]}
      </span>

      <span class="design-statement__word" data-reveal="up">
        {c.words[2]}
      </span>
    </div>
  </div>
</section>
<style>
  .design-statement {
    position: relative;
    isolation: isolate;
    overflow: hidden;

    display: flex;
    align-items: center;

    min-height: clamp(280px, 30vw, 400px);

    background: var(--surface);
  }

  /* =========================================================
     BACKGROUND
     ========================================================= */

  .design-statement__background {
    position: absolute;
    inset: 0;
    z-index: -1;

    pointer-events: none;

    opacity: 0.14;
  }

  .design-statement__background img {
    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;

    opacity: 0.9;
  }

  /* =========================================================
     CONTENT
     ========================================================= */

  .design-statement__inner {
    position: relative;
    z-index: 1;

    width: 100%;
  }

  .design-statement__words {
    display: flex;
    align-items: center;
    justify-content: space-between;

    width: 100%;

    /*
      The gap is deliberately smaller than the old version.
      The words themselves remain flexible, while the layout
      changes to a wrapped composition before they can collide.
    */
    gap: clamp(20px, 4vw, 64px);
  }

  .design-statement__word {
    /*
      Prevent flexbox from creating a smaller-than-content
      flex item that can visually collide with its neighbour.
    */
    flex: 0 1 auto;
    min-width: 0;

    color: var(--ink);

    font-family: var(--font-sans);
    font-size: clamp(38px, 5vw, 72px);
    font-weight: 300;
    line-height: 1;

    /*
      Keep the display typography tight, but not so tight that
      glyphs visually collide.
    */
    letter-spacing: -0.045em;

    white-space: nowrap;
  }

  /* =========================================================
     TABLET
     ========================================================= */

  @media (max-width: 1100px) {
    .design-statement__words {
      justify-content: center;
      flex-wrap: wrap;

      column-gap: clamp(18px, 3vw, 32px);
      row-gap: 8px;
    }

    .design-statement__word {
      font-size: clamp(36px, 5.5vw, 60px);
      white-space: nowrap;
    }
  }

  /* =========================================================
     MOBILE
     ========================================================= */

  @media (max-width: 767px) {
    .design-statement {
      min-height: 300px;
    }

    .design-statement__background {
      opacity: 0.1;
    }

    .design-statement__words {
      flex-direction: column;
      align-items: center;
      justify-content: center;

      gap: 4px;
    }

    .design-statement__word {
      max-width: 100%;

      font-size: clamp(38px, 11vw, 58px);
      line-height: 1;

      white-space: normal;
      text-align: center;
    }
  }

  /* =========================================================
     REDUCED MOTION
     ========================================================= */

  @media (prefers-reduced-motion: reduce) {
    .design-statement__word {
      transform: none;
    }
  }
</style>
