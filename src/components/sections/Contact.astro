---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLocale, useTranslations } from "../../i18n";
import { contactEmail, contactPhone } from "../../data/site";
import Button from "../shared/Button.astro";

const lang = getLocale(Astro.currentLocale);
const c = useTranslations(lang).contact;
const privacyUrl = getRelativeLocaleUrl(lang, "privacy");
---

<section id="contact" class="section section--alt">
  <div class="container">
    <div class="contact__intro">
      <h2>{c.title}</h2>
    </div>

    <div class="contact">
      <div class="contact__info">
        <p class="contact__lead">{c.lead}</p>

        <ul class="contact__list">
          <li>
            <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
          </li>

          <li>
            <a href={`tel:${contactPhone.replace(/\s/g, "")}`}>
              {contactPhone}
            </a>
          </li>

          <li>{c.place}</li>
        </ul>
      </div>

      <form
        class="contact__form"
        name="contact"
        method="POST"
        data-netlify="true"
        data-netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value="contact" />

        <p class="hp">
          <label>
            Don't fill this out:
            <input name="bot-field" />
          </label>
        </p>

        <label class="field">
          <span>{c.form.name}</span>
          <input type="text" name="name" required autocomplete="name" />
        </label>

        <label class="field">
          <span>{c.form.email}</span>
          <input
            type="email"
            name="email"
            required
            autocomplete="email"
          />
        </label>

        <label class="field">
          <span>{c.form.message}</span>
          <textarea name="message" rows="5" required></textarea>
        </label>

        <label class="consent">
          <input type="checkbox" name="consent" required />

          <span>
            {c.form.consent}
            {" "}
            <a href={privacyUrl}>{c.form.privacyLink}</a>.
          </span>
        </label>

        <button type="submit" class="btn btn--primary">
          <span>{c.form.submit}</span>
        </button>

        <p
          class="form-status"
          role="status"
          hidden
          data-sent={c.form.sent}
        ></p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>(".contact__form");

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const status =
        form.querySelector<HTMLParagraphElement>(".form-status");

      const params = new URLSearchParams();

      new FormData(form).forEach((value, key) => {
        params.append(key, value.toString());
      });

      try {
        await fetch(location.pathname, {
          method: "POST",
          headers: {
            "Content-Type": "application/x-www-form-urlencoded",
          },
          body: params.toString(),
        });

        form.reset();

        if (status) {
          status.textContent = status.dataset.sent ?? "";
          status.hidden = false;
        }
      } catch {
        form.submit();
      }
    });
  }
</script>

<style>
  .contact__intro {
    max-width: 850px;
    margin-bottom: 56px;
  }

  .contact__intro h2 {
    max-width: 800px;
    margin: 0;
    color: var(--ink);
    font-size: clamp(38px, 5vw, 64px);
    font-weight: 300;
    letter-spacing: -0.055em;
    line-height: 1;
    text-wrap: balance;
  }

  .contact {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }

  .contact__info {
    min-width: 0;
  }

  .contact__lead {
    max-width: 42ch;
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--fs-lead);
    line-height: 1.6;
  }

  .contact__list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
    color: var(--ink);
    font-size: var(--fs-body);
    line-height: 1.6;
  }

  .contact__list a {
    color: inherit;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .contact__list a:hover {
    color: var(--red);
  }

  .contact__form {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .field span {
    color: var(--ink);
    font-size: var(--fs-small);
    font-weight: 600;
    line-height: 1.4;
  }

  .field input,
  .field textarea {
    width: 100%;
    box-sizing: border-box;
    margin: 0;
    padding: 13px 15px;
    border: 1px solid var(--line-input);
    border-radius: 0;
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-size: var(--fs-body);
    line-height: 1.6;
  }

  .field input {
    min-height: 48px;
  }

  .field textarea {
    min-height: 140px;
    resize: vertical;
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--muted-soft);
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--ink);
    box-shadow: 0 0 0 1px var(--ink);
  }

  .consent {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: var(--muted);
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  .consent input {
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
    margin: 2px 0 0;
  }

  .consent a {
    color: var(--red);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .consent a:hover {
    color: var(--red-hover);
  }

  .form-status {
    margin: 0;
    color: var(--ink);
    font-size: var(--fs-small);
    font-weight: 600;
    line-height: 1.5;
  }

  .hp {
    position: absolute;
    left: -9999px;
  }

  @media (max-width: 767px) {
    .contact__intro {
      margin-bottom: 42px;
    }

    .contact__intro h2 {
      font-size: clamp(36px, 11vw, 52px);
    }

    .contact {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .contact__lead {
      max-width: 38ch;
    }

    .field textarea {
      min-height: 120px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact__list a {
      transition: none;
    }
  }
</style>