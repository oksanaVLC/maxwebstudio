---
import { getLocale, useTranslations } from '../../i18n';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { contactEmail, contactPhone } from '../../data/site';
import Button from '../shared/Button.astro';

const lang = getLocale(Astro.currentLocale);
const c = useTranslations(lang).contact;
const privacyUrl = getRelativeLocaleUrl(lang, 'privacy');
---

<section id="contact" class="section section--alt">
  <div class="container">

    <div class="section-head">
      <h2 class="h2">{c.title}</h2>
    </div>

    <div class="contact">
      <div class="contact__info">
        <p class="contact__lead">{c.lead}</p>
        <ul class="contact__list">
          <li><a href={`mailto:${contactEmail}`}>{contactEmail}</a></li>
          <li><a href={`tel:${contactPhone.replace(/\s/g, '')}`}>{contactPhone}</a></li>
          <li>{c.place}</li>
        </ul>
      </div>

      <form
        class="contact__form"
        name="contact"
        method="POST"
        data-netlify="true"
        data-netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hp"><label>Don't fill this out: <input name="bot-field" /></label></p>

        <label class="field">
          <span>{c.form.name}</span>
          <input type="text" name="name" required autocomplete="name" />
        </label>
        <label class="field">
          <span>{c.form.email}</span>
          <input type="email" name="email" required autocomplete="email" />
        </label>
        <label class="field">
          <span>{c.form.message}</span>
          <textarea name="message" rows="5" required></textarea>
        </label>

        <label class="consent">
          <input type="checkbox" name="consent" required />
          <span>{c.form.consent} <a href={privacyUrl}>{c.form.privacyLink}</a>.</span>
        </label>

       <button type="submit" class="btn btn--primary">
  <span>{c.form.submit}</span>
</button>
        <p class="form-status" role="status" hidden data-sent={c.form.sent}></p>
      </form>
    </div>

  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('.contact__form');
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = form.querySelector<HTMLParagraphElement>('.form-status');
      const params = new URLSearchParams();
      new FormData(form).forEach((value, key) =>
        params.append(key, value.toString())
      );
      try {
        await fetch(location.pathname, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: params.toString(),
        });
        form.reset();
        if (status) {
          status.textContent = status.dataset.sent ?? '';
          status.hidden = false;
        }
      } catch {
        form.submit(); // fall back to a normal Netlify submission
      }
    });
  }
</script>

<style>
  .contact {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 3rem;
    align-items: start;
  }

  .contact__lead {
    max-width: 40ch;
    color: var(--muted);
  }

  .contact__list {
    list-style: none;
    padding: 0;
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .contact__list a:hover {
    color: var(--red);
  }

  .contact__form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .field span {
    font-size: var(--fs-small);
    font-weight: 600;
  }

  .field input,
  .field textarea {
    font: inherit;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--line-input);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
  }

  .field input:focus,
  .field textarea:focus {
    outline: 2px solid var(--red);
    outline-offset: 1px;
    border-color: transparent;
  }

  .consent {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    font-size: var(--fs-small);
    color: var(--muted);
  }

  .consent a {
    color: var(--red);
    text-decoration: underline;
  }

  .consent input {
    margin-top: 0.2rem;
    flex-shrink: 0;
  }

  .form-status {
    color: var(--ink);
    font-weight: 600;
  }

  .hp {
    position: absolute;
    left: -9999px;
  }

  @media (max-width: 767px) {
    .contact {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>