---
import { getRelativeLocaleUrl } from "astro:i18n";
import {
  faCircleCheck,
  faCircleExclamation,
  faEnvelope,
  faLocationDot,
  faPaperPlane,
  faPhone,
  type IconDefinition,
} from "@fortawesome/free-solid-svg-icons";

import { getLocale, useTranslations } from "../../i18n";
import { contactEmail, contactPhone } from "../../data/site";

const lang = getLocale(Astro.currentLocale);
const c = useTranslations(lang).contact;
const privacyUrl = getRelativeLocaleUrl(lang, "privacy");

/* Font Awesome → inline SVG at build time (no CSS, no JS, no web font) */
const fa = (i: IconDefinition, cls = "fa") => {
  const [w, h, , , path] = i.icon;
  const d = Array.isArray(path) ? path.join(" ") : path;
  return `<svg class="${cls}" viewBox="0 0 ${w} ${h}" aria-hidden="true" focusable="false"><path fill="currentColor" d="${d}"/></svg>`;
};

/* Labels + validation messages (move to i18n whenever you like) */
const UI = {
  es: {
    email: "Email",
    phone: "Teléfono",
    place: "Ubicación",
    required: "obligatorio",
    sending: "Enviando…",
    msg: {
      nameRequired: "Escribe tu nombre.",
      nameShort: "El nombre debe tener al menos 2 caracteres.",
      emailRequired: "Escribe tu email.",
      emailInvalid: "Escribe un email válido, por ejemplo nombre@dominio.com.",
      messageRequired: "Cuéntanos brevemente qué necesitas.",
      messageShort: "El mensaje debe tener al menos 10 caracteres.",
      consentRequired: "Debes aceptar la política de privacidad para enviar el formulario.",
      summary: "Revisa los campos marcados en rojo.",
      error: "No se ha podido enviar el mensaje. Inténtalo de nuevo o escríbenos a",
    },
  },
  en: {
    email: "Email",
    phone: "Phone",
    place: "Location",
    required: "required",
    sending: "Sending…",
    msg: {
      nameRequired: "Please enter your name.",
      nameShort: "Your name must be at least 2 characters long.",
      emailRequired: "Please enter your email.",
      emailInvalid: "Enter a valid email, for example name@domain.com.",
      messageRequired: "Tell us briefly what you need.",
      messageShort: "Your message must be at least 10 characters long.",
      consentRequired: "You must accept the privacy policy to send the form.",
      summary: "Please check the fields marked in red.",
      error: "Your message could not be sent. Please try again or email us at",
    },
  },
  ru: {
    email: "Email",
    phone: "Телефон",
    place: "Местоположение",
    required: "обязательно",
    sending: "Отправка…",
    msg: {
      nameRequired: "Укажите ваше имя.",
      nameShort: "Имя должно содержать не менее 2 символов.",
      emailRequired: "Укажите ваш email.",
      emailInvalid: "Введите корректный email, например name@domain.com.",
      messageRequired: "Кратко опишите, что вам нужно.",
      messageShort: "Сообщение должно содержать не менее 10 символов.",
      consentRequired: "Чтобы отправить форму, примите политику конфиденциальности.",
      summary: "Проверьте поля, отмеченные красным.",
      error: "Не удалось отправить сообщение. Попробуйте ещё раз или напишите нам на",
    },
  },
};

const ui = UI[lang as keyof typeof UI] ?? UI.es;
const MESSAGE_MAX = 2000;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(c.place)}`;
const errorIcon = fa(faCircleExclamation);
---

<section id="contact" class="section section--alt" aria-labelledby="contact-title">
  <div class="container">
    <div class="contact__intro" data-reveal="up">
      <h2 id="contact-title">{c.title}</h2>
    </div>

    <div class="contact">
      <!-- ==================================================
           INFO
           ================================================== -->
      <div class="contact__info">
        <p class="contact__lead" data-reveal="text">{c.lead}</p>

        <ul class="contact__list" data-stagger>
          <li data-reveal="up">
            <a class="contact__item" href={`mailto:${contactEmail}`}>
              <span class="contact__icon" set:html={fa(faEnvelope)} />
              <span class="contact__text">
                <span class="contact__label">{ui.email}</span>
                <span class="contact__value">{contactEmail}</span>
              </span>
            </a>
          </li>

          <li data-reveal="up">
            <a class="contact__item" href={`tel:${contactPhone.replace(/\s/g, "")}`}>
              <span class="contact__icon" set:html={fa(faPhone)} />
              <span class="contact__text">
                <span class="contact__label">{ui.phone}</span>
                <span class="contact__value">{contactPhone}</span>
              </span>
            </a>
          </li>

          <li data-reveal="up">
            <a class="contact__item" href={mapsUrl} target="_blank" rel="noopener noreferrer">
              <span class="contact__icon" set:html={fa(faLocationDot)} />
              <span class="contact__text">
                <span class="contact__label">{ui.place}</span>
                <span class="contact__value">{c.place}</span>
              </span>
            </a>
          </li>
        </ul>
      </div>

      <!-- ==================================================
           FORM — Netlify Forms (+ Resend via submission-created)
           ================================================== -->
      <form
        class="contact__form"
        name="contact"
        method="POST"
        data-netlify="true"
        data-netlify-honeypot="bot-field"
        data-contact-form
        data-messages={JSON.stringify(ui.msg)}
        data-sending={ui.sending}
        data-email={contactEmail}
        data-reveal="up"
      >
        <input type="hidden" name="form-name" value="contact" />
        <input type="hidden" name="lang" value={lang} />

        <!-- Honeypot: invisible for people, irresistible for bots -->
        <p class="hp" aria-hidden="true">
          <label>
            Don’t fill this out:
            <input name="bot-field" tabindex="-1" autocomplete="off" />
          </label>
        </p>

        <div class="contact__row">
          <div class="field" data-field="name">
            <label class="field__label" for="contact-name">
              {c.form.name}
              <span class="field__req" aria-hidden="true">*</span>
            </label>
            <div class="field__control">
              <input
                id="contact-name"
                type="text"
                name="name"
                required
                minlength="2"
                maxlength="80"
                autocomplete="name"
                aria-describedby="contact-name-error"
              />
              <span class="field__state" set:html={errorIcon} />
            </div>
            <p class="field__error" id="contact-name-error" hidden>
              <span data-error-text></span>
            </p>
          </div>

          <div class="field" data-field="email">
            <label class="field__label" for="contact-email">
              {c.form.email}
              <span class="field__req" aria-hidden="true">*</span>
            </label>
            <div class="field__control">
              <input
                id="contact-email"
                type="email"
                name="email"
                required
                maxlength="120"
                autocomplete="email"
                inputmode="email"
                spellcheck="false"
                aria-describedby="contact-email-error"
              />
              <span class="field__state" set:html={errorIcon} />
            </div>
            <p class="field__error" id="contact-email-error" hidden>
              <span data-error-text></span>
            </p>
          </div>
        </div>

        <div class="field" data-field="message">
          <label class="field__label" for="contact-message">
            {c.form.message}
            <span class="field__req" aria-hidden="true">*</span>
          </label>
          <div class="field__control">
            <textarea
              id="contact-message"
              name="message"
              rows="6"
              required
              minlength="10"
              maxlength={MESSAGE_MAX}
              aria-describedby="contact-message-error contact-message-count"
            ></textarea>
            <span class="field__state" set:html={errorIcon} />
          </div>
          <div class="field__meta">
            <p class="field__error" id="contact-message-error" hidden>
              <span data-error-text></span>
            </p>
            <span class="field__count" id="contact-message-count" data-count aria-live="off">
              0 / {MESSAGE_MAX}
            </span>
          </div>
        </div>

        <div class="field field--consent" data-field="consent">
          <label class="consent">
            <input
              type="checkbox"
              name="consent"
              value="yes"
              required
              aria-describedby="contact-consent-error"
            />
            <span class="consent__box" aria-hidden="true">
              <svg viewBox="0 0 16 16"><path d="M3.5 8.5 6.5 11.5 12.5 4.5" /></svg>
            </span>
            <span class="consent__text">
              {c.form.consent}{" "}
              <a href={privacyUrl}>{c.form.privacyLink}</a>.
            </span>
          </label>
          <p class="field__error" id="contact-consent-error" hidden>
            <span data-error-text></span>
          </p>
        </div>

        <button class="contact__submit" type="submit">
          <span class="contact__submit-spinner" aria-hidden="true"></span>
          <span class="contact__submit-icon" set:html={fa(faPaperPlane)} />
          <span class="contact__submit-label" data-label>{c.form.submit}</span>
        </button>

        <p class="contact__required">
          <span aria-hidden="true">*</span>
          {ui.required}
        </p>

        <!-- Result messages -->
        <div class="form-alert form-alert--success" role="status" data-success hidden>
          <Fragment set:html={fa(faCircleCheck)} />
          <p>{c.form.sent}</p>
        </div>

        <div class="form-alert form-alert--error" role="alert" data-alert hidden>
          <Fragment set:html={errorIcon} />
          <p data-alert-text></p>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  type Rule = (el: HTMLInputElement | HTMLTextAreaElement) => string | null;
  type Messages = Record<string, string>;

  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  function setup(form: HTMLFormElement) {
    if (form.dataset.ready) return;
    form.dataset.ready = "1";

    // JS takes over validation; without JS the browser's native checks still work
    form.noValidate = true;

    const M: Messages = JSON.parse(form.dataset.messages || "{}");
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const label = submit.querySelector<HTMLElement>("[data-label]")!;
    const labelText = label.textContent || "";
    const success = form.querySelector<HTMLElement>("[data-success]")!;
    const alert = form.querySelector<HTMLElement>("[data-alert]")!;
    const alertText = form.querySelector<HTMLElement>("[data-alert-text]")!;
    const counter = form.querySelector<HTMLElement>("[data-count]");
    const message = form.elements.namedItem("message") as HTMLTextAreaElement;

    const rules: Record<string, Rule> = {
      name: (el) => {
        const v = el.value.trim();
        if (!v) return M.nameRequired;
        if (v.length < 2) return M.nameShort;
        return null;
      },
      email: (el) => {
        const v = el.value.trim();
        if (!v) return M.emailRequired;
        if (!EMAIL_RE.test(v)) return M.emailInvalid;
        return null;
      },
      message: (el) => {
        const v = el.value.trim();
        if (!v) return M.messageRequired;
        if (v.length < 10) return M.messageShort;
        return null;
      },
      consent: (el) => ((el as HTMLInputElement).checked ? null : M.consentRequired),
    };

    const fields = Array.from(form.querySelectorAll<HTMLElement>("[data-field]"));

    const control = (field: HTMLElement) =>
      field.querySelector<HTMLInputElement | HTMLTextAreaElement>("input, textarea")!;

    const showError = (field: HTMLElement, text: string | null) => {
      const el = control(field);
      const box = field.querySelector<HTMLElement>(".field__error")!;
      const out = box.querySelector<HTMLElement>("[data-error-text]")!;

      field.classList.toggle("is-invalid", !!text);
      field.classList.toggle("is-valid", !text && el.type !== "checkbox" && !!el.value.trim());

      if (text) {
        el.setAttribute("aria-invalid", "true");
        out.textContent = text;
        box.hidden = false;
      } else {
        el.removeAttribute("aria-invalid");
        out.textContent = "";
        box.hidden = true;
      }
    };

    const validate = (field: HTMLElement) => {
      const rule = rules[field.dataset.field || ""];
      const error = rule ? rule(control(field)) : null;
      showError(field, error);
      return !error;
    };

    /* "Reward early, punish late": check on blur, re-check live once invalid */
    fields.forEach((field) => {
      const el = control(field);

      el.addEventListener("blur", () => {
        if (el.type === "checkbox") return;
        if (el.value.trim() || field.classList.contains("is-invalid")) validate(field);
      });

      el.addEventListener(el.type === "checkbox" ? "change" : "input", () => {
        if (field.classList.contains("is-invalid") || el.type === "checkbox") validate(field);
        alert.hidden = true;
      });
    });

    /* Character counter */
    const updateCount = () => {
      if (!counter) return;
      const max = Number(message.maxLength) || 2000;
      counter.textContent = `${message.value.length} / ${max}`;
      counter.classList.toggle("is-near", message.value.length > max * 0.9);
    };
    message.addEventListener("input", updateCount);

    const setBusy = (busy: boolean) => {
      submit.disabled = busy;
      submit.setAttribute("aria-busy", String(busy));
      form.classList.toggle("is-sending", busy);
      label.textContent = busy ? form.dataset.sending || labelText : labelText;
    };

    const showAlert = (text: string, withEmail = false) => {
      alertText.textContent = text;
      if (withEmail && form.dataset.email) {
        const a = document.createElement("a");
        a.href = `mailto:${form.dataset.email}`;
        a.textContent = form.dataset.email;
        alertText.append(" ", a, ".");
      }
      alert.hidden = false;
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      success.hidden = true;
      alert.hidden = true;

      const invalid = fields.filter((f) => !validate(f));
      if (invalid.length) {
        showAlert(M.summary);
        control(invalid[0]).focus();
        return;
      }

      setBusy(true);

      try {
        const body = new URLSearchParams();
        new FormData(form).forEach((value, key) => body.append(key, String(value).trim()));

        // Netlify recommends posting to a static file for framework/SSR sites
        const res = await fetch("/__forms.html", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: body.toString(),
        });

        if (!res.ok) throw new Error(`HTTP ${res.status}`);

        form.reset();
        fields.forEach((f) => {
          showError(f, null);
          f.classList.remove("is-valid");
        });
        updateCount();
        success.hidden = false;
        success.focus?.();
      } catch {
        showAlert(M.error, true);
      } finally {
        setBusy(false);
      }
    });
  }

  const init = () =>
    document.querySelectorAll<HTMLFormElement>("[data-contact-form]").forEach(setup);

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
  document.addEventListener("astro:page-load", init);
</script>

<style>
  /* ==========================================================
     TOKENS
     ========================================================== */

  .contact {
    --error: #c4291c; /* 5.9:1 on white — readable, unlike --red for small text */
    --error-tint: #fff4f2;
    --success: #1f7a45;
    --success-tint: #f1faf4;
    --radius: 12px;
  }

  /* ==========================================================
     INTRO + LAYOUT
     ========================================================== */

  .contact__intro {
    max-width: 850px;
    margin-bottom: 56px;
  }

  .contact__intro h2 {
    max-width: 800px;
    margin: 0;
    color: var(--ink);
    font-size: clamp(38px, 5vw, 64px);
    font-weight: 300;
    letter-spacing: -0.055em;
    line-height: 1;
    text-wrap: balance;
  }

  .contact {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }

  .contact__info {
    min-width: 0;
  }

  .contact__lead {
    max-width: 42ch;
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--fs-lead);
    line-height: 1.6;
  }

  /* ==========================================================
     CONTACT LIST
     ========================================================== */

  .contact__list {
    display: grid;
    gap: 10px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }

  .contact__item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 16px;
    color: var(--ink);
    text-decoration: none;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition:
      border-color 200ms ease,
      box-shadow 200ms ease,
      transform 200ms var(--ease);
  }

  .contact__item:hover {
    border-color: var(--line-strong);
    box-shadow: 0 10px 24px -16px rgb(16 17 20 / 0.25);
    transform: translateY(-1px);
  }

  .contact__icon {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--red);
    background: var(--red-tint);
    border-radius: 10px;
    transition:
      background-color 200ms ease,
      color 200ms ease;
  }

  .contact__item:hover .contact__icon {
    color: #fff;
    background: var(--red);
  }

  .contact__icon :global(.fa) {
    width: 18px;
    height: 18px;
  }

  .contact__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .contact__label {
    color: var(--muted);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .contact__value {
    overflow-wrap: anywhere;
    font-size: var(--fs-body);
    font-weight: 500;
    line-height: 1.45;
  }

  /* ==========================================================
     FORM CARD
     ========================================================== */

  .contact__form {
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
    padding: clamp(22px, 3.2vw, 40px);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 18px;
    box-shadow: 0 24px 60px -36px rgb(16 17 20 / 0.28);
  }

  .contact__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  /* ==========================================================
     FIELDS
     ========================================================== */

  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .field__label {
    color: var(--ink);
    font-size: var(--fs-small);
    font-weight: 600;
    line-height: 1.4;
  }

  .field__req {
    margin-left: 2px;
    color: var(--error);
  }

  .field__control {
    position: relative;
  }

  .field input,
  .field textarea {
    width: 100%;
    margin: 0;
    padding: 13px 44px 13px 15px;
    color: var(--ink);
    font: inherit;
    font-size: var(--fs-body);
    line-height: 1.5;
    background: var(--surface-alt);
    border: 1px solid var(--line-input);
    border-radius: 10px;
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      background-color 180ms ease;
  }

  .field input {
    min-height: 50px;
  }

  .field textarea {
    min-height: 150px;
    resize: vertical;
  }

  .field input:hover,
  .field textarea:hover {
    border-color: var(--faint);
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    background: var(--surface);
    border-color: var(--ink);
    box-shadow: 0 0 0 3px rgb(16 17 20 / 0.08);
  }

  /* Error icon inside the input */
  .field__state {
    position: absolute;
    top: 15px;
    right: 15px;
    display: none;
    color: var(--error);
    pointer-events: none;
  }

  .field__state :global(.fa) {
    width: 18px;
    height: 18px;
  }

  /* ---------- INVALID ---------- */

  .field.is-invalid input,
  .field.is-invalid textarea {
    background: var(--error-tint);
    border-color: var(--error);
  }

  .field.is-invalid input:focus,
  .field.is-invalid textarea:focus {
    box-shadow: 0 0 0 3px rgb(196 41 28 / 0.14);
  }

  .field.is-invalid .field__state {
    display: block;
  }

  .field.is-invalid .field__label {
    color: var(--error);
  }

  /* ---------- VALID (subtle) ---------- */

  .field.is-valid input,
  .field.is-valid textarea {
    border-color: color-mix(in srgb, var(--success) 45%, var(--line-input));
  }

  /* ---------- ERROR MESSAGE ---------- */

  .field__error {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    margin: 0;
    color: var(--error);
    font-size: var(--fs-small);
    font-weight: 500;
    line-height: 1.45;
    animation: field-error-in 220ms var(--ease);
  }

  .field__error::before {
    content: "";
    flex: 0 0 auto;
    width: 4px;
    height: 4px;
    margin-top: 0.6em;
    background: currentColor;
    border-radius: 50%;
  }

  @keyframes field-error-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  .field__meta {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .field__count {
    margin-left: auto;
    color: var(--muted);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .field__count.is-near {
    color: var(--error);
  }

  /* ==========================================================
     CONSENT (custom checkbox, real input stays accessible)
     ========================================================== */

  .consent {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    color: var(--ink-soft);
    font-size: var(--fs-small);
    line-height: 1.55;
    cursor: pointer;
  }

  .consent input {
    position: absolute;
    top: 0;
    left: 0;
    width: 20px;
    height: 20px;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .consent__box {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    width: 20px;
    height: 20px;
    margin-top: 1px;
    background: var(--surface);
    border: 1.5px solid var(--faint);
    border-radius: 6px;
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      box-shadow 160ms ease;
  }

  .consent__box svg {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: #fff;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 16;
    stroke-dashoffset: 16;
    transition: stroke-dashoffset 220ms var(--ease);
  }

  .consent input:checked + .consent__box {
    background: var(--ink);
    border-color: var(--ink);
  }

  .consent input:checked + .consent__box svg {
    stroke-dashoffset: 0;
  }

  .consent input:focus-visible + .consent__box {
    box-shadow: 0 0 0 3px rgb(16 17 20 / 0.12);
