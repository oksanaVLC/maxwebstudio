---
// Sección hero con fondo de puntos halftone generados en <canvas> (no es una imagen).
// Uso: <HalftoneHero><h1>Tu título</h1></HalftoneHero>
interface Props { spacing?: number; animate?: boolean }
const { spacing = 16, animate = true } = Astro.props;
---
<section class="halftone-hero" data-spacing={spacing} data-animate={animate ? "1" : "0"}>
  <canvas class="halftone-canvas" aria-hidden="true"></canvas>
  <div class="halftone-content"><slot /></div>
</section>

<style>
  .halftone-hero { position: relative; min-height: 80vh; overflow: hidden; background: #fff; display: grid; place-items: center; }
  .halftone-canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .halftone-content { position: relative; z-index: 1; padding: 2rem 1rem; text-align: center; }
</style>

<script>
  const STOPS: [number, string][] = [
    [0, "#8ecb7c"], [0.18, "#72c9c2"], [0.38, "#58c3f0"], [0.66, "#d6d3ee"], [1, "#a9cbeb"],
  ];

  function setup(section: HTMLElement) {
    const canvas = section.querySelector("canvas") as HTMLCanvasElement;
    const ctx = canvas.getContext("2d")!;
    const S = Number(section.dataset.spacing) || 24;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const animate = section.dataset.animate === "1" && !reduce;
    let W = 0, H = 0, raf = 0, visible = true;

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = section.clientWidth; H = section.clientHeight;
      canvas.width = W * dpr; canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      draw(0);
    }

    function draw(time: number) {
      const t = time * 0.00025;           // velocidad de la onda
      const k = 1600 / Math.max(W, 1);    // mantiene la forma de la onda en cualquier ancho
      ctx.clearRect(0, 0, W, H);
      const g = ctx.createLinearGradient(0, H * 0.6, W, H * 0.3);
      STOPS.forEach(([o, c]) => g.addColorStop(o, c));
      ctx.fillStyle = g;
      ctx.beginPath();
      for (let j = -3; j < H / S + 4; j++) {
        for (let i = -3; i < W / S + 4; i++) {
          const gx = i * S + (j % 2 ? S / 2 : 0), gy = j * S;
          const X = gx * k, Y = gy * (1000 / Math.max(H, 1));
          // deformación de la cuadrícula (curvas)
          const x = gx + (22 * Math.sin(Y * 0.0045 + X * 0.002 + t)) / k;
          const y = gy + (55 * Math.sin(X * 0.0042 + 0.6 + t) + 14 * Math.sin(X * 0.011 + Y * 0.004 - t)) / k;
          // tamaño del punto (bandas diagonales)
          const u = x / W, v = y / H;
          let s = 0.5 + 0.32 * Math.sin(u * 7 - v * 2.2 + 0.6 * Math.sin(v * 5) + t)
                      + 0.18 * Math.sin(u * 3 + v * 4.5 + 1.2) + 0.18 * (1 - v);
          s = Math.max(0.3, Math.min(1, 0.3 + 0.75 * s));
          const rx = S * 0.52 * s;
          ctx.moveTo(x + rx, y);
          ctx.ellipse(x, y, rx, rx * 1.2, 0, 0, Math.PI * 2);
        }
      }
      ctx.fill();
    }

    function loop(time: number) { draw(time); if (animate && visible) raf = requestAnimationFrame(loop); }

    new ResizeObserver(resize).observe(section);
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      cancelAnimationFrame(raf);
      if (visible && animate) raf = requestAnimationFrame(loop);
    }).observe(section);
  }

  document.querySelectorAll<HTMLElement>(".halftone-hero").forEach(setup);
</script>
