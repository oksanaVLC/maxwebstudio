---
import { icon } from "@fortawesome/fontawesome-svg-core";
import {
  faBullseye,
  faChevronDown,
  faRotate,
} from "@fortawesome/free-solid-svg-icons";
import { faClock } from "@fortawesome/free-regular-svg-icons";

import { getLocale, useTranslations, type Locale } from "../../i18n";

const lang: Locale = getLocale(Astro.currentLocale);
const t = useTranslations(lang);
const d = t.pricing;

/*
 * Pricing structure belongs to the component.
 *
 * 0 = Starter
 * 1 = Business
 * 2 = Shop
 */
const featuredPack = 1;

const comparison = [
  { key: "customDesign", values: ["yes", "yes", "yes"] },
  { key: "customDevelopment", values: ["yes", "yes", "yes"] },
  { key: "responsive", values: ["yes", "yes", "yes"] },
  { key: "landing", values: ["yes", "no", "no"] },
  { key: "multiplePages", values: ["no", "yes", "yes"] },
  { key: "multilingual", values: ["no", "yes", "yes"] },
  { key: "basicSeo", values: ["yes", "yes", "yes"] },
  { key: "internationalSeo", values: ["no", "yes", "yes"] },
  { key: "advancedSeo", values: ["no", "no", "yes"] },
  { key: "cms", values: ["no", "optional", "yes"] },
  { key: "blog", values: ["no", "optional", "yes"] },
  { key: "ecommerce", values: ["no", "no", "yes"] },
  { key: "paymentsBookingsCrm", values: ["no", "no", "yes"] },
  { key: "revisions", values: ["twoRounds", "twoRounds", "twoRounds"] },
  {
    key: "timeline",
    values: ["oneTwoWeeks", "twoFourWeeks", "fromFourWeeks"],
  },
] as const;

const comparisonValue = {
  yes: "✓",
  no: "—",
  optional: d.comparison.optional,
  twoRounds: d.comparison.twoRounds,
  oneTwoWeeks: d.comparison.oneTwoWeeks,
  twoFourWeeks: d.comparison.twoFourWeeks,
  fromFourWeeks: d.comparison.fromFourWeeks,
} as const;
---

<section id="pricing" class="pricing section" aria-labelledby="pricing-title">
  <div class="container">

    <!-- HEADER -->

    <header class="pricing__head">
      <div>
        <p class="pricing__eyebrow">
          {d.eyebrow}
        </p>

        <h2 id="pricing-title" class="pricing__title">
          {d.priceTitle}
        </h2>
      </div>

      <p class="pricing__lead">
        {d.priceLead}
      </p>
    </header>


    <!-- PLANS -->

    <div class="pricing__grid">
      {d.packs.map((p, index) => (
        <article
          class="pack"
          data-pack
          data-featured={String(index === featuredPack)}
        >

          {index === featuredPack && (
            <span class="pack__flag">
              {d.mostPicked}
            </span>
          )}

          <span class="pack__num">
            {String(index + 1).padStart(2, "0")}
          </span>

          <h3 class="pack__name">
            {p.name}
          </h3>

          <p class="pack__tagline">
            {p.tagline}
          </p>


          <!-- PRICE -->

          <div class="pack__price-wrap">
            <span class="pack__price">
              {p.price}
            </span>

            <span class="pack__pricenote">
              {p.priceNote}
            </span>
          </div>


          <!-- DESCRIPTION -->

          <p class="pack__pitch">
            {p.pitch}
          </p>


          <!-- FACTS -->

          <div class="pack__facts">

            <span>
              <span
                class="pack__fact-icon"
                aria-hidden="true"
                set:html={icon(faBullseye).html.join("")}
              ></span>

              <span>{p.ideal}</span>
            </span>

            <span>
              <span
                class="pack__fact-icon"
                aria-hidden="true"
                set:html={icon(faClock).html.join("")}
              ></span>

              <span>{p.time}</span>
            </span>

            <span>
              <span
                class="pack__fact-icon"
                aria-hidden="true"
                set:html={icon(faRotate).html.join("")}
              ></span>

              <span>{p.rounds}</span>
            </span>

          </div>


          <!-- FEATURES TOGGLE -->

          <button
            type="button"
            class="pack__toggle"
            data-pack-toggle
            data-open="false"
            data-label-open={d.toggleOpen}
            data-label-closed={d.toggleClosed}
            aria-expanded="false"
          >
            <span data-pack-label>
              {d.toggleClosed}
            </span>

            <span
              class="pack__chevron"
              aria-hidden="true"
              set:html={icon(faChevronDown).html.join("")}
            ></span>
          </button>


          <!-- FEATURES -->

          <ul
            class="pack__feats"
            data-pack-feats
            hidden
          >
            {p.feats.map((feature) => (
              <li>
                <span
                  class="pack__feature-icon"
                  aria-hidden="true"
                >
                  ✓
                </span>

                <span>{feature}</span>
              </li>
            ))}
          </ul>


          <!-- NOTE -->

          <p class="pack__note">
            {p.note}
          </p>


          <!-- CTA -->

          <a
            href="#contact"
            class:list={[
              "pack__cta",
              index === featuredPack
                ? "pack__cta--primary"
                : "pack__cta--silver",
            ]}
          >
            {p.cta}
          </a>

        </article>
      ))}
    </div>


    <!-- COMPARISON -->

    <div class="comparison">
      <div class="comparison__scroll">

        <table>
          <thead>
            <tr>
              <th class="comparison__title">
                {d.cmpTitle}
              </th>

              {d.packs.map((p, index) => (
                <th
                  class:list={{
                    comparison__highlight: index === featuredPack,
                  }}
                >
                  {p.name}
                </th>
              ))}
            </tr>
          </thead>

          <tbody>

            <!-- PRICE -->

            <tr>
              <td class="comparison__label">
                {d.comparison.from}
              </td>

              {d.packs.map((p, index) => (
                <td
                  class:list={{
                    "comparison__highlight-cell":
                      index === featuredPack,
                  }}
                >
                  {p.price}
                </td>
              ))}
            </tr>


            <!-- FEATURES -->

            {comparison.map((row) => (
              <tr>
                <td class="comparison__label">
                  {d.comparison[row.key]}
                </td>

                {row.values.map((value, index) => (
                  <td
                    class:list={{
                      "comparison__highlight-cell":
                        index === featuredPack,
                    }}
                  >
                    {comparisonValue[value]}
                  </td>
                ))}
              </tr>
            ))}

          </tbody>
        </table>

      </div>
    </div>

  </div>
</section>


<style>
  /* ==============================================================
     SECTION
  ============================================================== */

  .pricing {
    background: var(--surface);
  }

  .pricing__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 390px);
    align-items: end;
    gap: 60px;
    margin-bottom: 52px;
  }

  .pricing__eyebrow {
    margin: 0 0 18px;

    color: var(--muted);

    font-size: var(--fs-small);
    font-weight: 500;
    line-height: 1.2;
  }

  .pricing__title {
    max-width: 760px;
    margin: 0;

    color: var(--ink);

    font-family: var(--font-sans);
    font-size: var(--fs-h2);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .pricing__lead {
    margin: 0;

    color: var(--ink-body);

    font-size: var(--fs-lead);
    line-height: 1.65;
  }


  /* ==============================================================
     PLANS
  ============================================================== */

  .pricing__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }


  /* ==============================================================
     CARD
  ============================================================== */

  .pack {
    position: relative;

    display: flex;
    flex-direction: column;

    min-width: 0;
    padding: 34px 28px 28px;

    border: 1px solid var(--line);
    background: var(--surface);

    transition:
      transform 220ms var(--ease),
      border-color 220ms ease,
      box-shadow 220ms ease;
  }

  .pack:hover {
    transform: translateY(-3px);
    border-color: var(--line-strong);
    box-shadow: var(--shadow-card);
  }

  .pack[data-featured="true"] {
    border-color: var(--red);
  }

  .pack[data-featured="true"]:hover {
    border-color: var(--red);
  }


  /* ==============================================================
     FEATURED LABEL
  ============================================================== */

  .pack__flag {
    position: absolute;
    top: 0;
    right: 0;

    padding: 8px 16px 8px 22px;

    background: var(--red);
    color: #fff;

    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;

    clip-path: polygon(
      14px 0,
      100% 0,
      100% 100%,
      0 100%
    );
  }


  /* ==============================================================
     NUMBER / NAME
  ============================================================== */

  .pack__num {
    display: block;

    color: var(--faint);

    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.18em;
    line-height: 1;
  }

  .pack__name {
    margin: 12px 0 8px;

    color: var(--ink);

    font-family: var(--font-sans);
    font-size: 30px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .pack__tagline {
    max-width: 340px;
    margin: 0;

    color: var(--ink-soft);

    font-size: var(--fs-body);
    font-weight: 500;
    line-height: 1.5;
  }


  /* ==============================================================
     PRICE
  ============================================================== */

  .pack__price-wrap {
    margin-top: 30px;
  }

  .pack__price {
    display: block;

    color: var(--ink);

    font-size: 40px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .pack__pricenote {
    display: block;

    margin-top: 8px;

    color: var(--muted-soft);

    font-size: 12px;
    line-height: 1.4;
  }


  /* ==============================================================
     PITCH
  ============================================================== */

  .pack__pitch {
    margin: 22px 0 0;

    color: var(--ink-body);

    font-size: 14px;
    line-height: 1.65;
  }


  /* ==============================================================
     FACTS
  ============================================================== */

  .pack__facts {
    display: flex;
    flex-direction: column;
    gap: 10px;

    margin-top: 22px;
    padding: 17px 0;

    border-top: 1px solid var(--line-softer);
    border-bottom: 1px solid var(--line-softer);
  }

  .pack__facts > span {
    display: flex;
    align-items: flex-start;
    gap: 10px;

    color: var(--ink-body);

    font-size: 13px;
    line-height: 1.4;
  }

  .pack__fact-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    flex: 0 0 auto;

    width: 15px;
    height: 15px;
    margin-top: 2px;

    color: var(--faint);
  }

  .pack__fact-icon svg {
    display: block;

    width: 12px;
    height: 12px;

    fill: currentColor;
  }


  /* ==============================================================
     TOGGLE
  ============================================================== */

  .pack__toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;

    width: 100%;
    min-height: 46px;

    margin-top: 18px;
    padding: 0 14px;

    border: 1px solid var(--line);
    background: var(--surface-alt);

    color: var(--ink);

    font-family: var(--font-sans);
    font-size: var(--fs-small);
    font-weight: 600;

    cursor: pointer;

    transition:
      background-color 180ms ease,
      border-color 180ms ease;
  }

  .pack__toggle:hover {
    background: var(--surface-soft);
    border-color: var(--line-strong);
  }

  .pack__chevron {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    flex: 0 0 auto;

    width: 16px;
    height: 16px;

    color: var(--muted-soft);

    transition: transform 220ms var(--ease);
  }

  .pack__chevron svg {
    display: block;

    width: 10px;
    height: 10px;

    fill: currentColor;
  }

  .pack__toggle[data-open="true"] .pack__chevron {
    transform: rotate(180deg);
  }


  /* ==============================================================
     FEATURES
  ============================================================== */

  .pack__feats {
    display: flex;
    flex-direction: column;
    gap: 10px;

    margin: 0;
    padding: 18px 0 0;

    list-style: none;
  }

  .pack__feats li {
    display: flex;
    align-items: flex-start;
    gap: 10px;

    color: var(--ink-body);

    font-size: var(--fs-small);
    line-height: 1.5;
  }

  .pack__feature-icon {
    flex: 0 0 auto;

    margin-top: 4px;

    color: var(--red);

    font-size: 10px;
    font-weight: 700;
    line-height: 1;
  }


  /* ==============================================================
     NOTE
  ============================================================== */

  .pack__note {
    margin: 20px 0;

    color: var(--muted-soft);

    font-size: 12px;
    line-height: 1.55;
  }


  /* ==============================================================
     CTA
  ============================================================== */

  .pack__cta {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 100%;
    min-height: 48px;

    margin-top: auto;
    padding: 0 20px;

    border-radius: 8px;

    font-size: 13px;
    font-weight: 700;

    text-align: center;

    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      color 180ms ease;
  }

  /* PLATA */

  .pack__cta--silver {
    border: 1px solid var(--line-strong);

    background:
      linear-gradient(
        180deg,
        #ffffff 0%,
        #f0f1f2 48%,
        #d7dade 100%
      );

    color: var(--ink);

    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.9),
      0 5px 14px rgba(16,17,20,.06);
  }

  .pack__cta--silver:hover {
    border-color: #bfc3c8;

    background:
      linear-gradient(
        180deg,
        #ffffff 0%,
        #e8eaec 48%,
        #cfd3d7 100%
      );
  }

  /* ROJO */

  .pack__cta--primary {
    border: 1px solid var(--red);

    background: #ff5757;
    color: #fff;

    box-shadow:
      0 8px 22px rgba(255, 87, 87, .18);
  }

  .pack__cta--primary:hover {
    background: #ff5757;
  }


  /* ==============================================================
     COMPARISON
  ============================================================== */

  .comparison {
    margin-top: 58px;

    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .comparison__scroll {
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .comparison table {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
  }

  .comparison th {
    padding: 17px 16px;

    border-bottom: 1px solid var(--line-soft);

    color: var(--ink);

    font-size: 12px;
    font-weight: 700;
    text-align: center;
  }

  .comparison th:first-child {
    text-align: left;
  }

  .comparison__title {
    color: var(--muted-soft) !important;

    font-size: 10px !important;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .comparison__highlight {
    color: var(--red) !important;
  }

  .comparison td {
    padding: 14px 16px;

    border-bottom: 1px solid var(--line-faint);

    color: var(--ink-body);

    font-size: var(--fs-small);
    line-height: 1.4;
    text-align: center;
  }

  .comparison tr:last-child td {
    border-bottom: 0;
  }

  .comparison__label {
    width: 42%;

    color: var(--ink) !important;
    font-weight: 500;

    text-align: left !important;
  }

  .comparison__highlight-cell {
    background: var(--red-tint);
  }


  /* ==============================================================
     TABLET
  ============================================================== */

  @media (max-width: 1000px) {
    .pricing__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .pack {
      padding: 30px 26px 26px;
    }
  }


  /* ==============================================================
     MOBILE
  ============================================================== */

  @media (max-width: 700px) {
    .pricing__head {
      grid-template-columns: 1fr;
      gap: 20px;
      margin-bottom: 38px;
    }

    .pricing__title {
      font-size: clamp(38px, 11vw, 52px);
    }

    .pricing__lead {
      font-size: 16px;
    }

    .pack {
      padding: 28px 22px 22px;
    }

    .pack__name {
      font-size: 27px;
    }

    .pack__price {
      font-size: 36px;
    }

    .comparison {
      margin-top: 42px;
    }
  }


  /* ==============================================================
     REDUCED MOTION
  ============================================================== */

  @media (prefers-reduced-motion: reduce) {
    .pack,
    .pack__toggle,
    .pack__chevron,
    .pack__cta {
      transition: none;
    }

    .pack:hover {
      transform: none;
    }
  }
</style>


<script>
  document
    .querySelectorAll<HTMLElement>("[data-pack]")
    .forEach((pack) => {
      const toggle =
        pack.querySelector<HTMLButtonElement>(
          "[data-pack-toggle]"
        );

      const features =
        pack.querySelector<HTMLElement>(
          "[data-pack-feats]"
        );

      const label =
        pack.querySelector<HTMLElement>(
          "[data-pack-label]"
        );

      if (!toggle || !features || !label) return;

      toggle.addEventListener("click", () => {
        const isOpen =
          toggle.dataset.open === "true";

        const nextState = !isOpen;

        toggle.dataset.open =
          String(nextState);

        toggle.setAttribute(
          "aria-expanded",
          String(nextState)
        );

        features.hidden = !nextState;

        label.textContent = nextState
          ? toggle.dataset.labelOpen ?? ""
          : toggle.dataset.labelClosed ?? "";
      });
    });
</script>