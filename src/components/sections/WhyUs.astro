---
import { getLocale, useTranslations } from "../../i18n";
import WritingNotes from "./WritingNotes.astro";

const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);

const points = Object.values(t.whyUs.points);
---

<section class="why-us section" id="why-us" aria-labelledby="why-us-title">
  <div class="container">
    <div class="why-us__intro">
      <div class="why-us__intro-copy">
        <p class="why-us__eyebrow">
          <span aria-hidden="true">✦</span>
          {t.whyUs.eyebrow}
        </p>

        <h2 id="why-us-title" data-reveal="up">
          {t.whyUs.title}
        </h2>

        <p class="why-us__lead" data-reveal="text">
          {t.whyUs.lead}
        </p>
      </div>

      <div class="why-us__intro-media" data-reveal="image">
        <WritingNotes
          title={t.whyUs.notes.title}
          items={t.whyUs.notes.items}
          label={t.whyUs.imageAlt}
        />
      </div>
    </div>

    <div class="why-us__points">
      {
        points.map((point) => (
          <article class="why-us__point" data-reveal="up">
            <span class="why-us__check" aria-hidden="true">
              ✓
            </span>

            <div class="why-us__point-copy">
              <h3>{point.title}</h3>
              <p>{point.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .why-us {
    background: var(--surface-alt);
    /* Safety net: nothing animated here can create a sideways scroll.
       `clip` (not `hidden`) keeps position: sticky working. */
    overflow-x: clip;
  }

  /* Intro */

  .why-us__intro {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(40px, 7vw, 100px);
    margin-bottom: clamp(80px, 10vw, 130px);
  }

  .why-us__intro-copy {
    min-width: 0;
    max-width: 600px;
  }

  .why-us__eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
    color: var(--muted);
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .why-us__eyebrow span {
    color: var(--red);
    font-size: 16px;
  }

  .why-us__lead {
    max-width: 520px;
    margin-top: 26px;
    color: var(--ink-soft);
    font-size: var(--fs-lead);
    line-height: 1.65;
    transition-delay: 120ms;
  }

  .why-us__intro-media {
    position: relative;
    min-width: 0;
    aspect-ratio: 1.15 / 1;
    overflow: hidden;
  }

  /* Points */

  .why-us__points {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(40px, 7vw, 100px);
    row-gap: 0;
    border-top: 1px solid var(--line);
  }

  .why-us__point {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    gap: 18px;
    min-width: 0;
    padding-block: 30px;
    border-bottom: 1px solid var(--line);
  }

  /*
    Stagger by COLUMN, not by position in the list.
    Each row is revealed when it scrolls into view, so the right-hand
    item only needs a small offset from the left-hand one. A list-wide
    stagger made lower rows wait up to ~0.5s after appearing, while
    items 7+ had no delay at all — which read as "some animate, some don't".
  */
  .why-us__point {
    transition-delay: 0ms;
  }

  .why-us__point:nth-child(even) {
    transition-delay: var(--motion-stagger);
  }

  .why-us__check {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 2px;
    color: #28a745;
    font-size: 18px;
    font-weight: 600;
    line-height: 1;
  }

  .why-us__point-copy {
    min-width: 0;
  }

  .why-us__point-copy h3 {
    margin: 0 0 8px;
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.35;
    overflow-wrap: break-word;
  }

  .why-us__point-copy p {
    max-width: 500px;
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--fs-body);
    line-height: 1.65;
  }

  /* Mobile */

  @media (max-width: 767px) {
    .why-us__intro {
      grid-template-columns: 1fr;
      gap: 42px;
      margin-bottom: 72px;
    }

    .why-us h2 {
      font-size: clamp(40px, 11vw, 54px);
    }

    .why-us__lead {
      margin-top: 22px;
    }

    .why-us__intro-media {
      aspect-ratio: 1 / 0.92;
    }

    .why-us__points {
      grid-template-columns: 1fr;
    }

    /* One column: every item enters on its own, no delay needed */
    .why-us__point,
    .why-us__point:nth-child(even) {
      grid-template-columns: 22px minmax(0, 1fr);
      gap: 14px;
      padding-block: 26px;
      transition-delay: 0ms;
    }

    .why-us__check {
      font-size: 17px;
    }
  }
</style>
