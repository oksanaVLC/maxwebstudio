---
import { getLocale, useTranslations } from "../../i18n";

const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);
---

<section class="why-us section" id="why-us" aria-labelledby="why-us-title">
  <div class="container">
    <div class="why-us__intro">
      <div class="why-us__intro-copy">
        <p class="why-us__eyebrow">
          <span aria-hidden="true">✦</span>
          {t.whyUs.eyebrow}
        </p>

        <h2 id="why-us-title">{t.whyUs.title}</h2>

        <p class="why-us__lead">{t.whyUs.lead}</p>
      </div>

      <div class="why-us__intro-media">
        <img
          src="/images/coffee-opened-notebook-near-laptop.jpg"
          alt={t.whyUs.imageAlt}
          loading="lazy"
        />
      </div>
    </div>

    <div class="why-us__points">
      {Object.values(t.whyUs.points).map((point) => (
        <article class="why-us__point">
          <span class="why-us__check" aria-hidden="true">
            ✓
          </span>

          <div class="why-us__point-copy">
            <h3>{point.title}</h3>
            <p>{point.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .why-us {
    background: var(--surface-soft);
  }

  /* --------------------------------
     Intro
  -------------------------------- */

  .why-us__intro {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(40px, 7vw, 100px);
    margin-bottom: clamp(80px, 10vw, 130px);
  }

  .why-us__intro-copy {
    max-width: 600px;
  }

  .why-us__eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
    color: var(--muted);
    font-size: var(--fs-small);
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .why-us__eyebrow span {
    color: var(--muted);
    font-size: 12px;
  }

  .why-us h2 {
    max-width: 600px;
    margin: 0;
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: clamp(42px, 5.5vw, 72px);
    font-weight: 300;
    letter-spacing: -0.06em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .why-us__lead {
    max-width: 520px;
    margin-top: 26px;
    color: var(--ink-soft);
    font-size: var(--fs-lead);
    line-height: 1.65;
  }

  .why-us__intro-media {
    position: relative;
    min-width: 0;
    aspect-ratio: 1.15 / 1;
    overflow: hidden;
    background: var(--surface);
  }

  .why-us__intro-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* --------------------------------
     Points
  -------------------------------- */

  .why-us__points {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(40px, 7vw, 100px);
    row-gap: 0;
    border-top: 1px solid var(--line);
  }

  .why-us__point {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    gap: 18px;
    padding-block: 30px;
    border-bottom: 1px solid var(--line);
  }

  .why-us__check {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 2px;
    color: #28a745;
    font-size: 18px;
    font-weight: 600;
    line-height: 1;
  }

  .why-us__point-copy h3 {
    margin: 0 0 8px;
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.35;
  }

  .why-us__point-copy p {
    max-width: 500px;
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--fs-body);
    line-height: 1.65;
  }

  /* --------------------------------
     Mobile
  -------------------------------- */

  @media (max-width: 767px) {
    .why-us__intro {
      grid-template-columns: 1fr;
      gap: 42px;
      margin-bottom: 72px;
    }

    .why-us h2 {
      font-size: clamp(40px, 11vw, 54px);
    }

    .why-us__lead {
      margin-top: 22px;
    }

    .why-us__intro-media {
      aspect-ratio: 1 / 0.92;
    }

    .why-us__points {
      grid-template-columns: 1fr;
    }

    .why-us__point {
      grid-template-columns: 22px minmax(0, 1fr);
      gap: 14px;
      padding-block: 26px;
    }

    .why-us__check {
      font-size: 17px;
    }
  }
</style>
