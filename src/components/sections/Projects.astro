---
import { getLocale, useTranslations } from "../../i18n";

const lang = getLocale(Astro.currentLocale);
const c = useTranslations(lang).projects;
---

<section
  id="projects"
  class="section projects"
  aria-labelledby="projects-title"
>
  <div class="container">
    <!-- HEADER -->

    <div class="projects__head">
      <p class="projects__eyebrow">
        <span aria-hidden="true">✦</span>
        {c.eyebrow}
      </p>

      <h2 id="projects-title" class="h2" data-reveal="up">
        {c.title}
      </h2>

      <p class="lead" data-reveal="text">
        {c.intro}
      </p>
    </div>

    <!-- PROJECTS -->

    <div class="projects__list">
      {
        c.items.map((project, index) => (
          <article
            class:list={[
              "project",
              {
                "project--reverse": index % 2 === 1,
              },
            ]}
          >
            <!-- IMAGE -->

            <a
              class="project__visual"
              href={project.href}
              aria-label={`${c.viewProject}: ${project.title}`}
              data-reveal={index % 2 === 0 ? "left" : "right"}
            >
              <div class="project__image">
                <img
                  src={project.image}
                  alt={project.alt}
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <span class="project__number" aria-hidden="true">
                {project.number}
              </span>
            </a>

            <!-- CONTENT -->

            <div
              class="project__content"
              data-reveal={index % 2 === 0 ? "right" : "left"}
            >
              <p class="project__category">
                {project.category}
              </p>

              <h3 class="project__title">
                {project.title}
              </h3>

              <p class="project__description">
                {project.description}
              </p>

              <!-- FEATURES -->

              <ul class="project__points">
                {
                  project.points.map((point) => (
                    <li class="project__point">
                      <a
                        class="project__point-inner"
                        href={project.href}
                      >
                        <span
                          class="project__point-arrow"
                          aria-hidden="true"
                        >
                          →
                        </span>

                        <span class="project__point-text">
                          {point}
                        </span>
                      </a>
                    </li>
                  ))
                }
              </ul>

              <!-- LINK -->

              <a class="project__link" href={project.href}>
                <span>{c.viewProject}</span>

                <span
                  class="project__link-arrow"
                  aria-hidden="true"
                >
                  →
                </span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* ==================================================
     PROJECTS
     ================================================== */

  .projects {
    background: var(--surface-soft);
  }

  /* ==================================================
     HEADER
     ================================================== */

  .projects__head {
    max-width: 760px;
    margin-bottom: 46px;
  }

  .projects__head h2 {
    max-width: 800px;
    margin: 0;
    color: var(--ink);
    font-size: clamp(38px, 5vw, 64px);
    font-weight: 300;
    letter-spacing: -0.055em;
    line-height: 1;
    text-wrap: balance;
  }

  .projects__eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;

    margin-bottom: 18px;

    color: var(--muted);
    font-size: var(--fs-small);
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .projects__eyebrow span {
    color: var(--muted);
    font-size: 12px;
  }

  .projects__head .lead {
    max-width: 680px;
    margin-top: 24px;
    color: var(--ink-soft);
    font-size: var(--fs-lead);
    font-weight: 400;
    line-height: 1.6;
  }

  /* ==================================================
     PROJECT LIST
     ================================================== */

  .projects__list {
    display: flex;
    flex-direction: column;
    gap: clamp(100px, 12vw, 170px);
  }

  /* ==================================================
     PROJECT
     ================================================== */

  .project {
    display: grid;
    grid-template-columns:
      minmax(0, 1.15fr)
      minmax(320px, 0.85fr);

    align-items: center;
    gap: clamp(50px, 7vw, 110px);
  }

  .project--reverse {
    grid-template-columns:
      minmax(320px, 0.85fr)
      minmax(0, 1.15fr);
  }

  /* ==================================================
     IMAGE
     ================================================== */

  .project__visual {
    position: relative;
    display: block;
    min-width: 0;

    color: inherit;
    text-decoration: none;
  }

  .project--reverse .project__visual {
    grid-column: 2;
    grid-row: 1;
  }

  .project__image {
    position: relative;
    overflow: hidden;

    width: 100%;
    aspect-ratio: 1.18 / 1;

    background: var(--surface-alt);
  }

  .project__image img {
    display: block;
    width: 100%;
    height: 100%;

    object-fit: cover;

    transition: transform 700ms var(--ease);
    will-change: transform;
  }

  .project__visual:hover .project__image img {
    transform: scale(1.045);
  }

  /* ==================================================
     NUMBER
     ================================================== */

  .project__number {
    position: absolute;
    right: clamp(14px, 2vw, 28px);
    bottom: clamp(14px, 2vw, 28px);

    display: flex;
    align-items: center;
    justify-content: center;

    width: 48px;
    height: 48px;

    border: 1px solid rgb(255 255 255 / 55%);
    border-radius: 50%;

    background: rgb(255 255 255 / 72%);
    color: var(--ink);

    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    font-weight: 700;

    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  /* ==================================================
     CONTENT
     ================================================== */

  .project__content {
    max-width: 540px;
  }

  .project--reverse .project__content {
    grid-column: 1;
    grid-row: 1;
  }

  .project__category {
    margin: 0 0 18px;

    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    line-height: 1.4;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .project__title {
    margin: 0;
    color: var(--ink);
    font-size: var(--fs-h3);
    font-weight: 700;
    line-height: var(--lh-heading);
    letter-spacing: -0.02em;
  }

  .project__description {
    max-width: 500px;
    margin-top: 16px;

    color: var(--ink-soft);
    font-size: var(--fs-body);
    line-height: 1.6;
  }

  /* ==================================================
     FEATURES
     ================================================== */

  .project__points {
    display: flex;
    flex-direction: column;

    margin: 30px 0 0;
    padding: 0;

    list-style: none;
  }

  .project__point {
    border-top: 1px solid var(--line);
  }

  .project__point:last-child {
    border-bottom: 1px solid var(--line);
  }

  .project__point-inner {
    display: flex;
    align-items: flex-start;
    gap: 12px;

    padding: 13px 0;

    color: var(--ink-soft);
    font-size: var(--fs-small);
    line-height: 1.5;

    text-decoration: none;

    transition:
      color 400ms var(--ease),
      transform 500ms var(--ease);
  }

  .project__point-arrow {
    flex: 0 0 auto;

    color: var(--red);
    font-size: 14px;
    line-height: 1.45;

    transition: transform 500ms var(--ease);
  }

  .project__point-text {
    transition: transform 500ms var(--ease);
  }

  .project__point-inner:hover {
    color: var(--ink);
    transform: translateX(-5px);
  }

  .project__point-inner:hover .project__point-arrow {
    transform: translateX(-4px);
  }

  .project__point-inner:hover .project__point-text {
    transform: translateX(-2px);
  }

  /* ==================================================
     LINK
     ================================================== */

  .project__link {
    display: inline-flex;
    align-items: center;
    gap: 12px;

    margin-top: 30px;

    color: var(--ink);
    font-size: var(--fs-small);
    font-weight: 700;

    text-decoration: none;
  }

  .project__link-arrow {
    display: inline-block;
    color: var(--red);

    transition: transform 400ms var(--ease);
  }

  .project__link:hover .project__link-arrow {
    transform: translateX(6px);
  }

  /* ==================================================
     TABLET
     ================================================== */

  @media (max-width: 900px) {
    .project,
    .project--reverse {
      grid-template-columns: 1fr;
      gap: 38px;
    }

    .project--reverse .project__visual,
    .project--reverse .project__content {
      grid-column: auto;
      grid-row: auto;
    }

    .project__visual,
    .project--reverse .project__visual {
      order: 1;
    }

    .project__content,
    .project--reverse .project__content {
      order: 2;
      max-width: 680px;
    }
  }

  /* ==================================================
     MOBILE
     ================================================== */

  @media (max-width: 767px) {
    .projects__head {
      margin-bottom: 42px;
    }

    .projects__head h2 {
      font-size: clamp(36px, 11vw, 52px);
    }

    .projects__head .lead {
      margin-top: 20px;
    }

    .projects__list {
      gap: 80px;
    }

    .project {
      gap: 30px;
    }

    .project__image {
      aspect-ratio: 1 / 1;
    }

    .project__image img {
      transition: none;
    }

    .project__visual:hover .project__image img {
      transform: none;
    }

    .project__number {
      width: 42px;
      height: 42px;
    }

    .project__description {
      margin-top: 14px;
    }

    .project__points {
      margin-top: 26px;
    }

    .project__point-inner {
      padding: 11px 0;
    }

    .project__link {
      margin-top: 26px;
    }
  }

  /* ==================================================
     REDUCED MOTION
     ================================================== */

  @media (prefers-reduced-motion: reduce) {
    .project__image img {
      transition: none;
    }

    .project__visual:hover .project__image img {
      transform: none;
    }

    .project__point-inner,
    .project__point-arrow,
    .project__point-text,
    .project__link-arrow {
      transition: none;
    }

    .project__point-inner:hover {
      transform: none;
    }

    .project__point-inner:hover .project__point-arrow,
    .project__point-inner:hover .project__point-text,
    .project__link:hover .project__link-arrow {
      transform: none;
    }
  }
</style>