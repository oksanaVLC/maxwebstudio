---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import geolightDemo from "../../assets/images/geolight_demo.png";
import soulCateringDemo from "../../assets/images/soul_catering_demo.png";
import { getLocale, type Locale } from "../../i18n";

const lang: Locale = getLocale(Astro.currentLocale);

/* ---------- Section copy ---------- */
const section = {
  es: {
    eyebrow: "Proyectos destacados",
    title: "Proyectos",
    intro: "Webs estáticas en Astro · diseño, código y rendimiento",
  },
  en: {
    eyebrow: "Featured projects",
    title: "Projects",
    intro: "Static websites built with Astro · design, code and performance",
  },
  fr: {
    eyebrow: "Projets à la une",
    title: "Projets",
    intro: "Sites statiques en Astro · design, code et performance",
  },
  ru: {
    eyebrow: "Избранные проекты",
    title: "Проекты",
    intro: "Статические сайты на Astro · дизайн, код и скорость",
  },
}[lang];

/* ---------- Projects ---------- */
type ProjectCopy = {
  projectType: string;
  tagline: string;
  description: string;
  body: string;
  meta: string[];
  cta: string;
};

type Project = {
  id: string;
  title: string;
  url: string;
  host: string;
  image: ImageMetadata;
  alt: string;
  screenBg: string;
  copy: Record<Locale, ProjectCopy>;
};

const projects: Project[] = [
  {
    id: "geolight",
    title: "GEOLight",
    url: "https://geolight-demo.netlify.app/",
    host: "geolight-demo.netlify.app",
    image: geolightDemo,
    alt: "GEOLight corporate website",
    screenBg: "#0b1030",
    copy: {
      es: {
        projectType: "Web corporativa · ES / EN",
        tagline:
          "Infraestructura solar y energías renovables a escala global.",
        description:
          "Un sitio corporativo premium para una empresa especializada en energía solar a gran escala, autoconsumo industrial, almacenamiento en baterías y operación y mantenimiento.",
        body:
          "El proyecto combina una identidad digital propia con una experiencia clara y tecnológica: arquitectura bilingüe, dirección de arte editorial, un hero interactivo basado en canvas y una base estática optimizada para rendimiento, SEO y accesibilidad.",
        meta: ["Astro 7", "ES / EN", "Canvas 2D", "Diseño digital", "Performance"],
        cta: "Ver proyecto",
      },
      en: {
        projectType: "Corporate website · ES / EN",
        tagline: "Solar infrastructure and renewable energy at global scale.",
        description:
          "A premium corporate website for a company focused on utility-scale solar, industrial self-consumption, battery storage, and operations and maintenance.",
        body:
          "The project combines a distinctive digital identity with a clear, technology-led experience: bilingual architecture, editorial art direction, an interactive canvas-based hero, and a static foundation optimized for performance, SEO, and accessibility.",
        meta: ["Astro 7", "ES / EN", "Canvas 2D", "Digital design", "Performance"],
        cta: "View project",
      },
      fr: {
        projectType: "Site corporate · ES / EN",
        tagline:
          "Infrastructures solaires et énergies renouvelables à l’échelle mondiale.",
        description:
          "Un site corporate premium pour une entreprise spécialisée dans le solaire à grande échelle, l’autoconsommation industrielle, le stockage par batteries et la maintenance.",
        body:
          "Le projet associe une identité digitale distinctive à une expérience claire et technologique : architecture bilingue, direction artistique éditoriale, hero interactif en canvas et base statique optimisée pour les performances, le SEO et l’accessibilité.",
        meta: ["Astro 7", "ES / EN", "Canvas 2D", "Design digital", "Performance"],
        cta: "Voir le projet",
      },
      ru: {
        projectType: "Корпоративный сайт · ES / EN",
        tagline:
          "Солнечная инфраструктура и возобновляемая энергетика мирового масштаба.",
        description:
          "Премиальный корпоративный сайт для компании, работающей с крупными солнечными проектами, промышленным собственным потреблением, аккумуляторными системами и эксплуатацией.",
        body:
          "Проект объединяет выразительную цифровую идентичность и понятный технологичный опыт: двуязычную архитектуру, редакционную арт-дирекцию, интерактивный hero на canvas и статическую основу, оптимизированную для скорости, SEO и доступности.",
        meta: ["Astro 7", "ES / EN", "Canvas 2D", "Digital design", "Performance"],
        cta: "Смотреть проект",
      },
    },
  },
  {
    id: "soul-catering",
    title: "Soul Catering",
    // TODO: sustituir por la URL real cuando la demo esté publicada en Netlify
    url: "https://soul-catering.netlify.app/",
    host: "soul-catering-demo.netlify.app",
    image: soulCateringDemo,
    alt: "Soul Catering website",
    screenBg: "#F6F2E9",
    copy: {
      es: {
        projectType: "Web de catering · ES / EN / FR / RU",
        tagline: "Catering para eventos con reserva online en seis pasos.",
        description:
          "Una web premium para un catering de Valencia: bodas, eventos de empresa y celebraciones privadas, con menús de temporada y servicios extra como DJ, música en vivo o fotografía.",
        body:
          "El diseño prioriza la legibilidad para todas las edades: tipografía grande, alto contraste y navegación sencilla en cuatro idiomas. Incluye un flujo de reserva con calendario, gestión de invitados y alérgenos, blog y un panel de administración, todo sobre una base estática en Astro.",
        meta: ["Astro 7", "ES / EN / FR / RU", "Reserva en 6 pasos", "Accesibilidad", "Diseño UI"],
        cta: "Ver proyecto",
      },
      en: {
        projectType: "Catering website · ES / EN / FR / RU",
        tagline: "Event catering with online booking in six steps.",
        description:
          "A premium website for a Valencia-based caterer: weddings, corporate events and private celebrations, with seasonal menus and extra services such as DJs, live music and photography.",
        body:
          "The design puts readability for all ages first: large type, high contrast and simple navigation in four languages. It includes a calendar-based booking flow, guest and allergen management, a blog and an admin dashboard, all on a static Astro foundation.",
        meta: ["Astro 7", "ES / EN / FR / RU", "6-step booking", "Accessibility", "UI design"],
        cta: "View project",
      },
      fr: {
        projectType: "Site de traiteur · ES / EN / FR / RU",
        tagline: "Traiteur événementiel avec réservation en ligne en six étapes.",
        description:
          "Un site premium pour un traiteur à Valence : mariages, événements d’entreprise et fêtes privées, avec des menus de saison et des services en option comme DJ, musique live ou photographie.",
        body:
          "Le design privilégie la lisibilité pour tous les âges : grande typographie, fort contraste et navigation simple en quatre langues. Il comprend un parcours de réservation avec calendrier, la gestion des invités et des allergènes, un blog et un tableau de bord, le tout sur une base statique Astro.",
        meta: ["Astro 7", "ES / EN / FR / RU", "Réservation en 6 étapes", "Accessibilité", "Design UI"],
        cta: "Voir le projet",
      },
      ru: {
        projectType: "Сайт кейтеринга · ES / EN / FR / RU",
        tagline: "Кейтеринг для мероприятий с онлайн-бронированием в шесть шагов.",
        description:
          "Премиальный сайт для кейтеринга в Валенсии: свадьбы, корпоративные мероприятия и частные праздники, сезонные меню и дополнительные услуги — DJ, живая музыка, фотосъёмка.",
        body:
          "Дизайн делает ставку на читаемость для любого возраста: крупный шрифт, высокий контраст и простая навигация на четырёх языках. Есть бронирование с календарём, учёт гостей и аллергенов, блог и панель администратора — всё на статической основе Astro.",
        meta: ["Astro 7", "ES / EN / FR / RU", "Бронирование в 6 шагов", "Доступность", "UI-дизайн"],
        cta: "Смотреть проект",
      },
    },
  },
];
---

<section
  id="projects"
  class="project-demos"
  aria-labelledby="project-demos-title"
>
  <div class="container">
    <header class="project-demos__head">
      <div>
        <p class="section-eyebrow" data-reveal="text">
          <span class="section-eyebrow__star" aria-hidden="true">✦</span>
          <span>{section.eyebrow}</span>
        </p>

        <h2 id="project-demos-title" data-reveal="up">
          {section.title}
        </h2>
      </div>

      <p class="project-demos__type" data-reveal="text">
        {section.intro}
      </p>
    </header>

    <div class="project-demos__list">
      {
        projects.map((project, index) => {
          const copy = project.copy[lang];
          const number = String(index + 1).padStart(2, "0");
          const titleId = `project-${project.id}-title`;

          return (
            <article
              class:list={[
                "project-demos__project",
                { "project-demos__project--reverse": index % 2 === 1 },
              ]}
              aria-labelledby={titleId}
            >
              <a
                class="project-demos__media"
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${copy.cta}: ${project.title}`}
                data-reveal="image"
              >
                <div class="project-demos__browser">
                  <div class="project-demos__browser-bar" aria-hidden="true">
                    <span />
                    <span />
                    <span />
                    <div class="project-demos__browser-url">{project.host}</div>
                  </div>

                  <div
                    class="project-demos__screen"
                    style={`--screen-bg: ${project.screenBg}`}
                  >
                  <Image
  src={project.image}
  alt={project.alt}
  width={project.image.width}
  height={project.image.height}
  loading="lazy"
  decoding="async"
/>
                  </div>
                </div>
              </a>

              <div class="project-demos__content">
                <p class="project-demos__kind" data-reveal="text">
                  {copy.projectType}
                </p>

                <h3
                  id={titleId}
                  class="project-demos__title"
                  data-reveal="up"
                >
                  {project.title}
                </h3>

                <p class="project-demos__tagline" data-reveal="text">
                  {copy.tagline}
                </p>

                <p class="project-demos__description" data-reveal="text">
                  {copy.description}
                </p>

                <p class="project-demos__body" data-reveal="text">
                  {copy.body}
                </p>

                <ul class="project-demos__meta" role="list" data-stagger>
                  {copy.meta.map((item) => (
                    <li data-reveal="up">{item}</li>
                  ))}
                </ul>

                <div class="project-demos__footer" data-reveal="text">
                  <span class="project-demos__number">{number}</span>
                  <span class="project-demos__line" aria-hidden="true" />
                  <a
                    class="project-demos__cta"
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {copy.cta}
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path
                        d="M7 17 17 7M9 7h8v8"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .project-demos {
    overflow: hidden;
    padding-block: clamp(80px, 9vw, 130px);
    background: var(--surface-alt);
  }

  .project-demos__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    margin-bottom: clamp(46px, 6vw, 76px);
  }

  .project-demos__head h2 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(52px, 7vw, 92px);
    font-weight: 300;
    line-height: 0.92;
    letter-spacing: -0.065em;
    text-wrap: balance;
  }

  .project-demos__type {
    max-width: 280px;
    margin: 0 0 8px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    line-height: 1.5;
    text-align: right;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .project-demos__list {
    display: grid;
    gap: clamp(90px, 11vw, 160px);
  }

  .project-demos__project {
    display: grid;
    grid-template-columns:
      minmax(0, 1.5fr)
      minmax(320px, 0.8fr);
    gap: clamp(42px, 6vw, 100px);
    align-items: center;
  }

  /* Alternate layout: image on the right for even projects */
  .project-demos__project--reverse {
    grid-template-columns:
      minmax(320px, 0.8fr)
      minmax(0, 1.5fr);
  }

  .project-demos__project--reverse .project-demos__media {
    order: 2;
  }

  .project-demos__media {
    display: block;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .project-demos__browser {
    overflow: hidden;
    background: #111;
    border: 1px solid var(--line);
    box-shadow:
      0 20px 45px rgb(16 17 20 / 8%),
      0 50px 100px rgb(16 17 20 / 10%);
    transition:
      transform 500ms var(--ease),
      box-shadow 500ms var(--ease);
  }

  .project-demos__media:hover .project-demos__browser {
    transform: translateY(-5px);
    box-shadow:
      0 26px 55px rgb(16 17 20 / 10%),
      0 60px 110px rgb(16 17 20 / 12%);
  }

  .project-demos__media:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 5px;
  }

  .project-demos__browser-bar {
    display: flex;
    align-items: center;
    gap: 7px;
    height: 38px;
    padding-inline: 14px;
    background: #f2f3f4;
    border-bottom: 1px solid #dddfe2;
  }

  .project-demos__browser-bar > span {
    width: 8px;
    height: 8px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #c9ccd0;
  }

  .project-demos__browser-url {
    margin-left: 12px;
    overflow: hidden;
    max-width: 280px;
    padding: 5px 18px;
    color: var(--muted);
    background: #fff;
    border: 1px solid #e4e6e8;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.05em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .project-demos__screen {
    overflow: hidden;
    background: var(--screen-bg, #0b1030);
  }

  .project-demos__screen :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .project-demos__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .project-demos__kind {
    margin: 0 0 14px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    line-height: 1.5;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .project-demos__title {
    margin: 0 0 22px;
    color: var(--ink);
    font-size: clamp(36px, 4vw, 56px);
    font-weight: 300;
    line-height: 0.95;
    letter-spacing: -0.055em;
  }

  .project-demos__tagline {
    max-width: 510px;
    margin: 0;
    color: var(--ink);
    font-size: clamp(24px, 2.6vw, 36px);
    font-weight: 300;
    line-height: 1.08;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .project-demos__description {
    max-width: 540px;
    margin: 28px 0 0;
    color: var(--ink-soft);
    font-size: var(--fs-lead);
    line-height: 1.65;
  }

  .project-demos__body {
    max-width: 540px;
    margin: 18px 0 0;
    color: var(--muted);
    font-size: var(--fs-body);
    line-height: 1.7;
  }

  .project-demos__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .project-demos__meta li {
    padding: 8px 12px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    line-height: 1;
  }

  .project-demos__footer {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 42px;
  }

  .project-demos__number {
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.12em;
  }

  .project-demos__line {
    width: 100%;
    height: 1px;
    flex: 1;
    background: var(--line);
  }

  .project-demos__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex: 0 0 auto;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 250ms var(--ease),
      gap 250ms var(--ease);
  }

  .project-demos__cta:hover {
    gap: 12px;
    color: var(--red);
  }

  @media (max-width: 859px) {
    .project-demos__head {
      align-items: flex-start;
      flex-direction: column;
    }

    .project-demos__type {
      max-width: 420px;
      margin: 0;
      text-align: left;
    }

    .project-demos__project,
    .project-demos__project--reverse {
      grid-template-columns: 1fr;
      gap: 42px;
    }

    .project-demos__project--reverse .project-demos__media {
      order: 0;
    }

    .project-demos__content {
      max-width: 760px;
    }

    .project-demos__tagline {
      max-width: 680px;
    }
  }

  @media (max-width: 767px) {
    .project-demos {
      padding-block: 72px;
    }

    .project-demos__head {
      margin-bottom: 40px;
    }

    .project-demos__head h2 {
      font-size: clamp(46px, 14vw, 70px);
    }

    .project-demos__list {
      gap: 80px;
    }

    .project-demos__browser-bar {
      height: 32px;
      padding-inline: 10px;
    }

    .project-demos__browser-url {
      display: none;
    }

    .project-demos__tagline {
      font-size: clamp(24px, 7vw, 34px);
    }

    .project-demos__meta {
      gap: 6px;
    }

    .project-demos__footer {
      gap: 10px;
      margin-top: 34px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-demos__browser,
    .project-demos__cta {
      transition: none;
    }

    .project-demos__media:hover .project-demos__browser {
      transform: none;
    }
  }
</style>
