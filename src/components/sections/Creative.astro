---
import { getImage } from "astro:assets";

import image from "../../assets/images/heather-green-NgRfOZXiFvY-unsplash.jpg";
import { getLocale, useTranslations } from "../../i18n";

const lang = getLocale(Astro.currentLocale);
const c = useTranslations(lang).creative;

const optimizedImage = await getImage({
  src: image,
  width: 1200,
  quality: 80,
  format: "webp",
});
---

<section class="section creative" aria-labelledby="creative-title">
  <div class="container">
    <div class="creative__grid">
      <!-- POSTER -->
      <div class="creative__visual">
        <div class="creative__image-wrap">
          <div
            class="creative__image"
            data-reveal="left"
            data-hover="zoom"
          >
            <img
              src={optimizedImage.src}
              alt={c.imageAlt}
              width={optimizedImage.attributes.width}
              height={optimizedImage.attributes.height}
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>

      <!-- CONTENT -->
      <div class="creative__content">
        <p class="creative__eyebrow" data-reveal="fade">
          {c.eyebrow}
        </p>

        <p class="creative__intro" data-reveal="up">
          {c.title}
        </p>

        <p class="creative__lead" data-reveal="up">
          {c.lead}
        </p>

        <h2
          id="creative-title"
          class="creative__title"
          data-stagger
        >
          {
            c.footer.map((word, index) => (
              <span
                class={`creative__word creative__word--${index + 1}`}
                data-reveal="fall"
              >
                {word}
              </span>
            ))
          }
        </h2>
      </div>
    </div>
  </div>
</section>

<style>
  /* ==================================================
     CREATIVE
     ================================================== */

  .creative {
    position: relative;
    overflow: hidden;
    background: var(--surface);
  }

  /* ==================================================
     GRID
     ================================================== */

  .creative__grid {
    display: grid;
    grid-template-columns:
      minmax(0, 1.05fr)
      minmax(320px, 0.95fr);
    align-items: center;
    gap: clamp(50px, 8vw, 120px);
  }

  /* ==================================================
     VISUAL
     ================================================== */

  .creative__visual {
    min-width: 0;
  }

  .creative__image-wrap {
    position: relative;
    width: min(100%, 420px);
    aspect-ratio: 4 / 5;
    margin-inline: auto;
    overflow: visible;
  }

  /* ==================================================
     POSTER
     ================================================== */

  .creative__image {
    position: absolute;
    inset: -3%;
    z-index: 1;

    transform-origin: center center;
  }

  .creative__image img {
    display: block;
    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;

    transform: scale(1.01);

    box-shadow: 0 24px 55px rgb(16 17 20 / 16%);
  }

  /* ==================================================
     CONTENT
     ================================================== */

  .creative__content {
    max-width: 560px;
    padding-block: 20px;
  }

  /* ==================================================
     EYEBROW
     ================================================== */

  .creative__eyebrow {
    margin: 0 0 30px;

    color: var(--muted);
    font-family: var(--font-sans);

    font-size: 11px;
    font-weight: 700;

    letter-spacing: 0.12em;
    line-height: 1.2;

    text-transform: uppercase;
  }

  /* ==================================================
     INTRO
     ================================================== */

  .creative__intro {
    max-width: 490px;
    margin: 0;

    color: var(--ink-body);
    font-family: var(--font-sans);

    font-size: clamp(18px, 2vw, 23px);
    font-weight: 400;

    line-height: 1.55;
    letter-spacing: -0.015em;
  }

  /* ==================================================
     LEAD
     ================================================== */

  .creative__lead {
    max-width: 490px;
    margin: 24px 0 0;

    color: var(--muted);
    font-family: var(--font-sans);

    font-size: var(--fs-body);
    font-weight: 400;

    line-height: 1.65;
  }

  /* ==================================================
     TITLE
     ================================================== */

  .creative__title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;

    gap: 0 0.18em;

    max-width: 100%;
    margin: clamp(46px, 5vw, 70px) 0 0;

    color: var(--ink);

    font-family:
      "Fraunces Variable",
      Fraunces,
      Georgia,
      serif;

    font-size: clamp(48px, 6vw, 92px);
    font-weight: 600;
    font-style: italic;

    line-height: 0.84;
    letter-spacing: -0.055em;

    text-wrap: balance;

    transform: rotate(-1deg);
  }

  .creative__word {
    display: inline-block;

    max-width: 100%;

    white-space: nowrap;
    transform-origin: center center;
  }

  .creative__word--1 {
    color: var(--ink);
  }

  .creative__word--2 {
    color: #03a9f4;
  }

  .creative__word--3 {
    color: var(--red);
  }

  /* ==================================================
     TABLET
     ================================================== */

  @media (max-width: 900px) {
    .creative__grid {
      grid-template-columns: 1fr;
      gap: 70px;
    }

    .creative__visual {
      order: 1;
    }

    .creative__content {
      order: 2;

      max-width: 700px;
      margin-inline: auto;
      padding-block: 0;

      text-align: center;
    }

    .creative__intro,
    .creative__lead {
      margin-inline: auto;
    }

    .creative__title {
      justify-content: center;

      max-width: 100%;
      margin-inline: auto;

      font-size: clamp(52px, 8.5vw, 78px);
    }
  }

  /* ==================================================
     MOBILE
     ================================================== */

  @media (max-width: 600px) {
    .creative__grid {
      gap: 55px;
    }

    .creative__image-wrap {
      width: 100%;
      aspect-ratio: 4 / 5;
    }

    .creative__image {
      inset: -2%;
    }

    .creative__intro {
      font-size: 17px;
      line-height: 1.6;
    }

    .creative__lead {
      margin-top: 20px;
    }

    .creative__title {
      justify-content: center;

      gap: 0 0.14em;

      margin-top: 42px;

      font-size: clamp(40px, 11.5vw, 66px);

      line-height: 0.86;
      letter-spacing: -0.06em;
    }

    /*
     * Evita que palabras largas, especialmente en ruso,
     * desborden el contenedor.
     */
    .creative__word {
      max-width: 100%;
    }
  }

  /* ==================================================
     VERY SMALL SCREENS
     ================================================== */

  @media (max-width: 380px) {
    .creative__title {
      font-size: clamp(38px, 11.5vw, 58px);
    }
  }
</style>