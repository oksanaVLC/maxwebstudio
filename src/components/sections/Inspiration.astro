---
import { Image } from "astro:assets";

import valencia1 from "../../assets/images/valencia1.jpg";
import valencia2 from "../../assets/images/valencia2.jpg";
import valencia3 from "../../assets/images/valencia3.jpg";

import { getLocale, useTranslations } from "../../i18n";

const imacMockup = "/images/imac-mockup.webp";
const projectImage = "/images/poster-type.jpg";

const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);
const c = t.inspiration;

const slides = [valencia1, valencia2, valencia3];

/* Slider UI labels (move them to i18n whenever you like) */
const UI = {
  es: {
    region: "Fotografías de Valencia",
    slide: "Foto",
    of: "de",
    prev: "Foto anterior",
    next: "Foto siguiente",
    play: "Reproducir",
    pause: "Pausar",
    dots: "Elegir foto",
  },
  en: {
    region: "Photos of Valencia",
    slide: "Photo",
    of: "of",
    prev: "Previous photo",
    next: "Next photo",
    play: "Play",
    pause: "Pause",
    dots: "Choose photo",
  },
  ru: {
    region: "Фотографии Валенсии",
    slide: "Фото",
    of: "из",
    prev: "Предыдущее фото",
    next: "Следующее фото",
    play: "Воспроизвести",
    pause: "Пауза",
    dots: "Выбрать фото",
  },
};

const ui = UI[lang as keyof typeof UI] ?? UI.es;
const pad = (n: number) => String(n).padStart(2, "0");
---

<section
  id="inspiration"
  class="inspiration"
  aria-labelledby="inspiration-title"
>
  <div class="container">
    <!-- ==================================================
         CONTENT
         ================================================== -->

    <div class="inspiration__grid">
      <!-- TEXT -->

      <div class="inspiration__text">
        <p class="section-eyebrow">
          <span class="section-eyebrow__star" aria-hidden="true">✦</span>
          <span>{c.eyebrow}</span>
        </p>

        <h2 id="inspiration-title" class="inspiration__title" data-reveal="up">
          {c.title}
        </h2>

        <div class="inspiration__copy">
          <p class="inspiration__lead" data-reveal="text">
            {c.lead}
          </p>

          <p>{c.paragraphs.one}</p>

          <p>{c.paragraphs.two}</p>
        </div>

        <!-- TAGS -->

        <div class="inspiration__tags" data-stagger aria-label={c.tagsAriaLabel}>
          <span data-reveal="up">{c.tags.mediterranean}</span>
          <span data-reveal="up">{c.tags.architecture}</span>
          <span data-reveal="up">{c.tags.color}</span>
          <span data-reveal="up">{c.tags.tradition}</span>
        </div>
      </div>

      <!-- ==================================================
           MOCKUPS
           ================================================== -->

      <div class="inspiration__devices" data-reveal="image">
        <div class="mockup">
          <div class="mockup__imac">
            <img src={imacMockup} alt="" class="mockup__frame" decoding="async" />

            <div class="mockup__screen">
              <img src={projectImage} alt={c.imageAlt} decoding="async" />
            </div>
          </div>

          <div class="mockup__phone">
            <div class="mockup__phone-screen">
              <img src={projectImage} alt="" decoding="async" />
            </div>
          </div>
        </div>

        <span class="inspiration__caption" data-reveal="text">
          {c.caption}
        </span>
      </div>
    </div>

    <!-- ==================================================
         IMAGE SLIDER — mosaic transition
         ================================================== -->

    <div
      class="inspiration__slider"
      data-inspiration-slider
      data-reveal="image"
      role="region"
      aria-roledescription="carousel"
      aria-label={ui.region}
    >
      <div class="inspiration__track" data-track aria-live="off">
        {
          slides.map((slide, index) => (
            <div
              class:list={["inspiration__slide", index === 0 && "is-active"]}
              data-inspiration-slide
              role="group"
              aria-roledescription="slide"
              aria-label={`${ui.slide} ${index + 1} ${ui.of} ${slides.length}`}
              aria-hidden={index === 0 ? undefined : "true"}
            >
              <Image
                src={slide}
                alt=""
                width={1600}
                quality={82}
                format="webp"
                loading="lazy"
                decoding="async"
                sizes="(max-width: 767px) 100vw, 1240px"
              />
            </div>
          ))
        }
      </div>

      <!-- tiles of the incoming photo are drawn here -->
      <div class="inspiration__mosaic" data-mosaic aria-hidden="true"></div>

      <!-- CONTROLS -->
      <div class="inspiration__controls">
        <button
          type="button"
          class="inspiration__btn"
          data-prev
          aria-label={ui.prev}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M14.5 5.5 8 12l6.5 6.5" />
          </svg>
        </button>

        <div class="inspiration__dots" role="group" aria-label={ui.dots}>
          {
            slides.map((_, index) => (
              <button
                type="button"
                class:list={["inspiration__dot", index === 0 && "is-active"]}
                data-dot={index}
                aria-label={`${ui.slide} ${index + 1} ${ui.of} ${slides.length}`}
                aria-current={index === 0 ? "true" : undefined}
              >
                <span class="inspiration__dot-bar">
                  <span class="inspiration__dot-fill" data-fill></span>
                </span>
              </button>
            ))
          }
        </div>

        <button
          type="button"
          class="inspiration__btn"
          data-next
          aria-label={ui.next}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9.5 5.5 16 12l-6.5 6.5" />
          </svg>
        </button>

        <span class="inspiration__sep" aria-hidden="true"></span>

        <button
          type="button"
          class="inspiration__btn inspiration__btn--toggle"
          data-toggle
          aria-label={ui.pause}
          data-label-play={ui.play}
          data-label-pause={ui.pause}
        >
          <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9 6.5v11M15 6.5v11" />
          </svg>
          <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M8.5 6.2v11.6L18 12z" />
          </svg>
        </button>
      </div>

      <p class="inspiration__counter" aria-hidden="true">
        <span data-counter-current>01</span>
        <span class="inspiration__counter-total">/ {pad(slides.length)}</span>
      </p>
    </div>
  </div>
</section>

<script>
  type Pattern = "sweep" | "center" | "scatter";

  const INTERVAL = 6000; // ms each photo stays (keep in sync with --slide-interval)
  const TILE_DURATION = 760;
  const SPREAD = 720; // how long the wave takes to cross the photo
  const PATTERNS: Pattern[] = ["sweep", "center", "scatter"];

  function setup(slider: HTMLElement) {
    if (slider.dataset.ready) return;
    slider.dataset.ready = "1";

    const slides = Array.from(
      slider.querySelectorAll<HTMLElement>("[data-inspiration-slide]"),
    );
    const dots = Array.from(slider.querySelectorAll<HTMLButtonElement>("[data-dot]"));
    const layer = slider.querySelector<HTMLElement>("[data-mosaic]")!;
    const track = slider.querySelector<HTMLElement>("[data-track]")!;
    const toggle = slider.querySelector<HTMLButtonElement>("[data-toggle]")!;
    const counter = slider.querySelector<HTMLElement>("[data-counter-current]");
    const n = slides.length;

    if (n <= 1) {
      slider.classList.add("is-single");
      return;
    }

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const canHover = window.matchMedia("(hover: hover)").matches;

    slider.style.setProperty("--slide-interval", `${INTERVAL}ms`);

    let current = 0;
    let busy = false;
    let patternIndex = 0;
    let playing = !reduceMotion;

    /* ---------- holds: pause the timer without "stopping" ---------- */
    const holds = new Set<string>();
    const hold = (key: string, on: boolean) => {
      on ? holds.add(key) : holds.delete(key);
      slider.classList.toggle("is-held", holds.size > 0);
    };

    const setPlaying = (value: boolean) => {
      playing = value;
      slider.classList.toggle("is-playing", playing);
      toggle.setAttribute("aria-pressed", String(!playing));
      toggle.setAttribute(
        "aria-label",
        (playing ? toggle.dataset.labelPause : toggle.dataset.labelPlay) || "",
      );
      // announce slide changes only when the user is in control
      track.setAttribute("aria-live", playing ? "off" : "polite");
    };

    /* ---------- state ---------- */
    const swap = (index: number) => {
      slides[current].classList.remove("is-active");
      slides[current].setAttribute("aria-hidden", "true");
      dots[current]?.classList.remove("is-active");
      dots[current]?.removeAttribute("aria-current");

      current = index;

      slides[current].classList.add("is-active");
      slides[current].removeAttribute("aria-hidden");
      dots[current]?.classList.add("is-active");
      dots[current]?.setAttribute("aria-current", "true");
      if (counter) counter.textContent = String(current + 1).padStart(2, "0");
    };

    /* ---------- mosaic ---------- */
    const mosaic = async (img: HTMLImageElement, dir: 1 | -1) => {
      const W = slider.offsetWidth; // layout size, unaffected by reveal transforms
      const H = slider.offsetHeight;
      const nw = img.naturalWidth;
      const nh = img.naturalHeight;
      const s = Math.max(W / nw, H / nh); // object-fit: cover
      const bw = nw * s;
      const bh = nh * s;
      const ox = (W - bw) / 2;
      const oy = (H - bh) / 2;
      const src = img.currentSrc || img.src;

      const small = W < 640;
      const cols = small ? 6 : 10;
      const rows = small ? 7 : 6;
      const tw = W / cols;
      const th = H / rows;
      const pattern = PATTERNS[patternIndex++ % PATTERNS.length];
      const cx = (cols - 1) / 2;
      const cy = (rows - 1) / 2;
      const maxR = Math.hypot(cx, cy) || 1;

      const tiles: { el: HTMLElement; delay: number }[] = [];
      const frag = document.createDocumentFragment();

      for (let r = 0; r < rows; r++) {
        for (let col = 0; col < cols; col++) {
          const x = Math.floor(col * tw);
          const y = Math.floor(r * th);
          const w = Math.ceil((col + 1) * tw) - x + (col < cols - 1 ? 1 : 0);
          const h = Math.ceil((r + 1) * th) - y + (r < rows - 1 ? 1 : 0);

          let k: number; // 0..1 — when this tile starts
          if (pattern === "sweep") {
            const cc = dir > 0 ? col : cols - 1 - col;
            k = (cc + r * 0.6) / (cols - 1 + (rows - 1) * 0.6);
          } else if (pattern === "center") {
            k = Math.hypot(col - cx, r - cy) / maxR;
          } else {
            k = Math.random();
          }
          const delay = k * SPREAD + Math.random() * 90;

          const el = document.createElement("span");
          el.className = "inspiration__tile";
          el.style.cssText = `left:${x}px;top:${y}px;width:${w}px;height:${h}px;background-image:url("${src}");background-size:${bw}px ${bh}px;background-position:${ox - x}px ${oy - y}px;`;
          frag.append(el);
          tiles.push({ el, delay });
        }
      }

      layer.append(frag);

      const anims = tiles.map(({ el, delay }) =>
        el.animate(
          [
            { opacity: 0, transform: `scale(0.35) rotate(${dir * -8}deg)`, borderRadius: "40%" },
            { opacity: 1, offset: 0.55 },
            { opacity: 1, transform: "scale(1) rotate(0deg)", borderRadius: "0%" },
          ],
          {
            duration: TILE_DURATION,
            delay,
            easing: "cubic-bezier(0.22, 1, 0.36, 1)",
            fill: "both",
          },
        ),
      );

      await Promise.all(anims.map((a) => a.finished)).catch(() => {});
    };

    /* ---------- navigation ---------- */
    const go = async (target: number, dir: 1 | -1) => {
      target = (target + n) % n;
      if (busy || target === current) return;
      busy = true;
      slider.classList.add("is-busy");

      const img = slides[target].querySelector("img");

      try {
        if (img && !img.complete) img.loading = "eager";
        await img?.decode();
      } catch {}

      if (!reduceMotion && img && img.naturalWidth) {
        await mosaic(img, dir);
      }

      swap(target);
      // let the real slide paint under the tiles before removing them
      requestAnimationFrame(() => layer.replaceChildren());

      busy = false;
      slider.classList.remove("is-busy");
    };

    const next = () => go(current + 1, 1);
    const prev = () => go(current - 1, -1);

    slider.querySelector("[data-next]")?.addEventListener("click", next);
    slider.querySelector("[data-prev]")?.addEventListener("click", prev);
    dots.forEach((dot, i) =>
      dot.addEventListener("click", () => go(i, i > current ? 1 : -1)),
    );
    toggle.addEventListener("click", () => setPlaying(!playing));

    /* autoplay is driven by the progress bar of the active dot */
    slider.addEventListener("animationend", (e) => {
      const target = e.target as HTMLElement;
      if (target.matches("[data-fill]") && target.closest(".is-active") && playing) {
        next();
      }
    });

    /* keyboard */
    slider.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") {
        e.preventDefault();
        next();
      } else if (e.key === "ArrowLeft") {
        e.preventDefault();
        prev();
      }
    });

    /* swipe */
    let sx = 0;
    let sy = 0;
    slider.addEventListener("pointerdown", (e) => {
      if (e.pointerType === "mouse") return;
      sx = e.clientX;
      sy = e.clientY;
    });
    slider.addEventListener("pointerup", (e) => {
      if (e.pointerType === "mouse") return;
      const dx = e.clientX - sx;
      const dy = e.clientY - sy;
      if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy) * 1.3) {
        dx < 0 ? next() : prev();
      }
    });

    /* pause while hovered, keyboard-focused, off screen or tab hidden */
    if (canHover) {
      slider.addEventListener("mouseenter", () => hold("hover", true));
      slider.addEventListener("mouseleave", () => hold("hover", false));
    }
    slider.addEventListener("focusin", (e) => {
      if ((e.target as HTMLElement).matches(":focus-visible")) hold("focus", true);
    });
    slider.addEventListener("focusout", (e) => {
      if (!slider.contains(e.relatedTarget as Node)) hold("focus", false);
    });
    document.addEventListener("visibilitychange", () => hold("hidden", document.hidden));

    hold("offscreen", true);
    new IntersectionObserver(([entry]) => hold("offscreen", !entry.isIntersecting), {
      threshold: 0.35,
    }).observe(slider);

    setPlaying(playing);
  }

  const init = () =>
    document.querySelectorAll<HTMLElement>("[data-inspiration-slider]").forEach(setup);

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
  document.addEventListener("astro:page-load", init);
</script>

<style>
  /* ==================================================
     INSPIRATION
     ================================================== */

  .inspiration {
    position: relative;
    overflow: hidden;

    background: var(--surface);
  }

  /* ==================================================
     GRID
     ================================================== */

  .inspiration__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(320px, 0.85fr);
    align-items: center;
    gap: clamp(60px, 8vw, 120px);

    padding-bottom: clamp(56px, 7vw, 96px);
  }

  /* ==================================================
     TEXT
     ================================================== */

  .inspiration__text {
    max-width: 720px;
  }

  .inspiration__title {
    max-width: 720px;
    margin: 0 0 30px;
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: clamp(38px, 5vw, 62px);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .inspiration__copy p {
    margin: 0 0 20px;
    color: var(--ink-soft);
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    font-weight: 400;
    line-height: 1.72;
  }

  .inspiration__copy .inspiration__lead {
    margin-bottom: 22px;
    color: var(--ink-body);
    font-size: var(--fs-lead);
    line-height: 1.65;
    transition-delay: 140ms;
  }

  .inspiration__copy p:last-child {
    margin-bottom: 0;
  }

  /* ==================================================
     TAGS
     ================================================== */

  .inspiration__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 34px;
  }

  .inspiration__tags span {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 8px 13px;
    border: 1px solid var(--line);
    background: var(--surface-alt);
    color: var(--ink-soft);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  /* ==================================================
     DEVICES
     ================================================== */

  .inspiration__devices {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    width: 100%;
  }

  .mockup {
    position: relative;
    width: min(100%, 420px);
  }

  .mockup__imac {
    position: relative;
    width: 100%;
    aspect-ratio: 1000 / 1159;
  }

  .mockup__frame {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .mockup__screen {
    position: absolute;
    inset: 0;
    z-index: 2;
    overflow: hidden;
    background: var(--screen-dark);
    clip-path: polygon(23% 27%, 86% 16.6%, 79% 66.1%, 14.2% 68%);
  }

  .mockup__screen img {
    position: absolute;
    left: 8%;
    top: 8%;
    width: 84%;
    height: 68%;
    max-width: none;
    object-fit: cover;
    transform: skewY(-10.8deg);
    transform-origin: center;
  }

  .mockup__phone {
    position: absolute;
    left: -6%;
    bottom: 2%;
    z-index: 3;
    width: 19%;
    aspect-ratio: 9 / 18.5;
    padding: 3px;
    background: linear-gradient(160deg, #33363b 0%, #101114 64%);
    border-radius: 9px;
    box-shadow: -12px 16px 30px rgb(16 17 20 / 28%);
    transform: perspective(620px) rotateY(22deg) rotateX(5deg) rotateZ(-3deg);
    transform-origin: bottom right;
  }

  .mockup__phone-screen {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 7px;
    background: var(--screen-dark);
  }

  .mockup__phone-screen img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .inspiration__caption {
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    line-height: 1.4;
    letter-spacing: 0.02em;
    transition-delay: 180ms;
  }

  /* ==================================================
     SLIDER
     ================================================== */

  .inspiration__slider {
    --slide-interval: 6000ms;

    position: relative;
    isolation: isolate;
    width: 100%;
    height: clamp(480px, 58vw, 720px);
    overflow: hidden;
    background: #dceff2;
    touch-action: pan-y;
  }

  .inspiration__track,
  .inspiration__slide {
    position: absolute;
    inset: 0;
  }

  .inspiration__slide {
    opacity: 0;
  }

  .inspiration__slide.is-active {
    opacity: 1;
  }

  .inspiration__slide :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Mosaic layer */

  .inspiration__mosaic {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .inspiration__mosaic :global(.inspiration__tile) {
    position: absolute;
    background-repeat: no-repeat;
    opacity: 0;
    will-change: transform, opacity;
    backface-visibility: hidden;
  }

  /* Controls — frosted pill, no dark gradient over the photo */

  .inspiration__controls {
    position: absolute;
    left: clamp(16px, 3vw, 32px);
    bottom: clamp(16px, 3vw, 32px);
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 4px;
    color: #fff;
    background: rgb(16 17 20 / 0.34);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    backdrop-filter: blur(14px) saturate(1.3);
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: 999px;
  }

  .inspiration__btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    color: inherit;
    background: transparent;
    border-radius: 999px;
    cursor: pointer;
    transition: background-color 250ms ease, transform 250ms ease;
  }

  .inspiration__btn:hover {
    background: rgb(255 255 255 / 0.16);
  }

  .inspiration__btn:active {
    transform: scale(0.92);
  }

  .inspiration__btn svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .inspiration__btn .icon-play {
    display: none;
    fill: currentColor;
    stroke-width: 1.2;
  }

  .inspiration__btn--toggle[aria-pressed="true"] .icon-play {
    display: block;
  }

  .inspiration__btn--toggle[aria-pressed="true"] .icon-pause {
    display: none;
  }

  .inspiration__sep {
    width: 1px;
    height: 20px;
    margin-inline: 4px;
    background: rgb(255 255 255 / 0.25);
  }

  .inspiration__slider :focus-visible {
    outline: 2px solid #fff;
    outline-offset: -2px;
  }

  /* Dots with progress */

  .inspiration__dots {
    display: flex;
    align-items: center;
  }

  .inspiration__dot {
    display: grid;
    place-items: center;
    min-width: 24px;
    height: 44px;
    padding: 0 4px;
    background: transparent;
    cursor: pointer;
  }

  .inspiration__dot-bar {
    position: relative;
    display: block;
    width: 8px;
    height: 8px;
    overflow: hidden;
    background: rgb(255 255 255 / 0.5);
    border-radius: 999px;
    transition:
      width 500ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 300ms ease;
  }

  .inspiration__dot:hover .inspiration__dot-bar {
    background: rgb(255 255 255 / 0.85);
  }

  .inspiration__dot.is-active .inspiration__dot-bar {
    width: 34px;
    background: rgb(255 255 255 / 0.35);
  }

  .inspiration__dot-fill {
    position: absolute;
    inset: 0;
    background: #fff;
    border-radius: inherit;
    transform: scaleX(0);
    transform-origin: left center;
  }

  .inspiration__dot.is-active .inspiration__dot-fill {
    animation: inspiration-progress var(--slide-interval) linear forwards;
    animation-play-state: paused;
  }

  .inspiration__slider.is-playing:not(.is-held):not(.is-busy)
    .inspiration__dot.is-active
    .inspiration__dot-fill {
    animation-play-state: running;
  }

  @keyframes inspiration-progress {
    to {
      transform: scaleX(1);
    }
  }

  /* Counter */

  .inspiration__counter {
